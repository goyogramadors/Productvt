# Copia este archivo a .env y completa los valores con la config de tu proyecto Firebase:
# Firebase Console > Configuración del proyecto (ícono de engranaje) > "Tus apps" > app Web >
# SDK setup and configuration > Config.
#
# Todas las variables deben tener el prefijo EXPO_PUBLIC_ para que Expo las inyecte en el bundle
# de cliente (ver src/infrastructure/firebase/client.ts). Nunca pongas aquí credenciales de
# servidor: estos valores viajan al cliente, la seguridad real la dan las reglas de Firestore.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (SPEC.md sección 11.2; ARCHITECTURE.md sección 24.2).
#
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID: el "Web client ID" (tipo OAuth "Web application") que Firebase
# genera automáticamente al activar el proveedor Google en Authentication > Sign-in method. Se usa
# en DOS lugares: (1) GoogleSignin.configure({ webClientId }) en Android, obligatorio para que el
# SDK nativo de Google devuelva un idToken con la audiencia correcta que Firebase pueda validar; y
# (2) opcionalmente como fallback si se navega el flujo por web sin popup.
# Dónde obtenerlo: Firebase Console > Authentication > Sign-in method > Google > "Web SDK
# configuration" (o Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs >
# tipo "Web application", el que tenga "(auto created by Google Service)" en el nombre).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# No se requiere un "Android client ID" en variable de entorno: Google válida el Sign-In nativo en
# Android usando el nombre de paquete (`android.package` en app.json, hoy "com.productvtbeta.app")
# + el SHA-1 del keystore de firma, registrados como credencial tipo "Android" en Google Cloud
# Console (Credentials > Create Credentials > OAuth client ID > Android). Ver pasos manuales
# pendientes al final del resumen de la Fase 2.
