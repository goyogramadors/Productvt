{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "fileSummary": true,
    "directoryStructure": true,
    "topFilesLength": 20,
    "git": {
      "sortByChanges": true
    }
  },
  "include": [],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/package-lock.json",
      "**/*.lock"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
