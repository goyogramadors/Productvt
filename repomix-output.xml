    USER ||--o{ INVISIBLE_EVENT : "events"
    USER ||--o{ WEEKLY_GOAL : "goals"
    USER ||--o| ACTIVE_SESSION : "active/session (singleton)"
    USER ||--o| GALAXY_LAYOUT : "layouts/galaxy"
