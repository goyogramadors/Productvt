<script>
(function(){
  var DEFAULT_CATEGORIES = [
    { id: "mate", name: "Matemáticas", color: "#B06A3A", type: "productiva" },
    { id: "lectura", name: "Lectura", color: "#4E6E8E", type: "productiva" },
    { id: "codigo", name: "Código", color: "#7A6A9E", type: "productiva" },
    { id: "idiomas", name: "Idiomas", color: "#A85C6B", type: "productiva" },
    { id: "pantalla", name: "Pausa de pantalla", color: "#6B8F71", type: "ocio" },
    { id: "ejercicio", name: "Ejercicio", color: "#C97A2B", type: "ocio" },
    { id: "social", name: "Social", color: "#8A6FA3", type: "ocio" }
  ];
  var PALETTE = ["#B06A3A","#4E6E8E","#7A6A9E","#A85C6B","#6B8F71","#C97A2B","#8A6FA3","#3A6B54","#9C4A3A","#2E7B84"];
  var CATS_KEY = "productvt-categorias-v1";
  var LAST_COLOR_KEY = "productvt-ultimo-color-v1";
  function loadLastColor(){ try{ return localStorage.getItem(LAST_COLOR_KEY); }catch(e){ return null; } }
  function saveLastColor(c){ try{ localStorage.setItem(LAST_COLOR_KEY, c); }catch(e){} }
  var lastColor = loadLastColor();
  function orderedPalette(){
    if(!lastColor) return PALETTE.slice();
    return [lastColor].concat(PALETTE.filter(function(c){ return c !== lastColor; }));
  }

  function loadCategories(){
    try{ var raw = localStorage.getItem(CATS_KEY); return raw ? JSON.parse(raw) : DEFAULT_CATEGORIES.slice(); }
    catch(e){ return DEFAULT_CATEGORIES.slice(); }
  }
  function saveCategories(){ try{ localStorage.setItem(CATS_KEY, JSON.stringify(CATEGORIES)); }catch(e){} }
  var CATEGORIES = loadCategories();
  function categoriesOf(type){ return CATEGORIES.filter(function(c){ return c.type === type; }); }
  function typeForMode(mode){ return mode === "inverso" ? "ocio" : "productiva"; }

  // D6.b: si el bloque está ligado a una meta, su color manda sobre el de categoría en esta pantalla
  var METAS_KEY = "productvt-metas-v1";
  function loadMetas(){ try{ var raw = localStorage.getItem(METAS_KEY); return raw ? JSON.parse(raw) : []; }catch(e){ return []; } }
  var METAS = loadMetas();
  function metaById(id){ return METAS.find(function(m){ return m.id === id; }); }

  // ---- v3 §A: jerarquía Supermeta → Meta → Tarea/Evento ----
  // Las supermetas se asocian a un calendario (v3 §A2); sin calendario, crean uno propio con su
  // nombre y su color al primer bloque (v3 §D2–D3). La antimeta no da puntaje y solo contiene
  // eventos atemporales (v3 §A7) — es la categoría invisible del cronómetro inverso.
  var SUPERMETAS_KEY = "productvt-supermetas-v1";
  var DEFAULT_SUPERMETAS = [
    { id: "sg-titulo", name: "Título", color: "#3A6B54", calendar: "Título", goals: [
      { id: "g-ramo1", name: "Ramo 1",
        tareas: [ { id: "t-guias", name: "Estudiar guías", targetSeconds: 10 * 3600 } ],
        eventos: [ { id: "e-certamen", name: "Certamen 1", when: "fecha definida" } ] },
      { id: "g-proyecto", name: "Proyecto",
        tareas: [ { id: "t-informe", name: "Escribir informe", targetSeconds: 6 * 3600 } ],
        eventos: [ { id: "e-entrega", name: "Entrega", when: "fecha definida" } ] }
    ] },
    { id: "sg-tesis", name: "Tesis", color: "#4E6E8E", calendar: null, goals: [
      { id: "g-cap2", name: "Capítulo 2",
        tareas: [ { id: "t-escribir", name: "Escribir", targetSeconds: 20 * 3600 } ],
        eventos: [ { id: "e-profesor", name: "Reunión con profesor", when: "atemporal" } ] }
    ] },
    { id: "antimeta", name: "Antimeta", color: "#9C4A3A", calendar: null, anti: true, goals: [] }
  ];
  function loadSupermetas(){
    try{ var raw = localStorage.getItem(SUPERMETAS_KEY); return raw ? JSON.parse(raw) : DEFAULT_SUPERMETAS.slice(); }
    catch(e){ return DEFAULT_SUPERMETAS.slice(); }
  }
  var SUPERMETAS = loadSupermetas();
  function supermetaById(id){ return SUPERMETAS.find(function(s){ return s.id === id; }); }
  function goalById(sg, id){ return sg ? sg.goals.find(function(g){ return g.id === id; }) : null; }

  var DEFAULT_TIME_OPTIONS = {
    study: [15, 20, 25, 30, 40, 50, 60, 90],
    short: [3, 5, 10, 15],
    long: [10, 15, 20, 35],
    inverso: [10, 15, 20, 30, 45, 60, 90]
  };
  var MAX_MINUTES = { study: 600, short: 600, long: 600, inverso: 1440 };
  var TIME_FIELD_TO_CONFIG = { study: "studyMinutes", short: "shortBreakMinutes", long: "longBreakMinutes", inverso: "inversoMinutes" };
  var CUSTOM_TIMES_KEY = "productvt-tiempos-personalizados-v1";
  function loadCustomTimes(){
    try{ var raw = localStorage.getItem(CUSTOM_TIMES_KEY); return raw ? JSON.parse(raw) : { study: [], short: [], long: [], inverso: [] }; }
    catch(e){ return { study: [], short: [], long: [], inverso: [] }; }
  }
  function saveCustomTimes(){ try{ localStorage.setItem(CUSTOM_TIMES_KEY, JSON.stringify(customTimes)); }catch(e){} }
  var customTimes = loadCustomTimes();
  if(!customTimes.inverso) customTimes.inverso = [];
  function timeOptionsFor(field){
    var merged = DEFAULT_TIME_OPTIONS[field].concat(customTimes[field]);
    var uniq = Array.from(new Set(merged));
    uniq.sort(function(a,b){ return a - b; });
    return uniq;
  }
  function isCustomTime(field, n){ return DEFAULT_TIME_OPTIONS[field].indexOf(n) === -1; }

  var CYCLES_BEFORE_LONG_OPTIONS = [2, 3, 4, 6];
  var LUNCH_MINUTES = 45;
  var LUNCH_COOLDOWN_CYCLES = 3;
  var LARGE_SEGMENT_THRESHOLD_SECONDS = 1800;
  var CANCEL_CONFIRM_WINDOW_SECONDS = 15;
  var PRESET_KEY = "productvt-cronometro-formatos-v1";

  function loadPresets(){
    try{ var raw = localStorage.getItem(PRESET_KEY); return raw ? JSON.parse(raw) : []; }
    catch(e){ return []; }
  }
  function savePresets(list){
    try{ localStorage.setItem(PRESET_KEY, JSON.stringify(list)); }catch(e){}
  }
  var BUILTIN_PRESET = { id: "pomo-clasico", name: "Pomodoro clásico", studyMinutes: 25, shortBreakMinutes: 5, longBreakMinutes: 15, cyclesBeforeLongBreak: 4 };
  var presets = loadPresets();
  if(!presets.some(function(p){ return p.id === BUILTIN_PRESET.id; })){
    presets = [BUILTIN_PRESET].concat(presets); // v3 §C2: preset por defecto (no persistido)
  }
  var config = {
    studyMinutes: 25,
    shortBreakMinutes: 5,
    longBreakMinutes: 15,
    cyclesBeforeLongBreak: 4,
    inversoMinutes: 30
  };

  // ---- Reglas de negocio (docs/03-CRONOMETRO.md) ----
  function computeGrantedBreakSeconds(cycleNumber){
    var short = config.shortBreakMinutes * 60;
    var givesWay = cycleNumber % config.cyclesBeforeLongBreak === 0;
    var long = givesWay ? config.longBreakMinutes * 60 : 0;
    return short + long;
  }
  function resolveBreakType(usedSeconds, grantedSeconds, cycleNumber){
    if(usedSeconds === 0) return "skipped";
    var givesWay = cycleNumber % config.cyclesBeforeLongBreak === 0;
    if(usedSeconds === grantedSeconds) return givesWay ? "long" : "short";
    return "custom";
  }
  function resolveStudyResponseWindowSeconds(cycleNumber, durationSeconds){
    var givesWay = cycleNumber % config.cyclesBeforeLongBreak === 0;
    var isLarge = durationSeconds > LARGE_SEGMENT_THRESHOLD_SECONDS;
    return (isLarge || givesWay) ? 600 : 30;
  }
  function resolveBreakResponseWindowSeconds(breakType, usedSeconds){
    var isLong = breakType === "long" || usedSeconds > LARGE_SEGMENT_THRESHOLD_SECONDS;
    return isLong ? 600 : 30;
  }
  function isLunchAvailable(){
    return !session.lunchUsed || session.cyclesSinceLunch >= LUNCH_COOLDOWN_CYCLES;
  }

  var stage = document.getElementById("stage");
  var topTitle = document.getElementById("topTitle");
  var rolePill = document.getElementById("rolePill");
  var roleLabel = document.getElementById("roleLabel");
  var speedSelect = document.getElementById("speedSelect");
  var lunchCounterEl = document.getElementById("lunchCounter");
  var WAITING_STATES = ["study_completed_waiting_response", "break_selection", "break_completed_waiting_response"];

  var state = {
    screen: "setup",
    role: "dominante",
    cronometroType: "normal",
    category: categoriesOf("productiva")[0],
    remaining: 0,
    total: 0,
    ringColor: "var(--accent)",
    showSaveForm: false,
    showNewCat: false,
    newCatColor: PALETTE[0],
    customTimeField: null,
    customBreakOpen: false,
    linkedMetaId: null,
    presetOn: false,          // v3.1 §H1: toggle cuadrado "Usar preset"
    personalizeOn: false,     // v3.1 §H1: toggle cuadrado "Personalizar"
    editingPresets: false,    // v3.1 §H2: modo edición de presets
    chosenSupermetaId: null,  // v3 §C2 paso 2
    chosenGoalId: null,       // v3 §C2 paso 3
    blockKind: null,          // v3 §C3 paso 4: "evento" | "tarea"
    chosenTargetId: null,     // v3 §C3: evento o tarea elegida
    activePresetId: null,
    metaFlashed: false,
    speed: 30,
    tickHandle: null
  };

  var session = null; // se crea en START_SESSION, se limpia al volver a "setup"
  var activeCancelCleanup = null;

  function fmt(sec){
    sec = Math.max(0, Math.ceil(sec));
    var m = Math.floor(sec/60), s = sec%60;
    return String(m).padStart(2,"0") + ":" + String(s).padStart(2,"0");
  }
  function fmtMin(sec){ return Math.round(sec/60) + " min"; }

  function stopTicking(){
    if(state.tickHandle){ clearInterval(state.tickHandle); state.tickHandle = null; }
  }

  function startTicking(onTick, onDone){
    stopTicking();
    var last = Date.now();
    state.tickHandle = setInterval(function(){
      var now = Date.now();
      var dt = (now - last) / 1000 * state.speed;
      last = now;
      state.remaining -= dt;
      if(state.remaining <= 0){
        state.remaining = 0;
        stopTicking();
        onTick();
        onDone();
      } else {
        onTick();
      }
    }, 100);
  }

  function tickUp(onTick, onTarget, onHardCap){
    stopTicking();
    var last = Date.now();
    state.tickHandle = setInterval(function(){
      var now = Date.now();
      var dt = (now - last) / 1000 * state.speed;
      last = now;
      state.elapsed += dt;
      if(!state.metaFlashed && state.elapsed >= state.targetSeconds){
        state.metaFlashed = true;
        onTarget();
      }
      if(state.elapsed >= state.hardCapSeconds){
        state.elapsed = state.hardCapSeconds;
        stopTicking();
        onTick();
        onHardCap();
      } else {
        onTick();
      }
    }, 100);
  }

  function goto(screen, opts){
    stopTicking();
    if(activeCancelCleanup){ activeCancelCleanup(); activeCancelCleanup = null; }
    state.screen = screen;
    Object.assign(state, opts || {});
    render();
  }

  // ---- Motor: sesión de estudio (docs/03-CRONOMETRO.md §4) ----

  function startSession(){ // T1
    session = {
      cyclesCompleted: 0, cyclesSinceLunch: 0, lunchUsed: false,
      effectiveStudySeconds: 0, bankRemainingSeconds: 0,
      stateBeforeLunch: null, pausedSegment: null,
      pendingBreak: null, lastBreakType: null, lastBreakUsedSeconds: 0,
      link: captureLink() // v3 §C3: calificación del bloque + calendario destino (v3 §D)
    };
    enterStudyRunning();
  }

  function captureLink(){ // v3 §C2–C3 (pasos 2–4) y §D1–D3
    var sg = supermetaById(state.chosenSupermetaId);
    if(!sg) return null;
    var goal = goalById(sg, state.chosenGoalId);
    var target = null;
    if(goal && state.blockKind === "evento") target = goal.eventos.filter(function(e){ return e.id === state.chosenTargetId; })[0];
    if(goal && state.blockKind === "tarea") target = goal.tareas.filter(function(t){ return t.id === state.chosenTargetId; })[0];
    return {
      supermeta: sg.name, anti: !!sg.anti,
      goal: goal ? goal.name : null,
      kind: state.blockKind,
      target: target ? target.name : null,
      targetSeconds: target && target.targetSeconds ? target.targetSeconds : null,
      // v3 §D2–D3: calendario vinculado; si no hay, la supermeta crea uno propio con su nombre y color
      calendar: sg.calendar || sg.name,
      ownCalendar: !sg.calendar,
      color: sg.calendar ? null : sg.color
    };
  }

  function enterStudyRunning(){ // T1 / T9 / T13 (retorno) / T14->T13
    state.total = config.studyMinutes * 60;
    state.remaining = state.total;
    state.ringColor = "var(--accent)";
    goto("study_running");
    startTicking(renderRing, handleStudyFinished);
  }

  function handleStudyFinished(){ // T2, auto
    session.cyclesCompleted++;
    session.cyclesSinceLunch++;
    session.effectiveStudySeconds += config.studyMinutes * 60;
    enterStudyWaiting();
  }

  function enterStudyWaiting(){ // T2 destino / T3 (ventana propia) / retorno T13
    var windowSeconds = resolveStudyResponseWindowSeconds(session.cyclesCompleted, config.studyMinutes * 60);
    state.total = windowSeconds; state.remaining = windowSeconds;
    goto("study_completed_waiting_response");
    startTicking(renderRing, handleExpire);
  }

  function ackStudyFinished(){ // T3
    var windowSeconds = resolveStudyResponseWindowSeconds(session.cyclesCompleted, config.studyMinutes * 60);
    state.total = windowSeconds; state.remaining = windowSeconds;
    goto("break_selection");
    startTicking(renderRing, handleExpire);
  }

  function chooseSuggestedBreak(){ // T4
    var granted = computeGrantedBreakSeconds(session.cyclesCompleted);
    if(granted <= 0){ skipBreak(); return; }
    enterBreakRunning(granted, session.cyclesCompleted);
  }

  function chooseCustomBreak(chosenSeconds){ // T5
    if(chosenSeconds <= 0){
      registerBreakSegment(0, session.cyclesCompleted);
      enterStudyRunning();
      return;
    }
    enterBreakRunning(chosenSeconds, session.cyclesCompleted);
  }

  function skipBreak(){ // T6
    registerBreakSegment(0, session.cyclesCompleted);
    enterStudyRunning();
  }

  function enterBreakRunning(seconds, cycleAtGrant){
    state.total = seconds; state.remaining = seconds;
    state.ringColor = "var(--break)";
    session.pendingBreak = { cycleAtGrant: cycleAtGrant };
    goto("break_running");
    startTicking(renderRing, handleBreakFinished);
  }

  function handleBreakFinished(){ // T8, auto
    var usedSeconds = state.total;
    var cycleAtGrant = session.pendingBreak.cycleAtGrant;
    var breakType = registerBreakSegment(usedSeconds, cycleAtGrant);
    var windowSeconds = resolveBreakResponseWindowSeconds(breakType, usedSeconds);
    session.lastBreakType = breakType; session.lastBreakUsedSeconds = usedSeconds;
    state.total = windowSeconds; state.remaining = windowSeconds;
    goto("break_completed_waiting_response");
    startTicking(renderRing, handleExpire);
  }

  function registerBreakSegment(usedSeconds, cycleAtGrant){
    var granted = computeGrantedBreakSeconds(cycleAtGrant);
    var breakType = resolveBreakType(usedSeconds, granted, cycleAtGrant);
    session.bankRemainingSeconds += (granted - usedSeconds);
    session.lastBreakType = breakType; session.lastBreakUsedSeconds = usedSeconds;
    return breakType;
  }

  function continueStudy(){ enterStudyRunning(); } // T9
  function endSession(){ goto("session_completed"); } // T7 / T10

  function requestLunch(){ // T11 / T12
    if(!isLunchAvailable()) return;
    var running = state.screen === "study_running" || state.screen === "break_running";
    session.stateBeforeLunch = state.screen;
    session.pausedSegment = running ? { remainingSeconds: state.remaining, totalSeconds: state.total } : null;
    session.lunchUsed = true; session.cyclesSinceLunch = 0;
    state.total = LUNCH_MINUTES * 60; state.remaining = state.total;
    state.ringColor = "var(--lunch)";
    goto("lunch_running");
    startTicking(renderRing, handleLunchFinished);
  }

  function handleLunchFinished(){ // T13
    var back = session.stateBeforeLunch;
    if(session.pausedSegment){
      state.total = session.pausedSegment.totalSeconds;
      state.remaining = session.pausedSegment.remainingSeconds;
      state.ringColor = back === "study_running" ? "var(--accent)" : "var(--break)";
      session.pausedSegment = null;
      goto(back);
      startTicking(renderRing, back === "study_running" ? handleStudyFinished : handleBreakFinished);
    } else if(back === "study_completed_waiting_response"){
      enterStudyWaiting();
    } else if(back === "break_selection"){
      ackStudyFinished();
    } else { // break_completed_waiting_response
      var windowSeconds = resolveBreakResponseWindowSeconds(session.lastBreakType, session.lastBreakUsedSeconds);
      state.total = windowSeconds; state.remaining = windowSeconds;
      goto("break_completed_waiting_response");
      startTicking(renderRing, handleExpire);
    }
  }

  function handleExpire(){ goto("session_expired"); } // T17, auto

  function startInverso(){
    state.targetSeconds = config.inversoMinutes * 60;
    state.hardCapSeconds = state.targetSeconds * 2;
    state.elapsed = 0;
    state.metaFlashed = false;
    state.ringColor = "var(--ocio)";
    goto("inverso_running");
    tickUp(renderRing, function(){ /* meta alcanzada, se refleja en el render/anillo */ }, function(){
      goto("inversoDone", { finalElapsed: state.hardCapSeconds });
    });
  }

  function finishInverso(){
    goto("inversoDone", { finalElapsed: state.elapsed });
  }

  function renderRing(){
    var circle = stage.querySelector(".ring-fill");
    var clock = stage.querySelector(".clock");
    if(state.screen === "inverso_running"){
      var pct = state.hardCapSeconds ? state.elapsed / state.hardCapSeconds : 0;
      if(circle){
        var C = 2 * Math.PI * 108;
        circle.style.strokeDashoffset = (C * (1 - pct));
        circle.style.stroke = state.metaFlashed ? "var(--warn)" : state.ringColor;
      }
      if(clock) clock.textContent = fmt(state.elapsed);
      return;
    }
    var pct2 = state.total ? state.remaining / state.total : 0;
    if(circle){
      var C2 = 2 * Math.PI * 108;
      circle.style.strokeDashoffset = (C2 * (1 - pct2));
      var near = WAITING_STATES.indexOf(state.screen) !== -1 && pct2 < .25;
      circle.style.stroke = near ? "var(--warn)" : state.ringColor;
    }
    if(clock) clock.textContent = fmt(state.remaining);
  }

  function ring(innerHtml, midMarker){
    return '<div class="ring-wrap"><svg viewBox="0 0 240 240">' +
      '<circle class="ring-track" cx="120" cy="120" r="108"></circle>' +
      (midMarker ? '<circle class="ring-mark" cx="120" cy="120" r="108" stroke-dasharray="2 '+(2*Math.PI*108-2)+'" stroke-dashoffset="'+(-2*Math.PI*108*0.5)+'"></circle>' : '') +
      '<circle class="ring-fill" cx="120" cy="120" r="108" stroke-dasharray="' + (2*Math.PI*108) + '"></circle>' +
      '</svg><div class="ring-center">' + innerHtml + '</div></div>';
  }

  function catChip(cat){
    // D6.b: si el bloque está ligado a una meta, su color y nombre mandan sobre los de categoría
    var meta = state.linkedMetaId ? metaById(state.linkedMetaId) : null;
    if(meta) return '<span class="cat-chip"><span class="swatch" style="background:'+(meta.color||cat.color)+'"></span>'+meta.name+'</span>';
    return '<span class="cat-chip"><span class="swatch" style="background:'+cat.color+'"></span>'+cat.name+'</span>';
  }

  function selectHtml(id, options, current, suffix){
    return '<select id="'+id+'">' + options.map(function(n){
      return '<option value="'+n+'" '+(n===current?"selected":"")+'>'+n+(suffix||"")+'</option>';
    }).join("") + '</select>';
  }

  function activePreset(){
    return presets.find(function(p){ return p.id === state.activePresetId; }) || null;
  }

  function timeChips(field, currentValue){
    var opts = timeOptionsFor(field);
    var html = '<div class="time-chips" data-field="'+field+'">';
    opts.forEach(function(n){
      var custom = isCustomTime(field, n);
      html += '<button type="button" class="tchip'+(custom?" custom":"")+'" data-field="'+field+'" data-val="'+n+'" aria-pressed="'+(n===currentValue)+'">'+n+
        (custom ? '<span class="tchip-x" data-field="'+field+'" data-val="'+n+'" title="Quitar">×</span>' : '') +
        '</button>';
    });
    html += '<button type="button" class="tchip add" data-open-custom="'+field+'">+ Otro</button>';
    html += '</div>';
    if(state.customTimeField === field){
      html += '<div class="custom-time-row">' +
        '<input type="number" id="customTimeInput" min="1" max="'+MAX_MINUTES[field]+'" placeholder="min" value="'+currentValue+'">' +
        '<label class="ct-check"><input type="checkbox" id="customTimeSave" checked> Guardar como preset</label>' +
        '<button type="button" class="mini-btn" id="customTimeUse">Usar</button>' +
        '</div>';
      html += '<div class="note">Máximo '+ (MAX_MINUTES[field] >= 60 ? Math.round(MAX_MINUTES[field]/60) + " horas" : MAX_MINUTES[field] + " min") +'.</div>';
    }
    return html;
  }

  function render(){
    var titles = {
      setup: "Cronómetro", study_running: "Estudiando", inverso_running: "Tiempo libre",
      study_completed_waiting_response: "¿Qué sigue?", break_selection: "Elegí tu descanso",
      break_running: "Descanso", break_completed_waiting_response: "Toca estudiar",
      lunch_running: "Almuerzo", inversoDone: "Cronómetro",
      session_completed: "Sesión terminada", session_cancelled: "Bloque cancelado", session_expired: "Tiempo vencido"
    };
    topTitle.textContent = titles[state.screen] || "Cronómetro";
    rolePill.className = "role-pill" + (state.role === "espectador" ? " spectator" : "");
    roleLabel.textContent = state.role === "espectador" ? "Espectador" : "Dominante";
    speedSelect.value = String(state.speed);
    lunchCounterEl.textContent = session ? session.cyclesSinceLunch : 0;

    var html = "";
    var mode = state.cronometroType;
    var typeOfCats = typeForMode(mode);
    var cats = categoriesOf(typeOfCats);
    var lunchBtn = '<button class="btn ghost" id="requestLunch" '+(session && isLunchAvailable() ? "" : "disabled")+'>Almuerzo · '+LUNCH_MINUTES+' min</button>';

    if(state.screen === "setup"){
      html += '<div class="type-toggle">' +
        '<button class="type-btn" data-type="normal" aria-pressed="'+(mode==="normal")+'"><strong>Normal</strong>estudio con bloques y descansos</button>' +
        '<button class="type-btn" data-type="inverso" aria-pressed="'+(mode==="inverso")+'"><strong>Inverso</strong>cronómetro libre para tu ocio</button>' +
        '</div>';

      html += '<div class="state-label">'+(mode==="normal"?"Elegí qué vas a estudiar":"Elegí cómo vas a descansar")+'</div>';

      if(mode === "normal"){
        // ---- v3.1 §H1: paso 1 no excluyente — dos toggles cuadrados ----
        html += '<div class="step-block'+(state.presetOn ? " done" : "")+'">';
        html += '<div class="step-title">Paso 1 · Formato de bloques</div>';
        html += '<div class="choices">' +
          '<button class="sq-btn" id="usePresetToggle" aria-pressed="'+(state.presetOn?"true":"false")+'" type="button"><strong>Usar preset</strong>lista de formatos guardados</button>' +
          '<button class="sq-btn" id="personalizeToggle" aria-pressed="'+(state.personalizeOn?"true":"false")+'" type="button"><strong>Personalizar</strong>definir bloques a mano</button>' +
          '</div>';
        if(state.presetOn){
          html += '<div class="choices" id="presetChoices">' + presets.map(function(p){
            return '<button class="choice preset" data-preset="'+p.id+'" aria-pressed="'+(p.id===state.activePresetId)+'">'+p.name+(state.editingPresets?'<span class="preset-x" data-del-preset="'+p.id+'" title="Borrar formato">×</span>':'')+'</button>';
          }).join("") + '</div>';
          html += '<div class="presets-tools">' +
            '<button class="mini-btn" id="newPresetBtn" type="button">Crear nuevo preset</button>' +
            '<button class="mini-btn ghost" id="editPresetsBtn" type="button">'+(state.editingPresets ? "Listo" : "Editar")+'</button>' +
            '</div>';
        }
        html += '</div>';

        // ---- v3 §C2 pasos 2–4 + §C3: supermeta → meta → tarea/evento (botones cuadrados que se desvanecen, v3.1 §H3) ----
        var sg = supermetaById(state.chosenSupermetaId);
        html += '<div class="step-block'+(sg ? " done" : "")+'">';
        html += '<div class="step-title">Paso 2 · Supermeta</div>';
        html += '<div class="choices">' + SUPERMETAS.map(function(s){
          return '<button class="choice" data-supermeta="'+s.id+'" aria-pressed="'+(s.id===state.chosenSupermetaId)+'"><span class="swatch" style="background:'+s.color+'"></span>'+s.name+(s.anti?'<small>· antimeta</small>':'')+'</button>';
        }).join("") + '</div>';
        html += '</div>';
        if(sg){
          html += '<div class="step-block'+(state.chosenGoalId ? " done" : "")+'">';
          html += '<div class="step-title">Paso 3 · Meta de «'+sg.name+'»</div>';
          html += '<div class="choices">' + sg.goals.map(function(g){
            return '<button class="choice" data-goal="'+g.id+'" aria-pressed="'+(g.id===state.chosenGoalId)+'">'+g.name+'</button>';
          }).join("") + '</div>';
          html += '</div>';
          var goal = goalById(sg, state.chosenGoalId);
          if(goal){
            html += '<div class="step-block'+(state.blockKind ? " done" : "")+'">';
            html += '<div class="step-title">Paso 4 · ¿Cómo califica este bloque?</div>';
            html += '<div class="choices">' +
              '<button class="choice" data-kind="evento" aria-pressed="'+(state.blockKind==="evento")+'">Evento</button>' +
              '<button class="choice" data-kind="tarea" aria-pressed="'+(state.blockKind==="tarea")+'">Tarea</button>' +
              '</div>';
            html += '</div>';
            if(state.blockKind === "evento"){
              html += '<div class="choices">' + goal.eventos.map(function(ev){
                return '<button class="choice" data-evento="'+ev.id+'" aria-pressed="'+(ev.id===state.chosenTargetId)+'"><span class="swatch" style="background:'+sg.color+'"></span>'+ev.name+'<small>'+ev.when+'</small></button>';
              }).join("") + '</div>';
              html += '<div class="helper">Confirma “estoy cumpliendo este evento” definido en tu meta y en tu calendario (v3 §C3).</div>';
            }
            if(state.blockKind === "tarea"){
              html += '<div class="choices">' + goal.tareas.map(function(t){
                return '<button class="choice" data-tarea="'+t.id+'" aria-pressed="'+(t.id===state.chosenTargetId)+'">'+t.name+'<small>objetivo '+fmtMin(t.targetSeconds||0)+'</small></button>';
              }).join("") + '</div>';
              html += '<div class="helper">El tiempo se registra de forma exacta a esta tarea atemporal (v3 §C3). Si superas el objetivo el bloque no se corta: queda exceso en estadísticas y el puntaje se gana al llegar al objetivo (v3 §C4).</div>';
            }
          } else if(sg.anti){
            html += '<div class="helper">La antimeta no tiene metas: el tiempo queda registrado sin puntaje (v3 §A7).</div>';
          }
        }
      } else {
        // v3.1 §K1: las categorías no existen — el inverso se registra solo en la antimeta (categoría invisible, un solo color)
        html += '<div class="choices"><button class="choice" data-supermeta="antimeta" aria-pressed="'+(state.chosenSupermetaId==="antimeta")+'"><span class="swatch" style="background:#9C4A3A"></span>Antimeta<small>categoría invisible · sin puntaje</small></button></div>';
      }

      if(mode === "normal"){
        if(state.personalizeOn){ // v3.1 §H1: panel de personalización del toggle cuadrado
          html += '<div class="settings-block" style="width:100%">';
          html += '<div class="settings-group"><div class="grow"><span class="glabel">Duración de estudio (min)</span></div>' + timeChips("study", config.studyMinutes) + '</div>';
          html += '<div class="settings-group"><div class="grow"><span class="glabel">Descanso corto (min)</span></div>' + timeChips("short", config.shortBreakMinutes) + '</div>';
          html += '<div class="settings-group"><div class="grow"><span class="glabel">Descanso largo (min)</span><span class="gcontrols">cada ' + selectHtml("cyclesBeforeLongSelect", CYCLES_BEFORE_LONG_OPTIONS, config.cyclesBeforeLongBreak, " ciclos") + '</span></div>' + timeChips("long", config.longBreakMinutes) + '</div>';
          html += '</div>';

          var ap = activePreset();
          if(state.showSaveForm){
            html += '<div class="save-row">' +
              '<input type="text" id="presetNameInput" placeholder="Nombre del formato" maxlength="24" value="'+(ap?ap.name:"")+'">' +
              '<button class="mini-btn" id="confirmSave" type="button">Guardar</button>' +
              '<button class="mini-btn ghost" id="cancelSave" type="button">Cancelar</button>' +
              '</div>';
          } else if(ap){
            html += '<div class="save-actions"><span class="editing-tag">Editando «'+ap.name+'»</span>' +
              '<button class="btn ghost" id="updatePreset" type="button">Actualizar</button>' +
              '<button class="btn ghost" id="showSaveForm" type="button">Guardar como nuevo</button></div>';
          } else {
            html += '<button class="btn ghost" id="showSaveForm" type="button">Guardar este formato</button>';
          }
        }
      } else {
        html += '<div class="settings-block">';
        html += '<div class="settings-group"><div class="grow"><span class="glabel">Duración objetivo (min)</span></div>' + timeChips("inverso", config.inversoMinutes) + '</div>';
        html += '</div>';
        html += '<div class="helper">Sigue corriendo después del objetivo, hasta el doble como tope. Podés terminar cuando quieras, sin perder nada.</div>';
      }

      html += '<div class="actions"><button class="btn primary" id="startBtn">'+(mode==="normal"?"Iniciar bloque":"Iniciar tiempo libre")+'</button></div>';
    }

    if(state.screen === "inverso_running"){
      html += '<div class="state-label">Tiempo libre</div>';
      if(state.category) html += catChip(state.category);
      html += ring('<span class="clock">'+fmt(state.elapsed)+'</span><span class="clock-sub">'+(state.metaFlashed?"¡meta cumplida! sigue corriendo":"objetivo "+config.inversoMinutes+" min")+'</span>', true);
      html += '<div class="actions"><button class="btn primary" id="finishInverso">Finalizar</button></div>';
    }

    if(state.screen === "study_running" || state.screen === "break_running" || state.screen === "lunch_running"){
      var label = state.screen === "study_running" ? "Estudiando" : state.screen === "lunch_running" ? "Almuerzo" : "Descanso";
      html += '<div class="state-label">'+label+'</div>';
      if(state.screen === "study_running" && state.category) html += catChip(state.category);
      html += ring('<span class="clock">'+fmt(state.remaining)+'</span><span class="clock-sub">'+fmtMin(state.total)+'</span>');
      html += '<div class="actions">';
      if(state.screen !== "lunch_running") html += lunchBtn;
      html += '<button class="btn danger-ghost" id="cancelBtn">Cancelar bloque</button>';
      html += '</div>';
    }

    if(state.screen === "study_completed_waiting_response"){
      html += '<div class="state-label">¡Bloque terminado!</div>';
      html += '<div class="helper stakes">Si no respondés a tiempo se pierde el tiempo de este bloque.</div>';
      html += ring('<span class="clock">'+fmt(state.remaining)+'</span><span class="clock-sub">para responder</span>');
      html += '<div class="actions"><button class="btn primary" id="ackStudy">Seguir</button>' + lunchBtn + '<button class="btn danger-ghost" id="cancelBtn">Cancelar bloque</button></div>';
    }

    if(state.screen === "break_selection"){
      var granted = computeGrantedBreakSeconds(session.cyclesCompleted);
      var available = session.bankRemainingSeconds + granted;
      html += '<div class="helper stakes">Si no respondés a tiempo se pierde el tiempo de este bloque.</div>';
      html += ring('<span class="clock">'+fmt(state.remaining)+'</span><span class="clock-sub">para elegir</span>');
      html += '<div class="helper">Banco disponible: '+fmtMin(available)+'.</div>';
      html += '<div class="actions">';
      if(granted > 0) html += '<button class="btn primary" id="pickSuggested">Tomar descanso · '+fmtMin(granted)+'</button>';
      if(state.customBreakOpen){
        html += '<div class="custom-time-row"><input type="number" id="customBreakInput" min="0" max="'+Math.floor(available/60)+'" placeholder="min" value="0"><button class="mini-btn" id="useCustomBreak" type="button">Usar</button></div>';
      } else {
        html += '<button class="btn secondary" id="openCustomBreak">Personalizado (0–'+Math.floor(available/60)+' min)</button>';
      }
      html += '<button class="btn secondary" id="skipBreakBtn">Saltar</button>';
      html += lunchBtn;
      html += '<button class="btn ghost" id="endSessionBtn">Terminar sesión</button>';
      html += '</div>';
    }

    if(state.screen === "break_completed_waiting_response"){
      html += '<div class="state-label">Toca estudiar</div>';
      html += '<div class="helper stakes">Si no respondés a tiempo se pierde el tiempo de este bloque.</div>';
      html += ring('<span class="clock">'+fmt(state.remaining)+'</span><span class="clock-sub">para responder</span>');
      html += '<div class="actions"><button class="btn primary" id="continueStudy">Empezar bloque</button>' + lunchBtn + '<button class="btn ghost" id="endSessionBtn">Terminar sesión</button></div>';
    }

    if(state.screen === "inversoDone"){
      html += '<div class="state-label">Tiempo libre registrado</div>';
      html += '<div class="helper">'+fmt(state.finalElapsed)+' de '+(state.category?state.category.name:"ocio")+'.</div>';
      html += '<div class="actions"><button class="btn primary" id="backToSetup">Volver a empezar</button></div>';
    }

    if(state.screen === "session_completed"){
      html += '<div class="state-label">Sesión terminada</div>';
      html += '<div class="helper">Tiempo efectivo de estudio: '+fmtMin(session.effectiveStudySeconds)+'.</div>';
      if(session.link) html += '<div class="helper">Cada bloque quedó registrado como cuadro en el calendario «'+session.link.calendar+'»'+(session.link.ownCalendar ? ' — creado desde la supermeta, con su color' : '')+' (v3 §D).</div>';
      html += '<div class="actions"><button class="btn primary" id="backToSetup">Volver a empezar</button></div>';
    }

    if(state.screen === "session_cancelled"){
      html += '<div class="state-label">Bloque cancelado</div>';
      html += '<div class="helper">Se descartó el bloque en curso. Tiempo efectivo conservado: '+fmtMin(session.effectiveStudySeconds)+'.</div>';
      html += '<div class="actions"><button class="btn primary" id="backToSetup">Volver a empezar</button></div>';
    }

    if(state.screen === "session_expired"){
      html += '<div class="state-label">Se pasó el tiempo</div>';
      html += '<div class="helper">No respondiste a tiempo. Tiempo efectivo conservado: '+fmtMin(session.effectiveStudySeconds)+'.</div>';
      html += '<div class="actions"><button class="btn primary" id="backToSetup">Volver a empezar</button></div>';
    }

    stage.innerHTML = html;
    renderRing();
    wire();
  }

  function applyPresetValues(p){
    state.category = CATEGORIES.find(function(c){ return c.id === p.categoryId; }) || state.category;
    config.studyMinutes = p.studyMinutes;
    config.shortBreakMinutes = p.shortBreakMinutes;
    config.longBreakMinutes = p.longBreakMinutes;
    config.cyclesBeforeLongBreak = p.cyclesBeforeLongBreak;
    state.activePresetId = p.id;
  }

  function wire(){
    var el;
    document.querySelectorAll(".type-btn").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.cronometroType = btn.dataset.type;
        var cats = categoriesOf(typeForMode(state.cronometroType));
        state.category = cats[0] || null;
        state.activePresetId = null;
        state.linkedMetaId = null;
        state.showNewCat = false;
        state.customTimeField = null;
        state.presetOn = false;        // v3.1 §H2: cambiar de pestaña dentro del cronómetro descarta el progreso
        state.personalizeOn = false;
        state.editingPresets = false;
        state.showSaveForm = false;
        state.chosenSupermetaId = null;
        state.chosenGoalId = null;
        state.blockKind = null;
        state.chosenTargetId = null;
        render();
      });
    });

    // ---- v3 §C2/§C3: handlers del flujo por pasos ----
    // ---- v3.1 §H1–H2: toggles cuadrados del paso 1 y gestión de presets ----
    if(el = document.getElementById("usePresetToggle")) el.addEventListener("click", function(){
      state.presetOn = !state.presetOn;
      if(!state.presetOn) state.showSaveForm = false; // salir del modo preset descarta el preset en creación
      render();
    });
    if(el = document.getElementById("personalizeToggle")) el.addEventListener("click", function(){
      state.personalizeOn = !state.personalizeOn;
      if(!state.personalizeOn) state.showSaveForm = false;
      render();
    });
    if(el = document.getElementById("newPresetBtn")) el.addEventListener("click", function(){
      state.personalizeOn = true; state.showSaveForm = true; // misma redirección que el panel de personalización
      render();
      var inp = document.getElementById("presetNameInput"); if(inp) inp.focus();
    });
    if(el = document.getElementById("editPresetsBtn")) el.addEventListener("click", function(){
      state.editingPresets = !state.editingPresets; render();
    });
    if(el = document.getElementById("startBtn")) el.addEventListener("click", function(){
      state.cronometroType === "inverso" ? startInverso() : startSession();
    });
    document.querySelectorAll("[data-supermeta]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.chosenSupermetaId = btn.dataset.supermeta;
        state.chosenGoalId = null; state.blockKind = null; state.chosenTargetId = null;
        render();
      });
    });
    document.querySelectorAll("[data-goal]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.chosenGoalId = btn.dataset.goal;
        state.blockKind = null; state.chosenTargetId = null;
        render();
      });
    });
    document.querySelectorAll("[data-kind]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.blockKind = btn.dataset.kind; state.chosenTargetId = null; render();
      });
    });
    document.querySelectorAll("[data-evento]").forEach(function(btn){
      btn.addEventListener("click", function(){ state.chosenTargetId = btn.dataset.evento; render(); });
    });
    document.querySelectorAll("[data-tarea]").forEach(function(btn){
      btn.addEventListener("click", function(){ state.chosenTargetId = btn.dataset.tarea; render(); });
    });

    if(el = document.getElementById("startBtn")) el.addEventListener("click", function(){
      state.cronometroType === "inverso" ? startInverso() : startSession();
    });
    if(el = document.getElementById("finishInverso")) el.addEventListener("click", finishInverso);
    if(el = document.getElementById("cancelBtn")) el.addEventListener("click", openCancelSheet);
    if(el = document.getElementById("requestLunch")) el.addEventListener("click", requestLunch);
    if(el = document.getElementById("ackStudy")) el.addEventListener("click", ackStudyFinished);
    if(el = document.getElementById("pickSuggested")) el.addEventListener("click", chooseSuggestedBreak);
    if(el = document.getElementById("skipBreakBtn")) el.addEventListener("click", skipBreak);
    if(el = document.getElementById("endSessionBtn")) el.addEventListener("click", endSession);
    if(el = document.getElementById("continueStudy")) el.addEventListener("click", continueStudy);
    if(el = document.getElementById("backToSetup")) el.addEventListener("click", function(){ session = null; goto("setup"); });

    if(el = document.getElementById("openCustomBreak")) el.addEventListener("click", function(){
      state.customBreakOpen = true; render();
      var inp = document.getElementById("customBreakInput"); if(inp) inp.focus();
    });
    if(el = document.getElementById("useCustomBreak")) el.addEventListener("click", function(){
      var inp = document.getElementById("customBreakInput");
      var mins = Math.round(Number(inp && inp.value));
      var max = Number(inp && inp.max);
      if(isNaN(mins) || mins < 0) return;
      mins = Math.min(mins, max);
      state.customBreakOpen = false;
      chooseCustomBreak(mins * 60);
    });

    if(el = document.getElementById("cyclesBeforeLongSelect")) el.addEventListener("change", function(){ config.cyclesBeforeLongBreak = Number(el.value); render(); });

    document.querySelectorAll(".tchip[data-val]").forEach(function(chip){
      chip.addEventListener("click", function(e){
        if(e.target.classList.contains("tchip-x")) return;
        config[TIME_FIELD_TO_CONFIG[chip.dataset.field]] = Number(chip.dataset.val);
        state.customTimeField = null;
        render();
      });
    });
    document.querySelectorAll(".tchip-x").forEach(function(x){
      x.addEventListener("click", function(e){
        e.stopPropagation();
        var field = x.dataset.field, val = Number(x.dataset.val);
        customTimes[field] = customTimes[field].filter(function(n){ return n !== val; });
        saveCustomTimes();
        render();
      });
    });
    document.querySelectorAll("[data-open-custom]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.customTimeField = btn.dataset.openCustom;
        render();
        var inp = document.getElementById("customTimeInput");
        if(inp){ inp.focus(); inp.select(); }
      });
    });
    if(el = document.getElementById("customTimeInput")){
      el.addEventListener("keydown", function(e){ if(e.key === "Enter"){ e.preventDefault(); applyCustomTime(); } });
    }
    if(el = document.getElementById("customTimeUse")) el.addEventListener("click", applyCustomTime);

    if(el = document.getElementById("showSaveForm")) el.addEventListener("click", function(){
      state.showSaveForm = true; render();
      var inp = document.getElementById("presetNameInput");
      if(inp) inp.focus();
    });
    if(el = document.getElementById("cancelSave")) el.addEventListener("click", function(){ state.showSaveForm = false; render(); });
    if(el = document.getElementById("confirmSave")) el.addEventListener("click", function(){ saveCurrentAsPreset(false); });
    if(el = document.getElementById("updatePreset")) el.addEventListener("click", function(){ saveCurrentAsPreset(true); });
    if(el = document.getElementById("presetNameInput")){
      el.addEventListener("keydown", function(e){
        if(e.key === "Enter"){ e.preventDefault(); saveCurrentAsPreset(false); }
      });
    }

    if(el = document.getElementById("openNewCat")) el.addEventListener("click", function(){
      state.showNewCat = true;
      state.newCatColor = lastColor || PALETTE[0];
      render();
      var inp = document.getElementById("newCatName");
      if(inp) inp.focus();
    });
    if(el = document.getElementById("cancelNewCat")) el.addEventListener("click", function(){ state.showNewCat = false; render(); });
    if(el = document.getElementById("confirmNewCat")) el.addEventListener("click", createCategory);
    if(el = document.getElementById("newCatName")){
      el.addEventListener("keydown", function(e){ if(e.key === "Enter"){ e.preventDefault(); createCategory(); } });
    }
    document.querySelectorAll("#newCatPalette button[data-color]").forEach(function(b){
      b.addEventListener("click", function(){ state.newCatColor = b.dataset.color; render(); var inp=document.getElementById("newCatName"); if(inp) inp.focus(); });
    });
    if(el = document.getElementById("newCatColorPicker")){
      el.addEventListener("change", function(){ state.newCatColor = el.value; render(); });
    }

    document.querySelectorAll("#catChoices [data-cat]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.category = CATEGORIES.find(function(c){ return c.id === btn.dataset.cat; });
        state.linkedMetaId = null; // cambiar de categoría a mano invalida cualquier meta vinculada
        render();
      });
    });
    // (v3 §C) el select de meta vinculada fue reemplazado por los pasos supermeta → meta → tarea/evento
    document.querySelectorAll("#presetChoices [data-preset]").forEach(function(btn){
      btn.addEventListener("click", function(e){
        if(e.target.classList.contains("preset-x")) return;
        var p = presets.find(function(pp){ return pp.id === btn.dataset.preset; });
        if(!p) return;
        applyPresetValues(p);
        render();
      });
    });
    document.querySelectorAll("#presetChoices .preset-x").forEach(function(x){
      x.addEventListener("click", function(e){
        e.stopPropagation();
        presets = presets.filter(function(p){ return p.id !== x.dataset.delPreset; });
        if(state.activePresetId === x.dataset.delPreset) state.activePresetId = null;
        savePresets(presets);
        render();
      });
    });
  }

  function applyCustomTime(){
    var field = state.customTimeField;
    if(!field) return;
    var inp = document.getElementById("customTimeInput");
    var checkbox = document.getElementById("customTimeSave");
    var val = Math.round(Number(inp && inp.value));
    if(!val || val < 1) return;
    val = Math.min(val, MAX_MINUTES[field]);
    config[TIME_FIELD_TO_CONFIG[field]] = val;
    if(checkbox && checkbox.checked && isCustomTime(field, val) && customTimes[field].indexOf(val) === -1){
      customTimes[field].push(val);
      saveCustomTimes();
    }
    state.customTimeField = null;
    render();
  }

  function createCategory(){
    var inp = document.getElementById("newCatName");
    var name = inp && inp.value.trim();
    if(!name) return;
    var cat = {
      id: "c" + Date.now() + Math.random().toString(36).slice(2, 6),
      name: name, color: state.newCatColor, type: typeForMode(state.cronometroType)
    };
    CATEGORIES.push(cat);
    saveCategories();
    lastColor = cat.color;
    saveLastColor(lastColor);
    state.category = cat;
    state.showNewCat = false;
    render();
  }

  function saveCurrentAsPreset(updateInPlace){
    var inp = document.getElementById("presetNameInput");
    var typedName = inp && inp.value.trim();
    var data = {
      categoryId: state.category ? state.category.id : null, // v3 §A2: en modo normal ya no hay categorías
      studyMinutes: config.studyMinutes,
      shortBreakMinutes: config.shortBreakMinutes,
      longBreakMinutes: config.longBreakMinutes,
      cyclesBeforeLongBreak: config.cyclesBeforeLongBreak
    };
    if(updateInPlace && state.activePresetId){
      var existing = activePreset();
      if(existing) Object.assign(existing, data);
    } else {
      var name = typedName || ("Formato " + (presets.length + 1));
      var preset = Object.assign({ id: "p" + Date.now() + Math.random().toString(36).slice(2, 6), name: name }, data);
      presets.push(preset);
      state.activePresetId = preset.id;
    }
    savePresets(presets);
    state.showSaveForm = false;
    render();
  }

  function openCancelSheet(){ // T14/T15/T16 — doble confirmación 15s+15s, corre en paralelo a la ventana de respuesta si la hay
    var phase = 1; // 1 = primera espera, 2 = segunda espera (tras el primer toque)
    var unlocked = false;
    var seconds = CANCEL_CONFIRM_WINDOW_SECONDS;
    var wrap = document.createElement("div");
    wrap.className = "overlay";
    wrap.innerHTML = '<div class="sheet">' +
      '<h2>¿Cancelar bloque?</h2>' +
      '<p>Se pierde el tiempo del bloque en curso. Los bloques anteriores ya completados se conservan. No se puede deshacer.</p>' +
      '<button class="btn secondary" id="keepGoing">No, seguir estudiando</button>' +
      '<button class="btn primary" style="background:var(--danger);color:var(--accent-ink)" id="confirmCancel" disabled>Esperá '+seconds+'s…</button>' +
      '</div>';
    document.body.appendChild(wrap);
    var confirmBtn = wrap.querySelector("#confirmCancel");
    var last = Date.now();
    var countdown = setInterval(function(){
      if(unlocked) return;
      var now = Date.now();
      seconds -= (now - last) / 1000 * state.speed;
      last = now;
      if(seconds <= 0){
        unlocked = true;
        confirmBtn.disabled = false;
        confirmBtn.textContent = phase === 1 ? "Sí, cancelar" : "¿Seguro? Sí, cancelar";
      } else {
        confirmBtn.textContent = "Esperá " + Math.ceil(seconds) + (phase === 2 ? "s más…" : "s…");
      }
    }, 100);
    function cleanup(){ clearInterval(countdown); wrap.remove(); activeCancelCleanup = null; }
    activeCancelCleanup = cleanup;
    wrap.querySelector("#keepGoing").addEventListener("click", cleanup);
    confirmBtn.addEventListener("click", function(){
      if(!unlocked) return;
      if(phase === 1){
        phase = 2; unlocked = false; seconds = CANCEL_CONFIRM_WINDOW_SECONDS; last = Date.now();
        confirmBtn.disabled = true;
        confirmBtn.textContent = "Esperá " + seconds + "s más…";
        return;
      }
      cleanup();
      goto("session_cancelled");
    });
  }

  function openConflictSheet(){
    var wrap = document.createElement("div");
    wrap.className = "overlay";
    wrap.innerHTML = '<div class="sheet">' +
      '<h2>Otro dispositivo quiere el control</h2>' +
      '<p>Solo un dispositivo puede iniciar o modificar el bloque a la vez. El que confirme primero queda como dominante; el otro pasa a espectador (puede seguir viendo el conteo).</p>' +
      '<button class="btn secondary" id="keepControl">Mantener el control acá</button>' +
      '<button class="btn primary" id="giveControl">Ceder el control</button>' +
      '</div>';
    document.body.appendChild(wrap);
    wrap.querySelector("#keepControl").addEventListener("click", function(){ wrap.remove(); });
    wrap.querySelector("#giveControl").addEventListener("click", function(){
      wrap.remove();
      state.role = "espectador";
      render();
    });
  }

  speedSelect.addEventListener("change", function(){ state.speed = Number(speedSelect.value); });
  document.getElementById("resetLunch").addEventListener("click", function(){ if(session) session.cyclesSinceLunch = 0; render(); });
  document.getElementById("simConflict").addEventListener("click", openConflictSheet);
  document.getElementById("skipTimer").addEventListener("click", function(){
    if(state.screen === "inverso_running"){
      state.elapsed = Math.max(state.elapsed, state.targetSeconds - 0.2);
    } else if(state.tickHandle){
      state.remaining = 0.05;
    }
  });

  render();
})();
</script>
</file>

<file path="03-requisitos/decisiones-tomadas.md">
# Decisiones tomadas — Productvt Beta

Este documento resuelve las 24 preguntas de [preguntas-para-el-creador.md](preguntas-para-el-creador.md). Tiene **prioridad sobre SPEC.md, ARCHITECTURE.md e IMPLEMENTATION_PLAN.md** en caso de conflicto — son enmiendas, no un documento aparte.

**v2 (2026-09-05)**: reemplaza la v1 con las respuestas definitivas del creador (respondidas directamente, más precisas que la primera pasada). Los puntos 1, 2, 3, 5, 14–17 cambian respecto de v1; el resto se mantiene.

La fase de Mockup queda **superada**: se construye la aplicación real (Expo + Firebase) directamente, como prototipo funcional compilable, no como diseño estático.

## Cronómetro de estudio

1. **No existe "finalizar sesión conservando progreso" a mitad de un bloque** (corrige v1): las únicas formas de cerrar una sesión son completarla normalmente (entre bloques, con "Terminar sesión" en la selección de descanso o al terminar un descanso — sin penalización), cancelarla, o dejarla expirar. No se agrega ninguna acción de "finalizar ahora conservando lo estudiado" disponible en cualquier estado.
1.b **Cancelación = misma severidad que expiración** (CONFIRMADO directamente por Gregorio el 2026-09-06, pregunta 25 de preguntas-para-el-creador.md — corrige v1/v2, que mantenían cancelación como pérdida total): al cancelar, se pierde solo el `effectiveStudySeconds` del bloque/tramo en curso; los bloques previos ya completados en la misma sesión conservan su tiempo efectivo (misma regla que el punto 2 para expiración). La sesión queda `status: 'cancelled'`, `completionReason: 'cancelled_by_user'`. **Fricción de cancelación — resuelto por Front End (productvt-9b, 2026-09-06), pendiente solo de que Gregorio lo objete si quiere pesar distinto**: se mantiene la doble confirmación de 15+15s **sin cambios** — el razonamiento de Front End es que la fricción de "cooling-off" no depende de cuánto se pierde, sino de que cancelar a mitad de bloque es una decisión activa e impulsiva en el momento exacto de la tentación (a diferencia de expirar, que es negligencia pasiva); ese momento merece igual o más fricción, no menos. **Sí se elimina** cualquier elemento punitivo *impuesto por la app* (animación triste, copy de culpa escrito por el equipo) — eso se sentía desproporcionado con el costo ahora más bajo. La `cancellationPhrase` personalizable (SPEC §11.4, ya en `UserProfile`) se mantiene y es, de hecho, el mecanismo correcto para el peso emocional: no es la app regañando, es un compromiso que la persona se escribió a sí misma, así que funciona igual de bien con costo bajo que con costo alto. El banco de descanso de la sesión se pierde igual al cancelar (no cambia — ver "Alcance del banco" en SPEC §17.6, es independiente de esta regla).
2. **Expiración = pérdida solo del ciclo en curso, no de la sesión completa** (CONFIRMADO directamente por el creador tras desambiguación explícita el 2026-09-05 — no es una interpretación nuestra): al expirar por no responder a tiempo, se pierde el `effectiveStudySeconds` del ciclo/tramo que estaba en curso al momento de expirar. Los ciclos **previos ya completados en esa misma sesión mantienen su tiempo efectivo** y sí cuentan para estadísticas. La sesión queda con `status: 'expired'`, pero su `effectiveStudySeconds` final es la suma de los ciclos completados antes de la expiración (no cero). Se descarta explícitamente la lectura alternativa ("bloque" = sesión completa, per glosario SPEC §44) que había planteado productvt-eb.
3. **Ventanas de espera por tamaño del tramo, no por tipo de estado** (corrige v1): **30 segundos** para tramos/descansos pequeños (descanso corto, ciclo de estudio regular). **10 minutos** para tramos o descansos grandes — específicamente el ciclo que da paso al descanso largo y el propio descanso largo (tanto para decidir tomarlo como para el "toca estudiar" al terminarlo). Regla operativa: si el tramo relevante es el descanso largo (o el ciclo que lo antecede), usar 10 min; en cualquier otro caso, 30 s.
4. **Temporizador inverso**: no se autodetiene al llegar a la duración objetivo — sigue corriendo, pero con un **tope superior = 2× la duración objetivo** (el objetivo original más "un bloque más" de margen). Al llegar a ese tope se fuerza el cierre automático (auto-finish) y se guarda el bloque igual. Al alcanzar el objetivo original (antes del tope) suena una notificación de "meta alcanzada" y el botón "Finalizar" se resalta.
5. **Almuerzo: máximo 1 uso cada 3 bloques/ciclos** (corrige v1, no era "1 por sesión"): se necesita un contador de ciclos transcurridos desde el último uso de almuerzo; se rehabilita al llegar a 3.

## Categorías y colores

6. **Colores en cascada, incluyendo histórico** (confirma v1, respuesta directa del creador: "deben actualizarse"): cambiar el color de una categoría actualiza la categoría, sus subcategorías, y **también** lo que ya está guardado — calendario, historial y estadísticas siempre pintan con el color **vigente** de la categoría. Se elimina `colorSnapshot` como fuente de verdad visual (no se usa para pintar en ningún lado).

6.b **Excepción confirmada a D6 — el color de meta manda sobre el de categoría cuando el bloque pertenece a una meta** (respuesta directa del creador, 2026-09-06, cierra la última pregunta abierta de la ampliación Galaxia/Tienda — corrige la resolución anterior de `productvt-90` en `nueva-funcionalidad-galaxia-tienda.md`, que asumía que D6 no tenía excepciones): jerarquía de color, de mayor a menor prioridad:
    - **Supermeta**: tiene su propio color (el más importante, el "primario").
    - **Meta** (hija de una supermeta vía `parentGoalId`): tiene su propio "subcolor" — **por defecto hereda el color de la supermeta al crearse**, pero el usuario puede cambiarlo por meta individual.
    - **Categoría**: sigue siendo el color de fallback — **solo aplica a un bloque de estudio "random"**, es decir, uno que **no** está asociado a ninguna meta. Para esos, D6 sigue vigente tal cual (color vigente de categoría, sin excepción).
    - **Si el bloque SÍ está asociado a una meta**: el color de esa meta **manda por sobre el color de categoría en el Cronómetro** (pantalla del timer activo). Ya no es "sin excepción" — la excepción es exactamente "bloque ligado a una meta".
    - **En el Calendario**, un evento ligado a una meta se pinta con **dos colores**: el color de la **meta** para el evento en sí (relleno principal), y el color de la **supermeta** como una **segunda raya/franja** secundaria (identifica visualmente "a qué calendario/capa pertenece", ej. "Universidad" como supermeta) — coherente con el modelo de "Calendario por capas" ya resuelto (una capa de meta filtra por su categoría, pero visualmente ahora también lleva el acento de color de su supermeta).
    - Esta jerarquía de color es independiente de si la meta está o no vinculada a la Galaxia visualmente — aplica en cuanto una `WeeklyGoal` con `parentGoalId` existe y un `StudySession`/evento se asocia a ella (el mecanismo exacto de esa asociación — un campo `goalId?` nuevo en la sesión, probablemente — queda a definir por quien lo arquitecture).
    - **No es solo un ajuste de color (observación de productvt-9b, 2026-09-06)**: hoy ni el Cronómetro ni el Calendario tienen el concepto de "este bloque/evento está ligado a tal meta" — ambos solo trabajan con categoría. Aplicar esta regla exige una integración funcional real: elegir a qué meta (si alguna) se liga un bloque **al iniciarlo** en el Cronómetro, o dejarlo "random" sin meta — no es retroactivo ni solo visual. productvt-9b se lo está preguntando a Gregorio para ver si se prioriza ahora o se deja para cuando cierre el resto de Galaxia/Metas (V1.1).
7. **Estrella mensual** (confirma v1): un mes **sin ninguna meta configurada NO obtiene estrella**. Solo hay estrella cuando hay constancia real: al menos una semana cerrada con al menos una meta configurada, todas cumplidas.

## Arquitectura de código

Delegación total y explícita del creador para los puntos 8–13, 15, 17, 18, 19, 21 ("ni idea, solucionalo para que tenga coherencia y adáptalo para que sea óptimo, puedes borrar archivos, modificar la estructura o arquitectura para que sea más robusta o completa en general"). Con una restricción dura que aplica a todos ellos: **priorizar estabilidad y funcionalidad sin sumar costo monetario adicional**.

8. Se puebla `src/application/coordinators/` con `StudySessionCoordinator` y `ActiveTimerRecoveryService`. Los "assemblers" de stats/calendar quedan donde el plan ya los puso (`features/*/services/`), por ser más específicos de su feature.
9. **Repositorio obligatorio para todo agregado**: se agregan `CategoryRepository`, `PresetRepository`, `SettingsRepository`. Ningún service habla con Firestore directo, sin excepciones. Todo esto usando solo el plan gratuito de Firebase (Spark) — Auth + Firestore free tier alcanzan para V1 de un solo usuario.
10. Se **elimina la carpeta `screens/`**. Toda la UI vive en `features/*/components/` + `app/(tabs)/*.tsx`.

## Modelo de datos (nombres canónicos)

11. `remindersTriggered` (no `reminderCount`).
12. `status` (no `sessionStatus`) como nombre canónico en todas las entidades de sesión. `StudySession` incluye explícitamente `customBreakSelections[]`, `completionReason`, `deviceInfo?`.
13. Se mantiene la distinción intencional: `startedAt`/`endedAt` para lo que **ya ocurrió** (StudySession, InverseSession) vs. `startAt`/`endAt` para lo **planificado** (InvisibleEvent).

## Sincronización multi-dispositivo — modelo "dominante / espectador" (respuesta directa y más precisa del creador, corrige el modelo genérico de v1)

14. Todo lo que **no** es el timer activo (crear/editar categorías, presets, eventos invisibles, metas, etc.) funciona en **paralelo sin restricciones** en todos los dispositivos — es CRUD normal contra Firestore, sin necesidad de arbitraje.
   Para el **timer activo** específicamente: en un momento dado, un solo dispositivo es **dominante** (puede iniciar/accionar el bloque); los demás son **espectadores** (ven el contador en vivo vía `onSnapshot`, pero sus controles están deshabilitados para accionar). Si un espectador intenta interactuar con un control, se dispara una solicitud de cambio de dominante: aparece un diálogo "¿Quieres tomar el control?" tanto en el espectador como en el dominante actual. Quien confirme primero (resuelto con una transacción atómica de Firestore sobre el campo `dominantDeviceId`) se convierte en el nuevo dominante; el otro pasa a espectador automáticamente.
15. Dado el modelo dominante/espectador, no hay conflicto real de "qué fuente gana": el dominante es siempre la fuente de verdad mientras lo es, y el AsyncStorage local solo importa para el dispositivo que actualmente ostenta el rol dominante (para sobrevivir cierres accidentales de ese mismo dispositivo).
16. **Sesión "zombie" expira a las 24 horas exactas** sin checkpoint nuevo (respuesta directa del creador, con algo de incertidumbre pero con este número concreto). Se resuelve de forma perezosa: el próximo cliente que consulte `activeStudySessionRef` y vea que pasaron 24h desde el último checkpoint, la cierra como `expired` (aplicando la regla del punto 2: solo se pierde el tramo en curso, los ciclos previos completados mantienen su tiempo efectivo).

## Confiabilidad técnica — sin costo monetario adicional (restricción dura, repetida explícitamente por el creador)

17. Se usa un **Development Build LOCAL** (`npx expo run:android` / `expo prebuild` + Android Studio/Gradle en la máquina del creador), **no EAS Build en la nube** (evita consumir cuota paga) y no Expo Go puro (por notificaciones locales confiables en background y `expo-document-picker`/audio personalizado). Esto se configura desde la Fase 4 (núcleo del timer).
18. El audio personalizado por dispositivo es una preferencia **local** (AsyncStorage), no sincronizada entre dispositivos en V1 — limitación aceptada; subir a Firebase Storage queda para V2 (y también evita costo de Storage en V1).

## Aclaraciones técnicas adicionales (revisión de productvt-eb sobre SPEC.md)

- **Ambigüedad del punto 2, ya resuelta**: ver punto 2 arriba — Gregorio confirmó directamente y de forma explícita (2026-09-05) que "bloque" se refiere al ciclo/tramo en curso dentro de la sesión, no a la sesión completa. No queda pendiente.
- **Retorno de `lunch_running`**: al activar el almuerzo desde cualquier estado activo (`study_running` o `break_running`), ese estado se guarda en `lunchReturnState` (campo ya previsto en ARCHITECTURE.md §11.4) y se restaura exactamente al terminar el almuerzo — sin recalcular ni saltar al siguiente ciclo.
- **Campos de persistencia de la sesión activa en Firestore** (no solo en el store local, necesarios para que cualquier dispositivo pueda resolver deadlines y la regla de zombie a 24h sin depender del dispositivo que originó la sesión): el documento de `activeStudySessionRef` debe incluir explícitamente `currentState` (estado de la máquina), `responseDeadlineAt` (deadline de la ventana de espera vigente, si aplica) y `lastCheckpointAt` (timestamp del último checkpoint escrito).
- **Banco de descanso — evitar doble conteo entre SPEC §17.5 y §17.6**: regla operativa única: al finalizar un ciclo de estudio, el descanso "ganado" (corto, o corto+largo cuando corresponde) se suma UNA sola vez al banco disponible de la sesión. Cualquier decisión posterior (saltar, tomar parcial, tomar completo) solo CONSUME de ese banco ya sumado; nunca se vuelve a sumar la parte "no usada" como si fuera un ingreso nuevo — lo no usado es simplemente lo que nunca se restó del banco.

## Alcance de plataformas — web es consulta/gestión, no ejecución del cronómetro (aplica SPEC §7.2, hallazgo de productvt-eb)

El navegador no puede sostener con confiabilidad un cronómetro en vivo con alarmas: los tabs no enfocados throttlean `setInterval`/`setTimeout`, el audio automático requiere gesto de usuario reciente, no hay Web Push sin Service Worker adicional (fuera del free tier de Firebase Hosting), y `react-native-web` no tiene paridad con `expo-audio`/`expo-notifications`/`expo-task-manager`. Aplicando la prioridad que ya fija SPEC §7.2 ("ante diferencias de fiabilidad, prioriza Android para las funciones más sensibles del cronómetro"):
- **Android es la única plataforma que puede ser dominante** (iniciar/accionar un bloque de estudio o temporizador inverso, con alarmas reales). La web **nunca** puede tomar el rol dominante en el modelo del punto 14 — sus controles de iniciar/accionar quedan deshabilitados.
- **Web puede ver el cronómetro activo en modo espectador** (mismo `onSnapshot` del modelo dominante/espectador), sin alarmas de audio propias.
- Calendario, estadísticas, categorías/presets/settings y metas funcionan igual en web (CRUD normal contra Firestore, sin depender de timers en background) — ahí no hay ninguna limitación.

