  grantedSeconds: number;
  usedSeconds: number;
  bankDeltaSeconds: number;
  start: string;
  end: string;
  cycleNumber: number;
}

/**
 * Un uso del botón de almuerzo/pánico dentro de la sesión (SPEC.md sección 18). No suma ni resta
 * del banco de descanso y no cuenta como estudio efectivo.
