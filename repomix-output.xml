<script>
(function(){
  var NAV_URLS = { inicio: "https://claude.ai/code/artifact/918a4c24-9421-4440-b696-463cca63a266" };
  // ---- v3.1 §K1: LAS CATEGORÍAS NO EXISTEN. Todo se gestiona en metas y supermetas;
  // aparte están los CALENDARIOS (antes "capas"), que son entidades independientes. ----
  var SUPER_KEY = "productvt-supermetas-v1";   // misma fuente que Configuración y Galaxia
  var CALENDARIOS_KEY = "productvt-capas-v1";  // misma clave compartida (compatibilidad)

  function loadSupermetas(){
    try{
      var raw = localStorage.getItem(SUPER_KEY);
      if(raw){
        var parsed = JSON.parse(raw);
        if(parsed.length) return parsed;
      }
    }catch(e){}
    return [
      { id: "sg-titulo", name: "Título", color: "#4E6E8E", anti: false, calendarId: "cap-uni", deadline: null, goals: [
        { id: "g-ramo1", name: "Ramo 1", color: "#3A6B54", deadline: null, tareas: [], eventos: [] },
        { id: "g-proyecto", name: "Proyecto", color: "#2E7B84", deadline: null, tareas: [], eventos: [] } ] },
      { id: "sg-tesis", name: "Tesis", color: "#B9812E", anti: false, calendarId: null, deadline: null, goals: [
        { id: "g-cap2", name: "Capítulo 2", color: "#8C5A7A", deadline: null, tareas: [], eventos: [] } ] },
      { id: "antimeta", name: "Antimeta", color: "#9C4A3A", anti: true, calendarId: null, deadline: null, goals: [] }
    ];
  }
  var SUPERMETAS = loadSupermetas();
  function saveSupermetas(){ try{ localStorage.setItem(SUPER_KEY, JSON.stringify(SUPERMETAS)); }catch(e){} }
  function superById(id){ return SUPERMETAS.filter(function(s){ return s.id === id; })[0] || null; }
  function goalById(id){
    var found = null;
    SUPERMETAS.forEach(function(s){ s.goals.forEach(function(g){ if(g.id === id) found = { goal: g, sup: s }; }); });
    return found;
  }
  function superOfGoal(id){ var f = goalById(id); return f ? f.sup : null; }

  // ---- Calendarios (v3.1 §K2): entidades independientes, asociables a una o más supermetas ----
  function loadCalendarios(){
    try{ var raw = localStorage.getItem(CALENDARIOS_KEY); if(raw) return JSON.parse(raw); }catch(e){}
    return [{ id: "cap-uni", name: "Universidad", color: "#4E6E8E" }];
  }
  function saveCalendarios(){ try{ localStorage.setItem(CALENDARIOS_KEY, JSON.stringify(CALENDARIOS)); }catch(e){} }
  var CALENDARIOS = loadCalendarios();
  function calById(id){ return CALENDARIOS.filter(function(c){ return c.id === id; })[0] || null; }
  function supersOfCal(calId){ return SUPERMETAS.filter(function(s){ return s.calendarId === calId; }); }

  // ---- v3.1 §K3: sistema de 3 colores de los eventos del calendario ----
  //  1) relleno del evento = color de la META a la que pertenece
  //  2) primera etiqueta (rallita vertical) = color del CALENDARIO
  //  3) segunda etiqueta = color de la SUPERMETA
  //  Los eventos inversos usan un solo color y se saltan las etiquetas.
  function eventGoal(e){ return e.metaId ? goalById(e.metaId) : null; }
  function fillColorForEvent(e){
    var f = eventGoal(e);
    if(f) return f.goal.color || f.sup.color;
    var sup = e.supermetaId ? superById(e.supermetaId) : null;
    if(sup) return sup.color;
    var cal = e.calendarId ? calById(e.calendarId) : null;
    if(cal) return cal.color;
    return "#6E7368";
  }
  function calRailForEvent(e){
    if(e.invisible || e.inverse) return null;   // §K5: invisibles; inversos: un solo color
    var calId = e.calendarId || null;
    if(!calId && e.metaId){ var sup = superOfGoal(e.metaId); calId = sup ? sup.calendarId : null; }
    if(!calId && e.supermetaId){ var s = superById(e.supermetaId); calId = s ? s.calendarId : null; }
    var cal = calId ? calById(calId) : null;
    return cal ? cal.color : null;
  }
  function superRailForEvent(e){
    if(e.invisible || e.inverse) return null;
    var sup = e.metaId ? superOfGoal(e.metaId) : (e.supermetaId ? superById(e.supermetaId) : null);
    return sup ? sup.color : null;
  }
  // rallitas verticales paralelas al lado izquierdo del evento, estilo Google Calendar (§K3)
  function railsHtml(e){
    var a = calRailForEvent(e), b = superRailForEvent(e);
    if(!a && !b) return "";
    return '<i class="rail rail-1" style="background:'+(a||b)+'"></i>' +
           (b ? '<i class="rail rail-2" style="background:'+b+'"></i>' : "");
  }

  var VIS_KEY = "productvt-calendario-capas-visibles-v1";
  function loadVis(){ try{ var raw = localStorage.getItem(VIS_KEY); return raw ? JSON.parse(raw) : {}; }catch(e){ return {}; } }
  function saveVis(){ try{ localStorage.setItem(VIS_KEY, JSON.stringify(calVis)); }catch(e){} }
  var calVis = loadVis();
  function isVisible(key){ return calVis[key] !== false; }
  // visibilidad por calendario (v3.1 §K2): el evento se esconde si su calendario está desmarcado
  function eventVisible(e){
    var calId = e.calendarId || null;
    if(!calId && e.metaId){ var s1 = superOfGoal(e.metaId); calId = s1 ? s1.calendarId : null; }
    if(!calId && e.supermetaId){ var s2 = superById(e.supermetaId); calId = s2 ? s2.calendarId : null; }
    if(!calId) return true;                     // sin calendario: agrupado por su supermeta
    return isVisible("cal:" + calId);
  }

  var EVENTS_KEY = "productvt-calendario-invisibles-v1";
  function loadUserEvents(){ try{ var raw = localStorage.getItem(EVENTS_KEY); return raw ? JSON.parse(raw) : []; }catch(e){ return []; } }
  function saveUserEvents(){ try{ localStorage.setItem(EVENTS_KEY, JSON.stringify(userEvents)); }catch(e){} }
  var userEvents = loadUserEvents();

  // ---- enmienda v3 §B3 — arrastre de eventos ----
  // El arrastre persiste por id (incluye los eventos demo deterministas, vía overrides).
  var OVERRIDES_KEY = "productvt-calendario-drag-overrides-v1";
  function loadOverrides(){ try{ return JSON.parse(localStorage.getItem(OVERRIDES_KEY)) || {}; }catch(e){ return {}; } }
  function saveOverrides(){ try{ localStorage.setItem(OVERRIDES_KEY, JSON.stringify(overrides)); }catch(e){} }
  var overrides = loadOverrides();
  var dragJustMoved = false; // evita que el clic posterior al arrastre abra el panel del día
  function startEventDrag(el, ev, col){
    ev.preventDefault();
    var startY = ev.clientY, startX = ev.clientX;
    var origTop = parseFloat(el.style.top) || 0;
    var moved = false;
    el.classList.add("dragging");
    function onMove(e2){
      var dy = e2.clientY - startY;
      if(Math.abs(dy) > 3 || Math.abs(e2.clientX - startX) > 3) moved = true;
      var newTop = Math.max(0, origTop + dy);
      newTop = Math.round(newTop / 11) * 11; // snap 15 min (44 px por hora)
      el.style.top = newTop + "px";
      el.dataset.newTop = String(newTop);
      document.querySelectorAll(".tl-day-col.drag-over").forEach(function(c){ c.classList.remove("drag-over"); });
      var over = document.elementFromPoint(e2.clientX, e2.clientY);
      var targetCol = over && over.closest ? over.closest(".tl-day-col") : null;
      if(targetCol) targetCol.classList.add("drag-over");
      el.dataset.newDate = targetCol ? targetCol.dataset.date : col.dataset.date;
    }
    function onUp(){
      document.removeEventListener("pointermove", onMove);
      document.removeEventListener("pointerup", onUp);
      el.classList.remove("dragging");
      document.querySelectorAll(".tl-day-col.drag-over").forEach(function(c){ c.classList.remove("drag-over"); });
      if(!moved) return;
      dragJustMoved = true;
      setTimeout(function(){ dragJustMoved = false; }, 350);
      var newTop = Number(el.dataset.newTop || 0);
      var newStart = Math.round(newTop / 44 * 60); // minutos desde las 07:00
      var startHour = 7, endHour = 23;
      newStart = Math.max(0, Math.min((endHour - startHour) * 60 - 15, newStart)) + startHour * 60;
      var id = el.dataset.id;
      var dateChanged = el.dataset.newDate && el.dataset.newDate !== col.dataset.date;
      if(dateChanged){
        // mover de día: si es un evento del usuario, se reubica; si es demo, se clona como evento del usuario
        var src = userEvents.filter(function(e){ return e.id === id; })[0];
        var startMin = overrides[id] !== undefined ? overrides[id] : (src ? src.startMin : null);
        var fromTime = startMin !== null ? minutesToHHMM(startMin) : "09:00";
        userEvents.push({
          id: "u" + Date.now(), date: el.dataset.newDate, title: el.textContent.replace(/ · \d\d:\d\d$/, ""),
          metaId: src ? src.metaId : null, capaId: src ? src.capaId : null,
          time: fromTime, startMin: startMin !== null ? startMin : 540
        });
        if(src){ userEvents = userEvents.filter(function(e){ return e.id !== id; }); saveUserEvents(); }
        else { overrides[id] = -1; saveOverrides(); } // -1 = ocultar el demo original
        render();
        return;
      }
      overrides[id] = newStart;
      saveOverrides();
      render();
    }
    document.addEventListener("pointermove", onMove);
    document.addEventListener("pointerup", onUp);
  }

  function pad(n){ return String(n).padStart(2,"0"); }
  function iso(y,m,d){ return y+"-"+pad(m+1)+"-"+pad(d); }
  function isoOf(d){ return iso(d.getFullYear(), d.getMonth(), d.getDate()); }
  function addDays(d,n){ var r=new Date(d); r.setDate(r.getDate()+n); return r; }
  function startOfWeek(d){ var day=(d.getDay()+6)%7; return addDays(d,-day); }
  function minutesToHHMM(totalMin){ var h=Math.floor(totalMin/60), m=totalMin%60; return pad(h)+":"+pad(m); }

  var today = new Date();

  // ---- Sesiones/eventos de ejemplo, deterministas por mes (año completo, capa = meta cuando comparte categoría) ----
  var STATUSES = ["completed","completed","completed","cancelled","expired"];
  function sessionsForMonth(year, month){
    var out = [];
    var daysInMonth = new Date(year, month+1, 0).getDate();
    for(var d=1; d<=daysInMonth; d++){
      var seed = (d*7+month) % 10;
      if(seed < 6){
        var cat = CATEGORIES[(d+seed) % CATEGORIES.length];
        var status = STATUSES[(d+seed) % STATUSES.length];
        var minutes = status === "completed" ? [25,50,75,100][d%4] : [10,15,20][d%3];
        var startH = 8 + (d % 10);
        // liga al bloque una meta de esa categoría si existe — prefiere una meta hoja (más específica)
        // sobre la propia supermeta, simulando "el usuario eligió esta meta al iniciar el bloque"
        var candidates = METAS.filter(function(m){ return m.categoryId === cat.id; });
        var linkedMeta = candidates.find(function(m){ return m.parentGoalId; }) || candidates[0];
        out.push({
          id: "s"+year+"-"+month+"-"+d+"-1", date: iso(year,month,d), categoryId: cat.id, status: status, minutes: minutes,
          startMin: startH*60 + (d%2===0?0:30), metaId: linkedMeta ? linkedMeta.id : null, title: linkedMeta ? linkedMeta.name : cat.name
        });
      }
      if(seed === 7){
        var cat2 = CATEGORIES[(d+2) % CATEGORIES.length];
        var candidates2 = METAS.filter(function(m){ return m.categoryId === cat2.id; });
        var linkedMeta2 = candidates2.find(function(m){ return m.parentGoalId; }) || candidates2[0];
        out.push({
          id: "s"+year+"-"+month+"-"+d+"-2", date: iso(year,month,d), categoryId: cat2.id, status: "completed", minutes: 25,
          startMin: (15+(d%4))*60, metaId: linkedMeta2 ? linkedMeta2.id : null, title: linkedMeta2 ? linkedMeta2.name : cat2.name
        });
      }
    }
    return out;
  }
  var demoCache = {};
  function demoForMonth(year, month){
    var key = year+"-"+month;
    if(!demoCache[key]) demoCache[key] = sessionsForMonth(year, month);
    return demoCache[key];
  }
  function eventsForRange(fromDate, toDate){
    var out = [];
    var cursor = new Date(fromDate.getFullYear(), fromDate.getMonth(), 1);
    var endMonth = new Date(toDate.getFullYear(), toDate.getMonth(), 1);
    while(cursor <= endMonth){
      out = out.concat(demoForMonth(cursor.getFullYear(), cursor.getMonth()));
      cursor = new Date(cursor.getFullYear(), cursor.getMonth()+1, 1);
    }
    var fromIso = isoOf(fromDate), toIso = isoOf(toDate);
    var sessions = out.filter(function(e){ return e.date >= fromIso && e.date <= toIso; });
    var custom = userEvents.filter(function(e){ return e.date >= fromIso && e.date <= toIso; });
    return sessions.concat(custom).filter(function(e){
      if(overrides[e.id] === -1) return false; // v3 §B3: evento demo reubicado como copia de usuario
      if(e.metaId) return isVisible(layerIdForMeta(e.metaId));
      if(e.capaId) return isVisible("capa:"+e.capaId);
      return true;
    });
  }
  function colorForEvent(e){
    if(e.metaId){ var c = fillColorForMeta(e.metaId); if(c) return c; }
    if(e.capaId){ var cp = capaById(e.capaId); if(cp) return cp.color; }
    return catById(e.categoryId).color;
  }
  function stripeForEvent(e){
    return e.metaId ? stripeColorForMeta(e.metaId) : null;
  }
  function capaAccentForEvent(e){
    if(e.metaId) return capaColorForMeta(e.metaId);
    return null; // un evento tageado directo a una capa ya usa esa capa como su color principal
  }
  function labelForEvent(e){ return e.title || (e.categoryId ? catById(e.categoryId).name : "Evento"); }

  // ---- estado de la vista ----
  var DEFAULT_VIEW_KEY = "productvt-calendario-vista-default-v1";
  function loadDefaultView(){ try{ return localStorage.getItem(DEFAULT_VIEW_KEY) || "month"; }catch(e){ return "month"; } }
  var view = loadDefaultView();
  var cursorDate = new Date();
  var searchQuery = "";
  function matchesSearch(e){
    if(!searchQuery) return false;
    return labelForEvent(e).toLowerCase().indexOf(searchQuery) !== -1;
  }
  function dayHasMatch(dateStr){
    if(!searchQuery) return false;
    return eventsForRange(new Date(dateStr+"T00:00:00"), new Date(dateStr+"T00:00:00")).some(matchesSearch);
  }

  var viewRoot = document.getElementById("viewRoot");
  var periodLabel = document.getElementById("periodLabel");
  var layersPanel = document.getElementById("layersPanel");
  var backdrop = document.getElementById("backdrop");
  var MONTHS = ["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];
  var WEEKDAYS = ["L","M","M","J","V","S","D"];

  function setView(v){
    view = v;
    document.querySelectorAll("#viewSwitch button").forEach(function(b){ b.setAttribute("aria-pressed", b.dataset.view===v); });
    document.getElementById("pinDefaultBtn").classList.toggle("is-default", loadDefaultView() === v);
    render();
  }

  function renderLayers(){
    var list = document.getElementById("layerList");
    list.innerHTML = "";
    var sinCapa = supermetas().filter(function(m){ return !m.capaId; });

    CAPAS.forEach(function(cp){
      var key = "capa:"+cp.id;
      var head = document.createElement("div");
      head.className = "layer-row layer-group-header";
      head.innerHTML = '<input type="checkbox" '+(isVisible(key)?"checked":"")+'><span class="swatch" style="background:'+cp.color+'"></span>' +
        '<span class="lname">'+cp.name+'</span><button class="ldel" title="Borrar capa">×</button>';
      head.querySelector('input').addEventListener("change", function(e){ layerVis[key] = e.target.checked; saveVis(); render(); });
      head.querySelector('.ldel').addEventListener("click", function(){
        if(!confirm('¿Borrar la capa "'+cp.name+'"? Las supermetas asignadas quedan sin capa.')) return;
        METAS.forEach(function(m){ if(m.capaId === cp.id) delete m.capaId; });
        saveMetas();
        CAPAS = CAPAS.filter(function(c){ return c.id !== cp.id; });
        saveCapas(); renderLayers(); render();
      });
      list.appendChild(head);

      supermetas().filter(function(m){ return m.capaId === cp.id; }).forEach(function(m){
        var sub = document.createElement("div");
        sub.className = "layer-row layer-sub-row";
        sub.innerHTML = '<span class="swatch" style="background:'+(m.color||catById(m.categoryId).color)+'"></span>' +
          '<span class="lname">'+m.name+'</span><button class="ldel" title="Quitar de esta capa">quitar</button>';
        sub.querySelector('.ldel').addEventListener("click", function(){
          delete m.capaId; saveMetas(); renderLayers(); render();
        });
        list.appendChild(sub);
      });
    });

    if(sinCapa.length){
      var hr = document.createElement("p");
      hr.className = "note"; hr.style.margin = "6px 0 0"; hr.textContent = "Sin capa";
      list.appendChild(hr);
      sinCapa.forEach(function(m){
        var key = "meta:"+m.id;
        var row = document.createElement("div");
        row.className = "layer-row";
        row.innerHTML = '<input type="checkbox" '+(isVisible(key)?"checked":"")+'><span class="swatch" style="background:'+(m.color||catById(m.categoryId).color)+'"></span>' +
          '<span class="lname">'+m.name+'</span>' +
          '<select class="assign-select">' + '<option value="">a capa…</option>' + CAPAS.map(function(c){ return '<option value="'+c.id+'">'+c.name+'</option>'; }).join("") + '</select>';
        row.querySelector('input').addEventListener("change", function(e){ layerVis[key] = e.target.checked; saveVis(); render(); });
        row.querySelector('.assign-select').addEventListener("change", function(e){
          if(!e.target.value) return;
          m.capaId = e.target.value; saveMetas(); renderLayers(); render();
        });
        list.appendChild(row);
      });
    }
  }

  function render(){
    if(view === "year") renderYear();
    else if(view === "month") renderMonth();
    else if(view === "week") renderTimeline(7);
    else if(view === "3day") renderTimeline(3);
    else renderTimeline(1);
  }

  function renderYear(){
    var y = cursorDate.getFullYear();
    periodLabel.textContent = y;
    var html = '<div class="year-grid">';
    for(var m=0; m<12; m++){
      var evts = eventsForRange(new Date(y,m,1), new Date(y,m+1,0));
      var byDate = {}; evts.forEach(function(e){ byDate[e.date]=true; });
      var first = new Date(y,m,1); var offset=(first.getDay()+6)%7;
      var days = new Date(y,m+1,0).getDate();
      html += '<div class="mini-month" data-month="'+m+'"><h3>'+MONTHS[m]+'</h3><div class="mini-grid">';
      for(var i=0;i<offset;i++) html += '<span class="mini-day other"></span>';
      for(var d=1; d<=days; d++){
        var ds = iso(y,m,d);
        var isToday = ds === isoOf(today);
        html += '<span class="mini-day'+(byDate[ds]?" has-events":"")+(isToday?" today":"")+(dayHasMatch(ds)?" search-hit":"")+'" data-date="'+ds+'">'+d+'</span>';
      }
      html += '</div></div>';
    }
    html += '</div>';
    viewRoot.innerHTML = html;
    document.querySelectorAll(".mini-month").forEach(function(el){
      el.addEventListener("click", function(ev){
        var dateEl = ev.target.closest(".mini-day[data-date]");
        cursorDate = new Date(y, Number(el.dataset.month), dateEl ? Number(dateEl.dataset.date.slice(-2)) : 1);
        setView(dateEl ? "day" : "month");
      });
    });
  }

  function renderMonth(){
    var y = cursorDate.getFullYear(), m = cursorDate.getMonth();
    periodLabel.textContent = MONTHS[m] + " " + y;
    var first = new Date(y,m,1); var offset=(first.getDay()+6)%7;
    var daysInMonth = new Date(y,m+1,0).getDate();
    var daysInPrev = new Date(y,m,0).getDate();
    var cells = [];
    for(var i=offset; i>0; i--) cells.push({ day: daysInPrev-i+1, other: true, y: m===0?y-1:y, m: m===0?11:m-1 });
    for(var d=1; d<=daysInMonth; d++) cells.push({ day: d, other: false, y:y, m:m });
    while(cells.length % 7 !== 0){ var idx = cells.length-(offset+daysInMonth); cells.push({ day: idx+1, other: true, y: m===11?y+1:y, m: m===11?0:m+1 }); }
    var html = '<div class="weekday-row">'+WEEKDAYS.map(function(w){return '<span>'+w+'</span>';}).join("")+'</div><div class="month-grid">';
    cells.forEach(function(c){
      var ds = iso(c.y,c.m,c.day);
      var isToday = ds === isoOf(today);
      var evts = eventsForRange(new Date(ds), new Date(ds));
      var shown = evts.slice(0,3);
      html += '<div class="month-day'+(c.other?" other-month":"")+(isToday?" today":"")+(evts.length?" has-events":"")+(dayHasMatch(ds)?" search-hit":"")+'" data-date="'+ds+'">' +
        '<span class="num">'+c.day+'</span>' +
        shown.map(function(e){
          var stripe = stripeForEvent(e);
          var st = "background:"+colorForEvent(e) + (stripe ? ";border-left:3px solid "+stripe+";padding-left:3px" : "");
          var capaColor = capaAccentForEvent(e);
          var accent = capaColor ? ' <i style="display:inline-block;width:5px;height:5px;border-radius:50%;background:'+capaColor+';vertical-align:middle"></i>' : '';
          return '<span class="evt" style="'+st+'">'+labelForEvent(e)+accent+'</span>';
        }).join("") +
        (evts.length>3 ? '<span class="more">+'+(evts.length-3)+' más</span>' : "") +
        '</div>';
    });
    html += '</div>';
    viewRoot.innerHTML = html;
    document.querySelectorAll(".month-day").forEach(function(el){
      el.addEventListener("click", function(){ openDaySheet(el.dataset.date); });
    });
  }

  function renderTimeline(numDays){
    var start = numDays === 7 ? startOfWeek(cursorDate) : (numDays===3 ? addDays(cursorDate,-1) : cursorDate);
    var days = []; for(var i=0;i<numDays;i++) days.push(addDays(start,i));
    periodLabel.textContent = numDays===1
      ? days[0].toLocaleDateString("es",{day:"numeric",month:"long",year:"numeric"})
      : days[0].getDate()+" "+MONTHS[days[0].getMonth()].slice(0,3)+" – "+days[numDays-1].getDate()+" "+MONTHS[days[numDays-1].getMonth()].slice(0,3);

    var startHour = 7, endHour = 23;
    var hourLabels = "";
    for(var h=startHour; h<=endHour; h++) hourLabels += '<div class="tl-hour-label">'+pad(h)+":00</div>";

    var colsHtml = "";
    days.forEach(function(d){
      var ds = isoOf(d);
      var evts = eventsForRange(d,d).filter(function(e){ return e.startMin !== undefined || e.time; });
      var isToday = ds === isoOf(today);
      var slots = ""; for(var h=startHour; h<=endHour; h++) slots += '<div class="tl-slot" data-hour="'+h+'"></div>';
      var eventsHtml = evts.map(function(e){
        var startMin = overrides[e.id] !== undefined ? overrides[e.id] : (e.startMin !== undefined ? e.startMin : (e.time ? Number(e.time.split(":")[0])*60+Number(e.time.split(":")[1]) : startHour*60));
        var dur = e.minutes || 25;
        var top = (startMin - startHour*60) / 60 * 44;
        var height = Math.max(20, dur/60*44);
        var stripe2 = stripeForEvent(e);
        var evStyle = "top:"+top+"px;height:"+height+"px;background:"+colorForEvent(e) + (stripe2 ? ";border-left:4px solid "+stripe2 : "");
        var capaColor2 = capaAccentForEvent(e);
        var accent2 = capaColor2 ? '<span style="position:absolute;top:2px;right:2px;width:6px;height:6px;border-radius:50%;background:'+capaColor2+'"></span>' : '';
        return '<div class="tl-event'+(matchesSearch(e)?" search-hit":"")+'" data-id="'+e.id+'" style="'+evStyle+'" title="'+labelForEvent(e)+'">'+labelForEvent(e)+' · '+minutesToHHMM(startMin)+accent2+'</div>';
      }).join("");
      var nowLine = "";
      if(isToday){
        var nowMin = today.getHours()*60 + today.getMinutes();
        if(nowMin >= startHour*60 && nowMin <= endHour*60){
          var nowTop = (nowMin - startHour*60) / 60 * 44;
          nowLine = '<div class="tl-now" id="tlNow" style="top:'+nowTop+'px"></div>';
        }
      }
      colsHtml += '<div class="tl-day-col" data-date="'+ds+'">' +
        '<div class="tl-day-head'+(isToday?" today":"")+'">'+WEEKDAYS[(d.getDay()+6)%7]+' '+d.getDate()+(isToday?' <span class="hoy">HOY</span>':'')+'</div>' +
        '<div style="position:relative">'+slots+eventsHtml+nowLine+'</div></div>';
    });

    viewRoot.innerHTML = '<div class="timeline"><div class="tl-hours"><div class="tl-hour-label" style="height:26px"></div>'+hourLabels+'</div>' +
      '<div class="tl-days" style="grid-template-columns:repeat('+numDays+',1fr)">' + colsHtml + '</div></div>';

    // v3 §B3: presionar y arrastrar mueve el evento (hora con snap de 15 min, incluso entre días)
    viewRoot.querySelectorAll(".tl-event").forEach(function(el){
      el.addEventListener("pointerdown", function(ev){
        var col = el.closest(".tl-day-col");
        startEventDrag(el, ev, col);
      });
    });
    viewRoot.querySelectorAll(".tl-day-col").forEach(function(col){
      col.addEventListener("click", function(ev){
        if(dragJustMoved) return;
        if(ev.target.closest(".tl-event")) return;
        openDaySheet(col.dataset.date);
      });
    });
  }

  function openDaySheet(dateStr){
    var d = new Date(dateStr+"T00:00:00");
    var evts = eventsForRange(d,d);
    var itemsHtml = evts.length ? evts.map(function(e){
      var stripe = stripeForEvent(e);
      var shownStart = overrides[e.id] !== undefined ? overrides[e.id] : e.startMin;
      var dotStyle = "background:"+colorForEvent(e) + (stripe ? ";box-shadow:0 0 0 2px "+stripe : "");
      return '<div class="item"><span class="idot" style="'+dotStyle+'"></span>' +
        '<span class="itxt">'+labelForEvent(e)+(e.minutes?" · "+e.minutes+" min":"")+'</span>' +
        '<span class="itime">'+(shownStart!==undefined?minutesToHHMM(shownStart):(e.time||""))+'</span></div>';
    }).join("") : '<p class="empty">Nada este día.</p>';
    var metaOptions = METAS.map(function(m){ return '<option value="meta:'+m.id+'">'+(m.parentGoalId?"— ":"")+m.name+'</option>'; }).join("");
    var capaOptions = CAPAS.map(function(l){ return '<option value="capa:'+l.id+'">'+l.name+' (capa)</option>'; }).join("");
    var wrap = document.createElement("div");
    wrap.className = "overlay";
    wrap.innerHTML = '<div class="sheet">' +
      '<button class="close" id="closeDay">cerrar</button>' +
      '<h2>'+d.toLocaleDateString("es",{weekday:"long",day:"numeric",month:"long"})+'</h2>' +
      itemsHtml +
      '<div class="field"><label>Nuevo evento</label><input type="text" id="evTitle" placeholder="Título"></div>' +
      '<div class="row2"><div class="field"><label>Meta o capa</label><select id="evMeta"><option value="">Sin meta/capa</option>' +
      (metaOptions ? '<optgroup label="Metas">'+metaOptions+'</optgroup>' : '') +
      (capaOptions ? '<optgroup label="Capas">'+capaOptions+'</optgroup>' : '') + '</select></div>' +
      '<div class="field"><label>Hora</label><input type="time" id="evTime" value="09:00"></div></div>' +
      '<button class="btn" id="addEvBtn">+ Agregar</button>' +
      '</div>';
    document.getElementById("sheetRoot").appendChild(wrap);
    wrap.addEventListener("pointerdown", function(ev){ if(ev.target === wrap) wrap.remove(); }); // v3 §B2: presionar fuera cierra
    wrap.querySelector("#closeDay").addEventListener("click", function(){ wrap.remove(); });
    wrap.querySelector("#addEvBtn").addEventListener("click", function(){
      var title = wrap.querySelector("#evTitle").value.trim();
      if(!title) return;
      var time = wrap.querySelector("#evTime").value;
      var sel = wrap.querySelector("#evMeta").value;
      userEvents.push({
        id: "u"+Date.now(), date: dateStr, title: title,
        metaId: sel.indexOf("meta:")===0 ? sel.slice(5) : null,
        capaId: sel.indexOf("capa:")===0 ? sel.slice(5) : null,
        time: time, startMin: Number(time.split(":")[0])*60+Number(time.split(":")[1])
      });
      saveUserEvents(); wrap.remove(); render(); openDaySheet(dateStr);
    });
  }

  // ---- navegación ----
  function step(dir){
    if(view==="year") cursorDate = new Date(cursorDate.getFullYear()+dir, cursorDate.getMonth(), 1);
    else if(view==="month") cursorDate = new Date(cursorDate.getFullYear(), cursorDate.getMonth()+dir, 1);
    else if(view==="week") cursorDate = addDays(cursorDate, dir*7);
    else if(view==="3day") cursorDate = addDays(cursorDate, dir*3);
    else cursorDate = addDays(cursorDate, dir);
    render();
  }
  document.getElementById("prevBtn").addEventListener("click", function(){ step(-1); });
  document.getElementById("nextBtn").addEventListener("click", function(){ step(1); });
  document.getElementById("todayBtn").addEventListener("click", function(){ cursorDate = new Date(); render(); });
  document.querySelectorAll("#viewSwitch button").forEach(function(b){ b.addEventListener("click", function(){ setView(b.dataset.view); }); });

  document.getElementById("pinDefaultBtn").addEventListener("click", function(){
    try{ localStorage.setItem(DEFAULT_VIEW_KEY, view); }catch(e){}
    document.getElementById("pinDefaultBtn").classList.add("is-default");
  });

  document.getElementById("addLayerBtn").addEventListener("click", function(){
    var name = document.getElementById("newLayerName").value.trim();
    if(!name) return;
    var color = document.getElementById("newLayerColor").value;
    CAPAS.push({ id: "cap"+Date.now(), name: name, color: color });
    saveCapas(); document.getElementById("newLayerName").value = "";
    renderLayers(); render();
  });

  function openFabPopup(){
    var wrap = document.createElement("div");
    wrap.className = "overlay";
    wrap.innerHTML = '<div class="sheet">' +
      '<button class="close" id="closeFab">cerrar</button>' +
      '<h2>¿Qué querés hacer?</h2>' +
      '<div class="choice-cards">' +
        '<button class="choice-card" id="goEventHere" type="button"><span class="ic">▦</span><span><strong>Agregar evento a este día</strong><span>'+cursorDate.toLocaleDateString("es",{day:"numeric",month:"long"})+'</span></span></button>' +
        '<button class="choice-card" id="goCreateFromCal" type="button"><span class="ic">✺</span><span><strong>Crear meta / iniciar bloque</strong><span>Abre el mismo panel de Inicio</span></span></button>' +
      '</div></div>';
    document.getElementById("sheetRoot").appendChild(wrap);
    wrap.addEventListener("pointerdown", function(ev){ if(ev.target === wrap) wrap.remove(); }); // v3 §B2: presionar fuera cierra
    wrap.querySelector("#closeFab").addEventListener("click", function(){ wrap.remove(); });
    wrap.querySelector("#goEventHere").addEventListener("click", function(){ wrap.remove(); openDaySheet(isoOf(cursorDate)); });
    wrap.querySelector("#goCreateFromCal").addEventListener("click", function(){ window.location.href = NAV_URLS.inicio + "?action=create"; });
  }
  document.getElementById("fabAdd").addEventListener("click", openFabPopup);
  document.getElementById("searchInput").addEventListener("input", function(e){
    searchQuery = e.target.value.trim().toLowerCase();
    render();
  });

  function openLayersPanel(){ layersPanel.classList.add("open"); backdrop.classList.add("show"); }
  function closeLayersPanel(){ layersPanel.classList.remove("open"); backdrop.classList.remove("show"); }
  document.getElementById("openLayers").addEventListener("click", openLayersPanel);
  document.getElementById("closeLayers").addEventListener("click", closeLayersPanel);
  backdrop.addEventListener("click", closeLayersPanel);

  document.querySelectorAll("#viewSwitch button").forEach(function(b){ b.setAttribute("aria-pressed", b.dataset.view===view); });
  document.getElementById("pinDefaultBtn").classList.toggle("is-default", loadDefaultView() === view);
  renderLayers();
  render();

  setInterval(function(){
    var line = document.getElementById("tlNow");
    if(!line) return;
    var startHour = 7;
    var nowMin = new Date().getHours()*60 + new Date().getMinutes();
    line.style.top = ((nowMin - startHour*60) / 60 * 44) + "px";
  }, 30000);
})();
</script>
</file>

<file path="Respaldo-Productvt-Visual/configuracion.html">
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Configuración</title>
<!-- Mockup de la pestaña Configuración (skin "Papel"). Enmienda v3.1 (decisiones-tomadas.md §J–§K):
     jerarquía editable supermetas/metas con lápiz que reabre el panel de creación (mover/color/nombre),
     cuestionario obligatorio al crear supermeta (calendario → color, default: el del calendario),
     mínimo una meta por supermeta (altiro abre su creación), plazos (máx. 1 año), confirmación al
     eliminar (eliminar supermeta mata sus metas), gestión de calendarios (crear/eliminar con
     confirmación). LAS CATEGORÍAS NO EXISTEN (§K1). Claves localStorage compartidas con cronómetro
     y galaxia (productvt-supermetas-v1, productvt-capas-v1). -->
<style>
  :root{
    --paper: #EFEDE5; --paper-raised: #FAF9F3; --ink: #20241E; --muted: #6E7368;
    --accent: #3A6B54; --accent-ink: #F3F7F1; --accent-soft: #DCE6DC;
    --rule: #D5D1C1; --rule-strong: #B9B4A0; --danger: #9C4A3A; --danger-soft: #E9D6CF;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper: #14170F; --paper-raised: #1B1F16; --ink: #E9E7DC; --muted: #949A88;
      --accent: #7BB596; --accent-ink: #10241A; --accent-soft: #223429;
      --rule: #2B3225; --rule-strong: #3C4433; --danger: #D08871; --danger-soft: #33221D;
    }
  }
  :root[data-theme="dark"]{
    --paper: #14170F; --paper-raised: #1B1F16; --ink: #E9E7DC; --muted: #949A88;
    --accent: #7BB596; --accent-ink: #10241A; --accent-soft: #223429;
    --rule: #2B3225; --rule-strong: #3C4433; --danger: #D08871; --danger-soft: #33221D;
  }
  *{ box-sizing: border-box; }
  body{
    margin: 0; background: var(--paper); color: var(--ink);
    font-family: "Archivo", ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  button{ font: inherit; cursor: pointer; }
  input, select{ font: inherit; }
  .shell{ max-width: 420px; margin: 0 auto; min-height: 100vh; padding: 0 0 28px; }
  .topbar{ display: flex; align-items: baseline; justify-content: space-between; padding: 18px 20px 6px; }
  .topbar h1{ margin: 0; font-family: "Fraunces", Georgia, serif; font-weight: 500; font-size: 22px; }
  .topbar .sub{ font-size: 12px; color: var(--muted); }
  .section{ margin: 14px 16px 0; border: 1px solid var(--rule-strong); border-radius: 12px; background: var(--paper-raised); overflow: hidden; }
  .section > h2{
    margin: 0; padding: 12px 14px 10px; font-family: "Fraunces", Georgia, serif;
    font-size: 14.5px; font-weight: 500; border-bottom: 1px solid var(--rule);
    display: flex; justify-content: space-between; align-items: center;
  }
  .section > h2 .hint{ font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 10.5px; color: var(--muted); font-weight: 400; }
  .section .body{ padding: 12px 14px; display: flex; flex-direction: column; gap: 10px; }
  .row{ display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .glabel{ font-size: 13.5px; }
  .glabel small{ display: block; color: var(--muted); font-size: 11.5px; margin-top: 2px; }
  .mini-btn{
    border: 1px solid var(--rule-strong); background: var(--paper); color: var(--ink);
    border-radius: 8px; padding: 5px 10px; font-size: 12px;
  }
  .mini-btn.danger{ color: var(--danger); border-color: var(--danger); }
  .mini-btn.xs{ padding: 3px 8px; font-size: 11px; }
  .form{ display: flex; flex-direction: column; gap: 9px; border: 1px dashed var(--rule-strong); border-radius: 10px; padding: 11px; background: var(--paper); }
  .form input, .form select, .form textarea{
    background: var(--paper-raised); color: var(--ink); border: 1px solid var(--rule-strong);
    border-radius: 8px; padding: 8px 10px; font-size: 13.5px; width: 100%;
  }
  .form textarea{ font-family: inherit; resize: vertical; min-height: 52px; }
  .form label{ font-size: 11.5px; color: var(--muted); display: block; margin-bottom: 4px; }
  .palette{ display: flex; gap: 6px; flex-wrap: wrap; }
  .palette button{ width: 22px; height: 22px; border-radius: 50%; border: 2px solid transparent; padding: 0; }
  .palette button[aria-pressed="true"]{ border-color: var(--ink); }
  .toggle{
    width: 44px; height: 26px; border-radius: 20px; border: 1px solid var(--rule-strong);
    background: var(--paper); position: relative; padding: 0; flex: none;
  }
  .toggle .knob{
    position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; border-radius: 50%;
    background: var(--muted); transition: left .18s ease, background .18s ease;
  }
  .toggle[aria-pressed="true"]{ background: var(--accent-soft); border-color: var(--accent); }
  .toggle[aria-pressed="true"] .knob{ left: 21px; background: var(--accent); }
  .phrase{
    font-size: 13.5px; line-height: 1.5; padding: 10px 12px;
    border-left: 3px solid var(--danger); background: var(--danger-soft); border-radius: 0 8px 8px 0;
  }
  .phrase input{ width: 100%; background: var(--paper-raised); color: var(--ink); border: 1px solid var(--rule-strong); border-radius: 8px; padding: 8px 10px; font-size: 13px; }
  .note{ margin: 14px 16px 0; font-size: 11.5px; color: var(--muted); line-height: 1.5; }
  .save-toast{
    position: fixed; left: 50%; bottom: 18px; transform: translateX(-50%) translateY(80px);
    background: var(--accent); color: var(--accent-ink); font-size: 12.5px;
    padding: 9px 16px; border-radius: 20px; transition: transform .25s ease; pointer-events: none;
  }
  .save-toast.show{ transform: translateX(-50%) translateY(0); }
  .hidden{ display: none !important; }
  /* ---- Calendarios (v3.1 §J6, §K2) ---- */
  .cal-row{ display: flex; align-items: center; gap: 8px; padding: 6px 0; border-bottom: 1px dashed var(--rule); }
  .cal-row:last-child{ border-bottom: none; }
  .cal-row .sw{ width: 12px; height: 12px; border-radius: 50%; flex: none; }
  .cal-row .name{ flex: 1; font-size: 13px; }
  .cal-row .linked{ font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 10px; color: var(--muted); }

  /* ---- Jerarquía (v3.1 §J1–J5) ---- */
  .tree{ display: flex; flex-direction: column; gap: 8px; }
  .sg-node{ border: 1px solid var(--rule); border-radius: 10px; background: var(--paper); padding: 9px 10px; }
  .sg-row{ display: flex; align-items: center; gap: 8px; }
  .sg-row .planet{ width: 16px; height: 16px; border-radius: 50%; flex: none; box-shadow: inset -3px -3px 0 rgba(0,0,0,.18); }
  .sg-row .name{ font-size: 13.5px; font-weight: 600; flex: 1; }
  .sg-row .meta-tag{
    font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 9.5px; color: var(--muted);
    border: 1px solid var(--rule-strong); border-radius: 10px; padding: 1px 7px; flex: none;
  }
  .sg-row .anti-tag{
    font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 9.5px; color: var(--danger);
    border: 1px solid var(--danger); border-radius: 10px; padding: 1px 7px; flex: none;
  }
  .goal-row{ display: flex; align-items: center; gap: 7px; padding: 6px 0 0 22px; }
  .goal-row .moon{ width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .goal-row .name{ font-size: 12.5px; flex: 1; }
  .goal-row .pct{ font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 10px; color: var(--accent); flex: none; }
  .goal-row .dl{ font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 9.5px; color: var(--muted); flex: none; }
  .goal-row input{ font-size: 12.5px; background: var(--paper-raised); color: var(--ink); border: 1px solid var(--rule-strong); border-radius: 6px; padding: 3px 7px; width: 120px; }
  .add-goal-row{ display: flex; gap: 6px; padding: 7px 0 0 22px; }
  .anti-hint{ font-size: 11px; color: var(--muted); line-height: 1.45; margin-top: 6px; }
  .tools{ display: flex; gap: 6px; align-items: center; }
  /* ---- Botones de icono (lápiz / eliminar) · v3.1 §J4–J5 ---- */
  .icon-btn{
    border: 1px solid var(--rule-strong); background: var(--paper); color: var(--ink);
    border-radius: 6px; width: 26px; height: 24px; font-size: 11.5px; line-height: 1;
    padding: 0; display: inline-flex; align-items: center; justify-content: center; flex: none;
  }
  .icon-btn.danger{ color: var(--danger); border-color: var(--danger); }
  .sg-row .tools, .goal-row .tools{ display: flex; gap: 4px; flex: none; }
  .inline-hint{ font-size: 11px; color: var(--muted); line-height: 1.45; }
  /* ---- Confirmación obligatoria al eliminar · v3.1 §J5/§K4 ---- */
  .confirm{
    position: fixed; inset: 0; background: rgba(20,23,15,.45);
    display: none; align-items: center; justify-content: center; padding: 22px; z-index: 40;
  }
  .confirm.open{ display: flex; }
  .confirm .box{
    background: var(--paper-raised); border: 1px solid var(--rule-strong);
    border-radius: 12px; padding: 16px; max-width: 320px; width: 100%;
  }
  .confirm p{ margin: 0 0 12px; font-size: 13px; line-height: 1.5; }
  .confirm .row{ display: flex; justify-content: flex-end; gap: 8px; }
  .mini-btn.danger-solid{ background: var(--danger); color: #F7EFEC; border-color: var(--danger); }
</style>
</head>
<body>
<div class="shell">
  <div class="topbar">
    <h1>Configuración</h1>
    <span class="sub">cambios guardados al instante</span>
  </div>

  <section class="section">
    <h2>Calendarios <span class="hint">capas del calendario · v3.1 §J6</span></h2>
    <div class="body">
      <div id="calList"></div>
      <div class="form hidden" id="newCalForm">
        <div><label>Nombre del calendario</label><input type="text" id="calName" maxlength="24" placeholder="p. ej. Universidad"></div>
        <div><label>Color</label><div class="palette" id="calPalette"></div></div>
        <div class="row">
          <button class="mini-btn" id="calCancel" type="button">Cancelar</button>
          <button class="mini-btn" id="calSave" type="button">Crear</button>
        </div>
      </div>
      <button class="mini-btn" id="newCalBtn" type="button" style="align-self:flex-start">+ Nuevo calendario</button>
    </div>
  </section>

  <section class="section">
    <h2>Jerarquía <span class="hint">supermetas → metas · v3.1 §J</span></h2>
    <div class="body">
      <div class="tree" id="hierarchyTree"></div>
      <button class="mini-btn" id="newSuperBtn" type="button" style="align-self:flex-start">+ Nueva supermeta</button>

      <div class="form hidden" id="superForm">
        <div><label>Nombre de la supermeta</label><input type="text" id="sfName" maxlength="28" placeholder="p. ej. Título"></div>
        <div>
          <label>¿Pertenece a un calendario existente? (v3.1 §J1)</label>
          <select id="sfCalendar"></select>
        </div>
        <div>
          <label>Color (default: el del calendario elegido)</label>
          <div class="palette" id="sfPalette"></div>
        </div>
        <div>
          <label>Plazo de cumplimiento (v3.1 §I6 · máx. 1 año)</label>
          <input type="datetime-local" id="sfDeadline">
        </div>
        <div class="row">
          <div class="glabel">Es antimeta<small>sin puntaje; solo eventos atemporales (v3 §A7)</small></div>
          <button class="toggle" id="sfAnti" aria-pressed="false" type="button"><span class="knob"></span></button>
        </div>
        <div class="row">
          <button class="mini-btn" id="sfCancel" type="button">Cancelar</button>
          <button class="mini-btn" id="sfSave" type="button">Crear</button>
        </div>
      </div>

      <div class="form hidden" id="goalForm">
        <div>
          <label>Supermeta a la que pertenece (v3.1 §J2)</label>
          <select id="gfSuper"></select>
        </div>
        <div><label>Nombre de la meta</label><input type="text" id="gfName" maxlength="40" placeholder="p. ej. Ramo 1"></div>
        <div>
          <label>Color (etiqueta de supermeta + color del bloque en el calendario, v3.1 §K3)</label>
          <div class="palette" id="gfPalette"></div>
        </div>
        <div>
          <label>Plazo de cumplimiento (v3.1 §I6 · máx. 1 año)</label>
          <input type="datetime-local" id="gfDeadline">
        </div>
        <div>
          <label>Tareas iniciales (una por línea — base del % de cumplimiento, v3.1 §I7)</label>
          <textarea id="gfTasks" placeholder="Leer capítulo 1&#10;Ejercicios 1–10"></textarea>
        </div>
        <div class="row">
          <button class="mini-btn" id="gfCancel" type="button">Cancelar</button>
          <button class="mini-btn" id="gfSave" type="button">Crear</button>
        </div>
      </div>

      <p class="anti-hint">Crear una supermeta obliga a asociarle como mínimo una meta: al crearla, altiro se abre el formulario de meta dentro de ella (v3.1 §J3). Eliminar una supermeta <strong>mata todas sus metas</strong> — siempre con confirmación (v3.1 §J5). El lápiz reabre el panel de creación para mover, recolorear o renombrar (v3.1 §J4).</p>
    </div>
  </section>

  <section class="section">
    <h2>Sonidos</h2>
    <div class="body">
      <div class="row">
        <div class="glabel">Campana al terminar bloque<small>suena cuando el bloque de estudio llega a cero</small></div>
        <button class="toggle" id="sndBell" aria-pressed="true" type="button"><span class="knob"></span></button>
      </div>
      <div class="row">
        <div class="glabel">Alarma de «toca estudiar»<small>avisa cuando el descanso terminó</small></div>
        <button class="toggle" id="sndAlarm" aria-pressed="true" type="button"><span class="knob"></span></button>
      </div>
      <div class="row">
        <div class="glabel">Tic-tac en pantalla<small>feedback visual del conteo (sin audio)</small></div>
        <button class="toggle" id="sndTick" aria-pressed="false" type="button"><span class="knob"></span></button>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>Frase de cancelación</h2>
    <div class="body">
      <div class="phrase" id="phraseView">
        <span id="phraseText"></span>
        <div class="row" style="margin-top:8px">
          <button class="mini-btn" id="phraseEdit" type="button">Editar</button>
        </div>
      </div>
      <div class="phrase hidden" id="phraseEditBox">
        <input type="text" id="phraseInput" maxlength="120">
        <div class="row" style="margin-top:8px">
          <button class="mini-btn" id="phraseCancel" type="button">Cancelar</button>
          <button class="mini-btn" id="phraseSave" type="button">Guardar</button>
        </div>
      </div>
      <span style="font-size:11.5px;color:var(--muted)">Se muestra en el panel de doble confirmación antes de cancelar la sesión.</span>
    </div>
  </section>

  <p class="note"><strong>Las categorías no existen</strong> (v3.1 §K1): todo se gestiona en metas y supermetas. Los calendarios funcionan aparte: pueden tener una o más supermetas conectadas y crear eventos propios (con el sistema de 3 colores) o eventos invisibles, que solo existen dentro del calendario (v3.1 §K5). Cuenta y sincronización: Firebase (plan Spark).</p>
</div>
<div class="save-toast" id="toast">Guardado</div>

<!-- Confirmación obligatoria al eliminar (v3.1 §J5/§K4) -->
<div class="confirm" id="confirmBox">
  <div class="box">
    <p id="confirmText"></p>
    <div class="row">
      <button class="mini-btn" id="confirmNo" type="button">Cancelar</button>
      <button class="mini-btn danger-solid" id="confirmYes" type="button">Eliminar</button>
    </div>
  </div>
</div>
<script>
(function(){
  var SUPER_KEY = "productvt-supermetas-v1";
  var CAL_KEY = "productvt-capas-v1";       // misma clave que usa calendario.html (allí se llaman "capas")
  var PALETTE = ["#3A6B54","#2E7B84","#B9812E","#6B8F71","#8C5A7A","#C0672B","#4A6FA5","#9C4A3A"];
  var YEAR_MS = 365 * 24 * 3600 * 1000;     // v3.1 §I6: plazo máximo

  function loadJSON(key, fallback){
    try{ var raw = localStorage.getItem(key); return raw ? JSON.parse(raw) : fallback; }catch(e){ return fallback; }
  }
  function saveJSON(key, val){ try{ localStorage.setItem(key, JSON.stringify(val)); }catch(e){} }
  function esc(s){
    return String(s).replace(/[&<>"']/g, function(c){ return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]; });
  }
  function uid(p){ return p + Date.now().toString(36) + Math.random().toString(36).slice(2, 5); }
  function fmtDeadline(iso){
    if(!iso) return "";
    var d = new Date(iso);
    return d.toLocaleDateString("es", { day: "numeric", month: "short", year: "2-digit" });
  }

  // ---- Calendarios (misma fuente que calendario.html, v3.1 §J6/§K2) ----
  var CALENDARIOS = loadJSON(CAL_KEY, [{ id: "cap-uni", name: "Universidad", color: "#4E6E8E" }]);
  function calById(id){ return CALENDARIOS.filter(function(c){ return c.id === id; })[0] || null; }

  // ---- Supermetas y metas (modelo v3.1, con migración desde el modelo v3) ----
  function migrateSg(s){
    s.calendarId = s.calendarId !== undefined ? s.calendarId : (s.calendar ? "__named__:" + s.calendar : null);
    if(s.calendarId && String(s.calendarId).indexOf("__named__:") === 0){
      var c = CALENDARIOS.filter(function(x){ return x.name === String(s.calendarId).slice(9); })[0];
      s.calendarId = c ? c.id : null;
    }
    delete s.calendar;
    if(s.deadline === undefined) s.deadline = null;
    s.goals = (s.goals || []).map(function(g){
      if(typeof g === "string") g = { name: g }; // modelo v3: metas como texto plano
      g.id = g.id || uid("g");
      g.color = g.color || s.color || PALETTE[0];
      if(g.deadline === undefined) g.deadline = null;
      g.tareas = (g.tareas || []).map(function(t){
        if(typeof t === "string") t = { name: t, done: false };
        return { id: t.id || uid("t"), name: t.name, done: !!t.done };
      });
      g.eventos = g.eventos || [];
      return g;
    });
    return s;
  }
  var DEFAULT_SG = [
    { id: "sg-titulo", name: "Título", color: "#4E6E8E", anti: false, calendarId: "cap-uni",
      deadline: new Date(Date.now() + 300 * 864e5).toISOString(),
      goals: [
        { id: "g-ramo1", name: "Ramo 1", color: "#3A6B54", deadline: new Date(Date.now() + 90 * 864e5).toISOString(),
          tareas: [ { name: "Leer capítulo 1", done: true }, { name: "Ejercicios 1–10", done: false }, { name: "Control 1", done: false } ],
          eventos: [ { id: "e-certamen", name: "Certamen 1", when: "fecha definida" } ] },
        { id: "g-proyecto", name: "Proyecto", color: "#2E7B84", deadline: new Date(Date.now() + 120 * 864e5).toISOString(),
          tareas: [ { name: "Escribir informe", done: false } ],
          eventos: [ { id: "e-entrega", name: "Entrega", when: "fecha definida" } ] }
      ] },
    { id: "sg-tesis", name: "Tesis", color: "#B9812E", anti: false, calendarId: null,
      deadline: new Date(Date.now() + 360 * 864e5).toISOString(),
      goals: [
        { id: "g-cap2", name: "Capítulo 2", color: "#8C5A7A", deadline: new Date(Date.now() + 60 * 864e5).toISOString(),
          tareas: [ { name: "Borrador", done: false }, { name: "Revisión", done: false } ],
          eventos: [ { id: "e-profesor", name: "Reunión con profesor", when: "atemporal" } ] }
      ] },
    { id: "antimeta", name: "Antimeta", color: "#9C4A3A", anti: true, calendarId: null, deadline: null, goals: [] }
  ];
  var SUPERMETAS = loadJSON(SUPER_KEY, DEFAULT_SG.slice()).map(migrateSg);
  function saveSupermetas(){ saveJSON(SUPER_KEY, SUPERMETAS); }
  function sgById(id){ return SUPERMETAS.filter(function(s){ return s.id === id; })[0] || null; }
  function goalPct(g){
    if(!g.tareas.length) return 0;
    return Math.round(g.tareas.filter(function(t){ return t.done; }).length / g.tareas.length * 100);
  }
  function sgPct(sg){
    var all = [];
    sg.goals.forEach(function(g){ all = all.concat(g.tareas); });
    if(!all.length) return 0;
    return Math.round(all.filter(function(t){ return t.done; }).length / all.length * 100);
  }

  // ---- Paleta reutilizable (v3.1 §J1–J2) ----
  function buildPalette(container, color, onSelect){
    container.innerHTML = "";
    PALETTE.forEach(function(col){
      var b = document.createElement("button");
      b.type = "button";
      b.style.background = col;
      b.setAttribute("aria-pressed", col === color ? "true" : "false");
      b.addEventListener("click", function(){ onSelect(col); });
      container.appendChild(b);
    });
  }

  // ---- Plazos: máx. 1 año, mín. 1 segundo (v3.1 §I6) ----
  function toLocalInput(ms){
    var d = new Date(ms), p = function(n){ return (n < 10 ? "0" : "") + n; };
    return d.getFullYear() + "-" + p(d.getMonth() + 1) + "-" + p(d.getDate()) + "T" + p(d.getHours()) + ":" + p(d.getMinutes());
  }
  function clampDeadline(input){
    if(!input.value) return null;
    var t = new Date(input.value).getTime();
    if(isNaN(t)) return null;
    var max = Date.now() + YEAR_MS, min = Date.now() + 1000;
    if(t > max) t = max;
    if(t < min) t = min;
    input.value = toLocalInput(t);
    return new Date(t).toISOString();
  }

  // ---- Confirmación obligatoria al eliminar (v3.1 §J5, §K4) ----
  var confirmBox = document.getElementById("confirmBox");
  var confirmText = document.getElementById("confirmText");
  var confirmYes = document.getElementById("confirmYes");
  var confirmNo = document.getElementById("confirmNo");
  var pendingAction = null;
  function askConfirm(msg, label, fn){
    confirmText.textContent = msg;
    confirmYes.textContent = label || "Eliminar";
    pendingAction = fn;
    confirmBox.classList.add("open");
  }
  function closeConfirm(){ confirmBox.classList.remove("open"); pendingAction = null; }
  confirmNo.addEventListener("click", closeConfirm);
  confirmBox.addEventListener("click", function(e){ if(e.target === confirmBox) closeConfirm(); });
  confirmYes.addEventListener("click", function(){ var fn = pendingAction; closeConfirm(); if(fn) fn(); });

  var toast = document.getElementById("toast"), toastTimer = null;
  function saved(){
    toast.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ toast.classList.remove("show"); }, 1400);
  }

  // ---- Calendarios: crear / eliminar (v3.1 §J6, §K2) ----
  var calListEl = document.getElementById("calList");
  var newCalForm = document.getElementById("newCalForm");
  var calState = { color: PALETTE[0] };
  function linkedSgs(calId){
    return SUPERMETAS.filter(function(s){ return s.calendarId === calId; });
  }
  function renderCalendars(){
    calListEl.innerHTML = "";
    if(!CALENDARIOS.length){
      var empty = document.createElement("span");
      empty.className = "inline-hint";
      empty.textContent = "Sin calendarios. Crea el primero abajo.";
      calListEl.appendChild(empty);
    }
    CALENDARIOS.forEach(function(c){
      var n = linkedSgs(c.id).length;
      var row = document.createElement("div");
      row.className = "cal-row";
      row.innerHTML =
        '<span class="sw" style="background:' + esc(c.color) + '"></span>' +
        '<span class="name">' + esc(c.name) + '</span>' +
        '<span class="linked">' + (n ? n + " supermeta" + (n > 1 ? "s" : "") : "sin vínculos") + '</span>';
      var del = document.createElement("button");
      del.className = "mini-btn xs danger";
      del.type = "button";
      del.textContent = "Eliminar";
      del.addEventListener("click", function(){
        askConfirm("¿Eliminar el calendario «" + c.name + "»? Las supermetas vinculadas quedarán sin calendario.", "Eliminar", function(){
          CALENDARIOS = CALENDARIOS.filter(function(x){ return x.id !== c.id; });
          SUPERMETAS.forEach(function(s){ if(s.calendarId === c.id) s.calendarId = null; });
          saveJSON(CAL_KEY, CALENDARIOS);
          saveSupermetas();
          renderCalendars();
          renderTree();
          saved();
        });
      });
      row.appendChild(del);
      calListEl.appendChild(row);
    });
  }
  function wirePalette(container, state, key){
    buildPalette(container, state[key], function(col){
      state[key] = col;
      wirePalette(container, state, key);
    });
  }
  wirePalette(document.getElementById("calPalette"), calState, "color");
  document.getElementById("newCalBtn").addEventListener("click", function(){
    newCalForm.classList.toggle("hidden");
    if(!newCalForm.classList.contains("hidden")) document.getElementById("calName").focus();
  });
  document.getElementById("calCancel").addEventListener("click", function(){
    newCalForm.classList.add("hidden");
    document.getElementById("calName").value = "";
  });
  document.getElementById("calSave").addEventListener("click", function(){
    var name = document.getElementById("calName").value.trim();
    if(!name) return;
    CALENDARIOS.push({ id: uid("cal"), name: name, color: calState.color });
    saveJSON(CAL_KEY, CALENDARIOS);
    document.getElementById("calName").value = "";
    newCalForm.classList.add("hidden");
    renderCalendars();
    fillCalendarOptions();
    saved();
  });
// ---- Árbol de jerarquía: supermetas → metas (v3.1 §J1–J5, §J7) ----
  var treeEl = document.getElementById("hierarchyTree");
  function iconBtn(label, title, cls, onClick){
    var b = document.createElement("button");
    b.className = "icon-btn" + (cls ? " " + cls : "");
    b.type = "button";
    b.textContent = label;
    b.title = title;
    b.addEventListener("click", onClick);
    return b;
  }
  function tag(text, color){
    var t = document.createElement("span");
    t.className = "meta-tag";
    t.textContent = text;
    if(color){ t.style.borderColor = color; t.style.color = color; }
    return t;
  }
  function renderTree(){
    treeEl.innerHTML = "";
    if(!SUPERMETAS.length){
      var empty = document.createElement("span");
      empty.className = "inline-hint";
      empty.textContent = "Sin supermetas. Crea la primera abajo.";
      treeEl.appendChild(empty);
      return;
    }
    SUPERMETAS.forEach(function(sg){
      var cal = sg.calendarId ? calById(sg.calendarId) : null;
      var node = document.createElement("div");
      node.className = "sg-node";

      var head = document.createElement("div");
      head.className = "sg-row";
      var planet = document.createElement("span");
      planet.className = "planet";
      planet.style.background = sg.color;
      head.appendChild(planet);

      var nm = document.createElement("span");
      nm.className = "name";
      nm.textContent = sg.name;
      head.appendChild(nm);

      if(sg.anti) head.appendChild(tag("antimeta"));
      else {
        var pt = tag(sgPct(sg) + "%");
        pt.style.borderColor = "var(--accent)";
        pt.style.color = "var(--accent)";
        head.appendChild(pt);
      }
      head.appendChild(cal ? tag(cal.name, cal.color) : tag("sin calendario"));
      if(sg.deadline) head.appendChild(tag(fmtDeadline(sg.deadline)));

      var tools = document.createElement("div");
      tools.className = "tools";
      if(!sg.anti){
        tools.appendChild(iconBtn("+", "Añadir una meta dentro de esta supermeta", "", function(){
          openGoalForm(null, sg.id, true);
        }));
      }
      tools.appendChild(iconBtn("✎", "Editar: renombrar, recolorear, plazo o calendario (§J4)", "", function(){
        openSuperForm(sg);
      }));
      tools.appendChild(iconBtn("✕", "Eliminar esta supermeta", "danger", function(){
        askConfirm(
          sg.goals.length
            ? "¿Eliminar «" + sg.name + "»? Esta supermeta mata sus " + sg.goals.length + " meta(s) y todo su progreso."
            : "¿Eliminar «" + sg.name + "»?",
          "Eliminar", function(){
            SUPERMETAS = SUPERMETAS.filter(function(x){ return x.id !== sg.id; });
            saveSupermetas();
            renderTree(); renderCalendars();
            saved();
          });
      }));
      head.appendChild(tools);
      node.appendChild(head);

      sg.goals.forEach(function(g){
        var row = document.createElement("div");
        row.className = "goal-row";
        var moon = document.createElement("span");
        moon.className = "moon";
        moon.style.background = g.color;
        row.appendChild(moon);

        var gname = document.createElement("span");
        gname.className = "name";
        gname.textContent = g.name;
        row.appendChild(gname);

        var gpct = tag(goalPct(g) + "%");
        gpct.style.borderColor = "var(--accent)";
        gpct.style.color = "var(--accent)";
        row.appendChild(gpct);

        if(g.deadline){
          var gdl = tag(fmtDeadline(g.deadline));
          row.appendChild(gdl);
        }

        var gtools = document.createElement("div");
        gtools.className = "tools";
        gtools.appendChild(iconBtn("✎", "Editar meta: mover a otra supermeta, color, nombre, plazo (§J7)", "", function(){
          openGoalForm(g, null, false);
        }));
        gtools.appendChild(iconBtn("✕", "Eliminar esta meta", "danger", function(){
          askConfirm("¿Eliminar la meta «" + g.name + "» de «" + sg.name + "»?", "Eliminar", function(){
            sg.goals = sg.goals.filter(function(x){ return x.id !== g.id; });
            saveSupermetas();
            renderTree(); renderCalendars();
            saved();
          });
        }));
        row.appendChild(gtools);
        node.appendChild(row);
      });

      treeEl.appendChild(node);
    });
  }
// ---- Formularios de supermeta y meta (v3.1 §J1–J3, §J7, §K3) ----
  var superForm = document.getElementById("superForm");
  var goalForm = document.getElementById("goalForm");
  var sfState = { color: PALETTE[0], anti: false, editing: null };
  var gfState = { color: PALETTE[0], editing: null };

  fillCalendarOptions();
  fillSuperOptions();
  wirePalette(document.getElementById("sfPalette"), sfState, "color");
  wirePalette(document.getElementById("gfPalette"), gfState, "color");

  function fillCalendarOptions(){
    var sel = document.getElementById("sfCalendar");
    var cur = sel.value;
    sel.innerHTML = "";
    var none = document.createElement("option");
    none.value = "";
    none.textContent = "No — sin calendario (se crea uno propio con su nombre)";
    sel.appendChild(none);
    CALENDARIOS.forEach(function(c){
      var o = document.createElement("option");
      o.value = c.id;
      o.textContent = "Sí — " + c.name;
      sel.appendChild(o);
    });
    sel.value = cur && calById(cur) ? cur : "";
  }
  function fillSuperOptions(){
    var sel = document.getElementById("gfSuper");
    var cur = sel.value;
    sel.innerHTML = "";
    var valid = SUPERMETAS.filter(function(s){ return !s.anti; });
    if(!valid.length){
      var o = document.createElement("option");
      o.value = "";
      o.textContent = "Sin supermetas disponibles (crea una primero)";
      sel.appendChild(o);
      return;
    }
    valid.forEach(function(s){
      var o = document.createElement("option");
      o.value = s.id;
      o.textContent = s.name;
      sel.appendChild(o);
    });
    sel.value = cur && valid.filter(function(s){ return s.id === cur; }).length ? cur : valid[0].id;
  }

  function openSuperForm(sg){
    sfState.editing = sg ? sg.id : null;
    sfState.color = sg ? sg.color : (CALENDARIOS[0] ? CALENDARIOS[0].color : PALETTE[0]);
    sfState.anti = sg ? !!sg.anti : false;
    fillCalendarOptions();
    document.getElementById("sfCalendar").value = sg && sg.calendarId ? sg.calendarId : "";
    document.getElementById("sfName").value = sg ? sg.name : "";
    document.getElementById("sfDeadline").value =
      (sg && sg.deadline) ? toLocalInput(new Date(sg.deadline).getTime()) : "";
    document.getElementById("sfAnti").setAttribute("aria-pressed", sfState.anti ? "true" : "false");
    wirePalette(document.getElementById("sfPalette"), sfState, "color");
    goalForm.classList.add("hidden");
    superForm.classList.remove("hidden");
    document.getElementById("sfSave").textContent = sg ? "Guardar cambios" : "Crear y añadir su primera meta";
    try{ superForm.scrollIntoView({ behavior: "smooth", block: "center" }); }catch(e){}
  }
// El color por defecto al asociar un calendario es el del calendario (v3.1 §J1)
  document.getElementById("sfCalendar").addEventListener("change", function(){
    var c = calById(this.value);
    if(c){
      sfState.color = c.color;
      wirePalette(document.getElementById("sfPalette"), sfState, "color");
    }
  });
  document.getElementById("sfAnti").addEventListener("click", function(){
    sfState.anti = !sfState.anti;
    this.setAttribute("aria-pressed", sfState.anti ? "true" : "false");
  });
  document.getElementById("newSuperBtn").addEventListener("click", function(){
    openSuperForm(null);
    document.getElementById("sfName").focus();
  });
  document.getElementById("sfCancel").addEventListener("click", function(){
    sfState.editing = null;
    superForm.classList.add("hidden");
  });
  document.getElementById("sfSave").addEventListener("click", function(){
    var nameEl = document.getElementById("sfName");
    var name = nameEl.value.trim();
    if(!name){ nameEl.focus(); return; }
    var calId = document.getElementById("sfCalendar").value || null;
    var deadline = clampDeadline(document.getElementById("sfDeadline"));
    var anti = sfState.anti;

    if(sfState.editing){
      var sg = sgById(sfState.editing);
      if(!sg) return;
      var apply = function(){
        sg.name = name;
        sg.calendarId = calId;
        sg.color = sfState.color;
        sg.deadline = deadline;
        sg.anti = anti;
        if(anti) sg.goals = []; // la antimeta no da puntaje ni tiene metas internas (v3 §A7)
        saveSupermetas();
        superForm.classList.add("hidden");
        sfState.editing = null;
        renderTree(); renderCalendars();
        saved();
      };
      if(anti && sg.goals.length){
        askConfirm("«" + sg.name + "» pasará a ser antimeta: pierde sus " + sg.goals.length +
          " meta(s) y su progreso. ¿Continuar?", "Convertir", apply);
      } else { apply(); }
      return;
    }

    var created = {
      id: uid("sg"), name: name, color: sfState.color, anti: anti,
      calendarId: calId, deadline: deadline, goals: []
    };
    SUPERMETAS.push(created);
    saveSupermetas();
    superForm.classList.add("hidden");
    renderTree(); renderCalendars();
    saved();
    // v3.1 §J3: crear supermeta obliga a asociarle al menos una meta → altiro se abre su creación
    openGoalForm(null, created.id, true);
  });

  function openGoalForm(g, superId, fixedSuper){
    gfState.editing = g ? g.id : null;
    gfState.color = g ? g.color : PALETTE[0];
    fillSuperOptions();
    var sel = document.getElementById("gfSuper");
    if(superId) sel.value = superId;
    if(g){
      var owner = SUPERMETAS.filter(function(s){
        return s.goals.some(function(x){ return x.id === g.id; });
      })[0];
      if(owner) sel.value = owner.id;
    }
    sel.disabled = !!fixedSuper && !g;
    document.getElementById("gfName").value = g ? g.name : "";
    document.getElementById("gfDeadline").value =
      (g && g.deadline) ? toLocalInput(new Date(g.deadline).getTime()) : "";
    document.getElementById("gfTasks").value =
      g ? g.tareas.map(function(t){ return t.name; }).join("\n") : "";
    wirePalette(document.getElementById("gfPalette"), gfState, "color");
    superForm.classList.add("hidden");
    goalForm.classList.remove("hidden");
    document.getElementById("gfSave").textContent = g ? "Guardar cambios" : "Crear meta";
    try{ goalForm.scrollIntoView({ behavior: "smooth", block: "center" }); }catch(e){}
  }
document.getElementById("gfCancel").addEventListener("click", function(){
    gfState.editing = null;
    goalForm.classList.add("hidden");
  });
  document.getElementById("gfSave").addEventListener("click", function(){
    var nameEl = document.getElementById("gfName");
    var name = nameEl.value.trim();
    if(!name){ nameEl.focus(); return; }
    var target = sgById(document.getElementById("gfSuper").value);
    if(!target){ fillSuperOptions(); return; }
    var deadline = clampDeadline(document.getElementById("gfDeadline"));
    var names = document.getElementById("gfTasks").value
      .split("\n").map(function(s){ return s.trim(); }).filter(Boolean);

    if(gfState.editing){
      var found = null, owner = null;
      SUPERMETAS.forEach(function(s){
        s.goals.forEach(function(x){ if(x.id === gfState.editing){ found = x; owner = s; } });
      });
      if(!found) return;
      found.name = name;
      found.color = gfState.color;
      found.deadline = deadline;
      found.tareas = names.map(function(n){
        var prev = found.tareas.filter(function(t){ return t.name === n; })[0];
        return { id: prev ? prev.id : uid("t"), name: n, done: prev ? prev.done : false };
      });
      // Mover la meta a otra supermeta (v3.1 §J7)
      if(owner && owner.id !== target.id){
        owner.goals = owner.goals.filter(function(x){ return x.id !== found.id; });
        target.goals.push(found);
      }
      saveSupermetas();
      goalForm.classList.add("hidden");
      gfState.editing = null;
      renderTree(); renderCalendars();
      saved();
      return;
    }

    target.goals.push({
      id: uid("g"), name: name, color: gfState.color, deadline: deadline,
      tareas: names.map(function(n){ return { id: uid("t"), name: n, done: false }; }),
      eventos: []
    });
    saveSupermetas();
    goalForm.classList.add("hidden");
    renderTree(); renderCalendars();
    saved();
  });
// ---- Frase de cancelación (doble confirmación) ----
  var phraseText = document.getElementById("phraseText");
  var savedPhrase = loadJSON("productvt-cancel-phrase", "");
  phraseText.textContent = typeof savedPhrase === "string" && savedPhrase
    ? savedPhrase : "¿Seguro que quieres cancelar el bloque?";
  document.getElementById("phraseEdit").addEventListener("click", function(){
    document.getElementById("phraseInput").value = phraseText.textContent;
    document.getElementById("phraseView").classList.add("hidden");
    document.getElementById("phraseEditBox").classList.remove("hidden");
  });
  document.getElementById("phraseCancel").addEventListener("click", function(){
    document.getElementById("phraseEditBox").classList.add("hidden");
    document.getElementById("phraseView").classList.remove("hidden");
  });
  document.getElementById("phraseSave").addEventListener("click", function(){
    var v = document.getElementById("phraseInput").value.trim();
    if(!v) return;
    phraseText.textContent = v;
    saveJSON("productvt-cancel-phrase", v);
    document.getElementById("phraseEditBox").classList.add("hidden");
    document.getElementById("phraseView").classList.remove("hidden");
    saved();
  });

  // ---- Arranque ----
  renderCalendars();
  renderTree();
})();
</script>
</body>
</html>
</file>

<file path="Respaldo-Productvt-Visual/cronometro.html">
<title>Ciclo de Estudio</title>
<style>
  :root{
    --paper: #EFEDE5;
    --paper-raised: #FAF9F3;
    --ink: #20241E;
    --muted: #6E7368;
    --accent: #3A6B54;
    --accent-ink: #F3F7F1;
    --accent-soft: #DCE6DC;
    --rule: #D5D1C1;
    --rule-strong: #B9B4A0;
    --break: #2E7B84;
    --break-soft: #D8E6E7;
    --lunch: #B9812E;
    --lunch-soft: #EFE1C6;
    --ocio: #6B8F71;
    --warn: #C0672B;
    --danger: #9C4A3A;
    --danger-soft: #E9D6CF;
    --focus: #3A6B54;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper: #14170F;
      --paper-raised: #1B1F16;
      --ink: #E9E7DC;
      --muted: #949A88;
      --accent: #7BB596;
      --accent-ink: #10241A;
      --accent-soft: #223429;
      --rule: #2B3225;
      --rule-strong: #3C4433;
      --break: #6FB9C2;
      --break-soft: #1D3538;
      --lunch: #D9A85C;
      --lunch-soft: #362A16;
      --ocio: #94C79B;
      --warn: #E08B52;
      --danger: #D08871;
      --danger-soft: #33221D;
      --focus: #7BB596;
    }
  }
  :root[data-theme="dark"]{
    --paper: #14170F; --paper-raised: #1B1F16; --ink: #E9E7DC; --muted: #949A88;
    --accent: #7BB596; --accent-ink: #10241A; --accent-soft: #223429;
    --rule: #2B3225; --rule-strong: #3C4433;
    --break: #6FB9C2; --break-soft: #1D3538; --lunch: #D9A85C; --lunch-soft: #362A16;
    --ocio: #94C79B;
    --warn: #E08B52; --danger: #D08871; --danger-soft: #33221D; --focus: #7BB596;
  }

  *{ box-sizing: border-box; }
  body{
    background: var(--paper);
    color: var(--ink);
    font-family: "Archivo", ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  button{ font: inherit; }

  .shell{
    max-width: 420px;
    margin: 0 auto;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 0 0 24px;
  }

  .topbar{
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px 8px;
  }
  .topbar .title{
    font-family: "Fraunces", Georgia, serif;
    font-size: 16px;
    font-weight: 500;
    color: var(--muted);
  }
  .role-pill{
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 11px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 20px;
    border: 1px solid var(--rule-strong);
    color: var(--ink);
  }
  .role-pill .dot{ width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .role-pill.spectator .dot{ background: var(--muted); }

  .stage{
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 12px 24px 28px;
    text-align: center;
  }

  .state-label{
    font-family: "Fraunces", Georgia, serif;
    font-size: 23px;
    font-weight: 480;
    text-wrap: balance;
  }
  .helper{
    font-size: 13.5px;
    color: var(--muted);
    max-width: 34ch;
    line-height: 1.5;
  }
  .helper.stakes{ color: var(--warn); }
  .editing-tag{
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 11px;
    color: var(--accent);
  }

  .cat-chip{
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 12px;
    color: var(--muted);
  }
  .cat-chip .swatch{ width: 9px; height: 9px; border-radius: 50%; }

  .ring-wrap{ position: relative; width: 240px; height: 240px; }
  .ring-wrap svg{ transform: rotate(-90deg); width: 100%; height: 100%; }
  .ring-track{ fill: none; stroke: var(--rule); stroke-width: 8; }
  .ring-mark{ fill: none; stroke: var(--rule-strong); stroke-width: 2; stroke-dasharray: 1 5; }
  .ring-fill{ fill: none; stroke-width: 8; stroke-linecap: round; transition: stroke-dashoffset .3s linear, stroke .3s ease; }
  .ring-center{
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;
  }
  .clock{
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-variant-numeric: tabular-nums;
    font-size: 42px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .clock-sub{ font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 11px; color: var(--muted); }

  .type-toggle{ display: flex; gap: 8px; justify-content: center; width: 100%; }
  .type-btn{
    flex: 1; border: 1px solid var(--rule-strong); background: var(--paper-raised); color: var(--muted);
    border-radius: 10px; padding: 10px; cursor: pointer; font-size: 13px;
  }
  .type-btn strong{ display: block; font-family: "Fraunces", Georgia, serif; font-size: 15px; color: var(--ink); font-weight: 500; }
  .type-btn[aria-pressed="true"]{ border-color: var(--accent); background: var(--accent-soft); }
  .type-btn[aria-pressed="true"] strong{ color: var(--accent); }

  .choices{ display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  .choice{
    border: 1px solid var(--rule-strong);
    background: var(--paper-raised);
    color: var(--ink);
    border-radius: 20px;
    padding: 8px 14px;
    font-size: 13.5px;
    cursor: pointer;
    display: inline-flex; align-items: center; gap: 7px;
  }
  .choice[aria-pressed="true"]{ border-color: var(--accent); background: var(--accent-soft); }
  .choice .swatch{ width: 9px; height: 9px; border-radius: 50%; }
  .choice:disabled{ opacity: .45; cursor: not-allowed; }
  .choice.preset{ padding-right: 24px; position: relative; }
  .choice.add-cat{ border-style: dashed; color: var(--muted); }
  .choice .preset-x{
    position: absolute; right: 7px; top: 50%; transform: translateY(-50%);
    font-size: 14px; line-height: 1; color: var(--muted);
  }
  .choice .preset-x:hover{ color: var(--danger); }

  .step-block{ display: flex; flex-direction: column; align-items: center; width: 100%; gap: 4px; transition: opacity .25s ease, transform .25s ease; }
  .step-block.done{ opacity: .45; transform: scale(.94); } /* v3.1 §H3: se desvanecen y comprimen al completarse */
  .sq-btn{
    border: 1px solid var(--rule-strong); background: var(--paper-raised); color: var(--ink);
    border-radius: 10px; padding: 12px 14px; cursor: pointer; font-size: 12.5px; text-align: center; min-width: 136px;
  }
  .sq-btn strong{ display: block; font-family: "Fraunces", Georgia, serif; font-weight: 500; font-size: 14.5px; margin-bottom: 2px; }
  .sq-btn[aria-pressed="true"]{ border-color: var(--accent); background: var(--accent-soft); }
  .sq-btn[aria-pressed="true"] strong{ color: var(--accent); }
  .presets-tools{ display: flex; gap: 8px; justify-content: center; margin-top: 4px; }
  .step-title{
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 11px; letter-spacing: .05em; text-transform: uppercase;
    color: var(--accent); margin: 10px 0 4px; width: 100%; text-align: center;
  }
  .choice small{ font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 10px; color: var(--muted); }
  .new-cat-form{
    display: flex; flex-direction: column; gap: 10px; width: 100%;
    border: 1px solid var(--rule-strong); border-radius: 10px; padding: 12px;
    background: var(--paper-raised);
  }
  .new-cat-form input[type="text"]{
    font-family: "Archivo", sans-serif; font-size: 13.5px;
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--rule-strong); border-radius: 8px; padding: 9px 11px;
  }
  .palette{ display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; align-items: center; }
  .palette button{
    width: 22px; height: 22px; border-radius: 50%; border: 2px solid transparent; cursor: pointer; padding: 0;
  }
  .palette button[aria-pressed="true"]{ border-color: var(--ink); }
  .palette-more{
    width: 22px; height: 22px; border-radius: 50%; position: relative; overflow: hidden; cursor: pointer;
    background: conic-gradient(red, yellow, lime, cyan, blue, magenta, red);
    border: 2px solid transparent; flex: none;
  }
  .palette-more.active{ border-color: var(--ink); }
  .palette-more input[type="color"]{
    position: absolute; inset: -6px; opacity: 0; cursor: pointer; border: none; padding: 0;
  }
  .new-cat-actions{ display: flex; gap: 8px; }
  .new-cat-actions .mini-btn{ flex: 1; }

  .settings-block{ display: flex; flex-direction: column; gap: 8px; width: 100%; }
  .settings-group{
    display: flex; flex-direction: column; gap: 8px;
    font-size: 12.5px; color: var(--muted);
    border: 1px solid var(--rule); border-radius: 10px; padding: 10px 12px;
  }
  .settings-group .grow{ display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .settings-group .glabel{ color: var(--ink); }
  .settings-group .gcontrols{ display: flex; align-items: center; gap: 6px; }
  .settings-group select{
    font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 12px;
    background: var(--paper-raised); color: var(--ink);
    border: 1px solid var(--rule-strong); border-radius: 6px; padding: 4px 6px;
  }

  .time-chips{ display: flex; flex-wrap: wrap; gap: 6px; }
  .tchip{
    font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 12px;
    border: 1px solid var(--rule-strong); background: var(--paper-raised); color: var(--ink);
    border-radius: 14px; padding: 5px 10px; cursor: pointer; position: relative;
  }
  .tchip[aria-pressed="true"]{ border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
  .tchip.custom{ padding-right: 20px; }
  .tchip.add{ border-style: dashed; color: var(--muted); }
  .tchip-x{ position: absolute; right: 5px; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 12px; }
  .tchip-x:hover{ color: var(--danger); }

  .custom-time-row{ display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .custom-time-row input[type="number"]{
    width: 66px; font-family: "IBM Plex Mono", monospace; font-size: 12.5px;
    background: var(--paper-raised); color: var(--ink);
    border: 1px solid var(--rule-strong); border-radius: 6px; padding: 5px 7px;
  }
  .ct-check{ display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; color: var(--muted); }

  .save-row{ display: flex; gap: 8px; width: 100%; }
  .save-row input{
    flex: 1; font-family: "Archivo", ui-sans-serif, sans-serif; font-size: 13.5px;
    background: var(--paper-raised); color: var(--ink);
    border: 1px solid var(--rule-strong); border-radius: 8px; padding: 10px 12px;
  }
  .save-row input:focus-visible{ outline: 2px solid var(--focus); outline-offset: 1px; }
  .mini-btn{
    font-family: "Archivo", ui-sans-serif, sans-serif; font-size: 13px;
    background: var(--paper-raised); color: var(--ink);
    border: 1px solid var(--rule-strong); border-radius: 8px; padding: 10px 12px; cursor: pointer;
    white-space: nowrap;
  }
  .mini-btn.ghost{ background: none; border-color: transparent; color: var(--muted); }
  .save-actions{ display: flex; gap: 14px; align-items: center; justify-content: center; }

  .actions{ display: flex; flex-direction: column; gap: 10px; width: 100%; margin-top: 4px; }
  .btn{
    border: none;
    border-radius: 10px;
    padding: 14px 18px;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    width: 100%;
  }
  .btn.primary{ background: var(--accent); color: var(--accent-ink); }
  .btn.secondary{ background: var(--paper-raised); color: var(--ink); border: 1px solid var(--rule-strong); }
  .btn.ghost{ background: none; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; padding: 8px; }
  .btn.danger-ghost{ background: none; color: var(--danger); text-decoration: underline; text-underline-offset: 3px; padding: 8px; }
  .btn:focus-visible{ outline: 2px solid var(--focus); outline-offset: 2px; }
  .btn:disabled{ opacity: .5; cursor: not-allowed; }

  /* overlays */
  .overlay{
    position: fixed; inset: 0;
    background: rgba(0,0,0,.35);
    display: flex; align-items: flex-end; justify-content: center;
    z-index: 30;
  }
  .sheet{
    background: var(--paper); border-top: 1px solid var(--rule);
    width: 100%; max-width: 420px;
    border-radius: 18px 18px 0 0;
    padding: 24px 22px 26px;
    display: flex; flex-direction: column; gap: 14px;
  }
  .sheet h2{ font-family: "Fraunces", Georgia, serif; font-size: 19px; font-weight: 500; margin: 0; }
  .sheet p{ font-size: 14px; color: var(--muted); margin: 0; line-height: 1.5; }

  /* demo drawer */
  .demo{
    margin-top: auto;
    border-top: 1px dashed var(--rule-strong);
    padding: 10px 20px;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
  }
  .demo summary{
    cursor: pointer; font-size: 11px; color: var(--muted);
    padding: 6px 0;
  }
  .demo-body{ display: flex; flex-direction: column; gap: 10px; padding: 8px 0 2px; }
  .demo-row{ display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 11.5px; color: var(--muted); }
  .demo select{
    font-family: inherit; font-size: 11.5px; background: var(--paper-raised);
    color: var(--ink); border: 1px solid var(--rule-strong); border-radius: 6px; padding: 4px 6px;
  }
  .demo button.mini{
    font-family: inherit; font-size: 11px; background: var(--paper-raised); color: var(--ink);
    border: 1px solid var(--rule-strong); border-radius: 6px; padding: 5px 8px; cursor: pointer;
  }
  .note{
    font-size: 10.5px; color: var(--muted); line-height: 1.5; margin-top: 2px;
  }
</style>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,380..520;1,9..144,380..520&family=Archivo:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap">

<div class="shell">
  <div class="topbar">
    <span class="title" id="topTitle">Cronómetro</span>
    <span class="role-pill" id="rolePill"><span class="dot"></span><span id="roleLabel">Dominante</span></span>
  </div>

  <div class="stage" id="stage"></div>

  <details class="demo">
    <summary>Panel de prueba — no es parte de la app</summary>
    <div class="demo-body">
      <div class="demo-row">
        <span>Velocidad del reloj</span>
        <select id="speedSelect">
          <option value="1">1×</option>
          <option value="10">10×</option>
          <option value="30" selected>30×</option>
          <option value="60">60×</option>
        </select>
      </div>
      <div class="demo-row">
        <span>Ciclos desde el último almuerzo: <b id="lunchCounter">0</b></span>
        <button class="mini" id="resetLunch" type="button">reiniciar</button>
      </div>
      <div class="demo-row">
        <span>Otro dispositivo</span>
        <button class="mini" id="simConflict" type="button">pedir el control</button>
      </div>
      <div class="demo-row">
        <span>Saltar</span>
        <button class="mini" id="skipTimer" type="button">al final del conteo actual</button>
      </div>
      <p class="note">Duraciones reales corren aceleradas para poder probar el flujo completo. Máquina de estados y reglas (ventanas por tamaño/posición de ciclo, banco de descanso, doble confirmación de 15+15s con carrera contra la ventana, almuerzo con pausa/reanudación exacta) siguen docs/03-CRONOMETRO.md. Categorías: no existen (v3.1 §K1) — todo se gestiona con supermetas y metas; el inverso se registra en la antimeta.</p>
    </div>
  </details>
</div>

<script>
(function(){
  var DEFAULT_CATEGORIES = [
    { id: "mate", name: "Matemáticas", color: "#B06A3A", type: "productiva" },
    { id: "lectura", name: "Lectura", color: "#4E6E8E", type: "productiva" },
    { id: "codigo", name: "Código", color: "#7A6A9E", type: "productiva" },
    { id: "idiomas", name: "Idiomas", color: "#A85C6B", type: "productiva" },
    { id: "pantalla", name: "Pausa de pantalla", color: "#6B8F71", type: "ocio" },
    { id: "ejercicio", name: "Ejercicio", color: "#C97A2B", type: "ocio" },
    { id: "social", name: "Social", color: "#8A6FA3", type: "ocio" }
  ];
  var PALETTE = ["#B06A3A","#4E6E8E","#7A6A9E","#A85C6B","#6B8F71","#C97A2B","#8A6FA3","#3A6B54","#9C4A3A","#2E7B84"];
  var CATS_KEY = "productvt-categorias-v1";
  var LAST_COLOR_KEY = "productvt-ultimo-color-v1";
  function loadLastColor(){ try{ return localStorage.getItem(LAST_COLOR_KEY); }catch(e){ return null; } }
  function saveLastColor(c){ try{ localStorage.setItem(LAST_COLOR_KEY, c); }catch(e){} }
  var lastColor = loadLastColor();
  function orderedPalette(){
    if(!lastColor) return PALETTE.slice();
    return [lastColor].concat(PALETTE.filter(function(c){ return c !== lastColor; }));
  }

  function loadCategories(){
    try{ var raw = localStorage.getItem(CATS_KEY); return raw ? JSON.parse(raw) : DEFAULT_CATEGORIES.slice(); }
    catch(e){ return DEFAULT_CATEGORIES.slice(); }
  }
  function saveCategories(){ try{ localStorage.setItem(CATS_KEY, JSON.stringify(CATEGORIES)); }catch(e){} }
  var CATEGORIES = loadCategories();
  function categoriesOf(type){ return CATEGORIES.filter(function(c){ return c.type === type; }); }
  function typeForMode(mode){ return mode === "inverso" ? "ocio" : "productiva"; }

  // D6.b: si el bloque está ligado a una meta, su color manda sobre el de categoría en esta pantalla
  var METAS_KEY = "productvt-metas-v1";
  function loadMetas(){ try{ var raw = localStorage.getItem(METAS_KEY); return raw ? JSON.parse(raw) : []; }catch(e){ return []; } }
  var METAS = loadMetas();
  function metaById(id){ return METAS.find(function(m){ return m.id === id; }); }

  // ---- v3 §A: jerarquía Supermeta → Meta → Tarea/Evento ----
  // Las supermetas se asocian a un calendario (v3 §A2); sin calendario, crean uno propio con su
  // nombre y su color al primer bloque (v3 §D2–D3). La antimeta no da puntaje y solo contiene
  // eventos atemporales (v3 §A7) — es la categoría invisible del cronómetro inverso.
  var SUPERMETAS_KEY = "productvt-supermetas-v1";
  var DEFAULT_SUPERMETAS = [
    { id: "sg-titulo", name: "Título", color: "#3A6B54", calendar: "Título", goals: [
      { id: "g-ramo1", name: "Ramo 1",
        tareas: [ { id: "t-guias", name: "Estudiar guías", targetSeconds: 10 * 3600 } ],
        eventos: [ { id: "e-certamen", name: "Certamen 1", when: "fecha definida" } ] },
      { id: "g-proyecto", name: "Proyecto",
        tareas: [ { id: "t-informe", name: "Escribir informe", targetSeconds: 6 * 3600 } ],
        eventos: [ { id: "e-entrega", name: "Entrega", when: "fecha definida" } ] }
    ] },
    { id: "sg-tesis", name: "Tesis", color: "#4E6E8E", calendar: null, goals: [
      { id: "g-cap2", name: "Capítulo 2",
        tareas: [ { id: "t-escribir", name: "Escribir", targetSeconds: 20 * 3600 } ],
        eventos: [ { id: "e-profesor", name: "Reunión con profesor", when: "atemporal" } ] }
    ] },
    { id: "antimeta", name: "Antimeta", color: "#9C4A3A", calendar: null, anti: true, goals: [] }
  ];
  function loadSupermetas(){
    try{ var raw = localStorage.getItem(SUPERMETAS_KEY); return raw ? JSON.parse(raw) : DEFAULT_SUPERMETAS.slice(); }
    catch(e){ return DEFAULT_SUPERMETAS.slice(); }
  }
  var SUPERMETAS = loadSupermetas();
  function supermetaById(id){ return SUPERMETAS.find(function(s){ return s.id === id; }); }
  function goalById(sg, id){ return sg ? sg.goals.find(function(g){ return g.id === id; }) : null; }

  var DEFAULT_TIME_OPTIONS = {
    study: [15, 20, 25, 30, 40, 50, 60, 90],
    short: [3, 5, 10, 15],
    long: [10, 15, 20, 35],
    inverso: [10, 15, 20, 30, 45, 60, 90]
  };
  var MAX_MINUTES = { study: 600, short: 600, long: 600, inverso: 1440 };
  var TIME_FIELD_TO_CONFIG = { study: "studyMinutes", short: "shortBreakMinutes", long: "longBreakMinutes", inverso: "inversoMinutes" };
  var CUSTOM_TIMES_KEY = "productvt-tiempos-personalizados-v1";
  function loadCustomTimes(){
    try{ var raw = localStorage.getItem(CUSTOM_TIMES_KEY); return raw ? JSON.parse(raw) : { study: [], short: [], long: [], inverso: [] }; }
    catch(e){ return { study: [], short: [], long: [], inverso: [] }; }
  }
  function saveCustomTimes(){ try{ localStorage.setItem(CUSTOM_TIMES_KEY, JSON.stringify(customTimes)); }catch(e){} }
  var customTimes = loadCustomTimes();
  if(!customTimes.inverso) customTimes.inverso = [];
  function timeOptionsFor(field){
    var merged = DEFAULT_TIME_OPTIONS[field].concat(customTimes[field]);
    var uniq = Array.from(new Set(merged));
    uniq.sort(function(a,b){ return a - b; });
    return uniq;
  }
  function isCustomTime(field, n){ return DEFAULT_TIME_OPTIONS[field].indexOf(n) === -1; }

  var CYCLES_BEFORE_LONG_OPTIONS = [2, 3, 4, 6];
  var LUNCH_MINUTES = 45;
  var LUNCH_COOLDOWN_CYCLES = 3;
  var LARGE_SEGMENT_THRESHOLD_SECONDS = 1800;
  var CANCEL_CONFIRM_WINDOW_SECONDS = 15;
  var PRESET_KEY = "productvt-cronometro-formatos-v1";

  function loadPresets(){
    try{ var raw = localStorage.getItem(PRESET_KEY); return raw ? JSON.parse(raw) : []; }
    catch(e){ return []; }
  }
  function savePresets(list){
    try{ localStorage.setItem(PRESET_KEY, JSON.stringify(list)); }catch(e){}
  }
  var BUILTIN_PRESET = { id: "pomo-clasico", name: "Pomodoro clásico", studyMinutes: 25, shortBreakMinutes: 5, longBreakMinutes: 15, cyclesBeforeLongBreak: 4 };
  var presets = loadPresets();
  if(!presets.some(function(p){ return p.id === BUILTIN_PRESET.id; })){
    presets = [BUILTIN_PRESET].concat(presets); // v3 §C2: preset por defecto (no persistido)
  }
  var config = {
    studyMinutes: 25,
    shortBreakMinutes: 5,
    longBreakMinutes: 15,
    cyclesBeforeLongBreak: 4,
    inversoMinutes: 30
  };

  // ---- Reglas de negocio (docs/03-CRONOMETRO.md) ----
  function computeGrantedBreakSeconds(cycleNumber){
    var short = config.shortBreakMinutes * 60;
    var givesWay = cycleNumber % config.cyclesBeforeLongBreak === 0;
    var long = givesWay ? config.longBreakMinutes * 60 : 0;
    return short + long;
  }
  function resolveBreakType(usedSeconds, grantedSeconds, cycleNumber){
    if(usedSeconds === 0) return "skipped";
    var givesWay = cycleNumber % config.cyclesBeforeLongBreak === 0;
    if(usedSeconds === grantedSeconds) return givesWay ? "long" : "short";
    return "custom";
  }
  function resolveStudyResponseWindowSeconds(cycleNumber, durationSeconds){
    var givesWay = cycleNumber % config.cyclesBeforeLongBreak === 0;
    var isLarge = durationSeconds > LARGE_SEGMENT_THRESHOLD_SECONDS;
    return (isLarge || givesWay) ? 600 : 30;
  }
  function resolveBreakResponseWindowSeconds(breakType, usedSeconds){
    var isLong = breakType === "long" || usedSeconds > LARGE_SEGMENT_THRESHOLD_SECONDS;
    return isLong ? 600 : 30;
  }
  function isLunchAvailable(){
    return !session.lunchUsed || session.cyclesSinceLunch >= LUNCH_COOLDOWN_CYCLES;
  }

  var stage = document.getElementById("stage");
  var topTitle = document.getElementById("topTitle");
  var rolePill = document.getElementById("rolePill");
  var roleLabel = document.getElementById("roleLabel");
  var speedSelect = document.getElementById("speedSelect");
  var lunchCounterEl = document.getElementById("lunchCounter");
  var WAITING_STATES = ["study_completed_waiting_response", "break_selection", "break_completed_waiting_response"];

  var state = {
    screen: "setup",
    role: "dominante",
    cronometroType: "normal",
    category: categoriesOf("productiva")[0],
    remaining: 0,
    total: 0,
    ringColor: "var(--accent)",
    showSaveForm: false,
    showNewCat: false,
    newCatColor: PALETTE[0],
    customTimeField: null,
    customBreakOpen: false,
    linkedMetaId: null,
    presetOn: false,          // v3.1 §H1: toggle cuadrado "Usar preset"
    personalizeOn: false,     // v3.1 §H1: toggle cuadrado "Personalizar"
    editingPresets: false,    // v3.1 §H2: modo edición de presets
    chosenSupermetaId: null,  // v3 §C2 paso 2
    chosenGoalId: null,       // v3 §C2 paso 3
    blockKind: null,          // v3 §C3 paso 4: "evento" | "tarea"
    chosenTargetId: null,     // v3 §C3: evento o tarea elegida
    activePresetId: null,
    metaFlashed: false,
    speed: 30,
    tickHandle: null
  };

  var session = null; // se crea en START_SESSION, se limpia al volver a "setup"
  var activeCancelCleanup = null;

  function fmt(sec){
    sec = Math.max(0, Math.ceil(sec));
    var m = Math.floor(sec/60), s = sec%60;
    return String(m).padStart(2,"0") + ":" + String(s).padStart(2,"0");
  }
  function fmtMin(sec){ return Math.round(sec/60) + " min"; }

  function stopTicking(){
    if(state.tickHandle){ clearInterval(state.tickHandle); state.tickHandle = null; }
  }

  function startTicking(onTick, onDone){
    stopTicking();
    var last = Date.now();
    state.tickHandle = setInterval(function(){
      var now = Date.now();
      var dt = (now - last) / 1000 * state.speed;
      last = now;
      state.remaining -= dt;
      if(state.remaining <= 0){
        state.remaining = 0;
        stopTicking();
        onTick();
        onDone();
      } else {
        onTick();
      }
    }, 100);
  }

  function tickUp(onTick, onTarget, onHardCap){
    stopTicking();
    var last = Date.now();
    state.tickHandle = setInterval(function(){
      var now = Date.now();
      var dt = (now - last) / 1000 * state.speed;
      last = now;
      state.elapsed += dt;
      if(!state.metaFlashed && state.elapsed >= state.targetSeconds){
        state.metaFlashed = true;
        onTarget();
      }
      if(state.elapsed >= state.hardCapSeconds){
        state.elapsed = state.hardCapSeconds;
        stopTicking();
        onTick();
        onHardCap();
      } else {
        onTick();
      }
    }, 100);
  }

  function goto(screen, opts){
    stopTicking();
    if(activeCancelCleanup){ activeCancelCleanup(); activeCancelCleanup = null; }
    state.screen = screen;
    Object.assign(state, opts || {});
    render();
  }

  // ---- Motor: sesión de estudio (docs/03-CRONOMETRO.md §4) ----

  function startSession(){ // T1
    session = {
      cyclesCompleted: 0, cyclesSinceLunch: 0, lunchUsed: false,
      effectiveStudySeconds: 0, bankRemainingSeconds: 0,
      stateBeforeLunch: null, pausedSegment: null,
      pendingBreak: null, lastBreakType: null, lastBreakUsedSeconds: 0,
      link: captureLink() // v3 §C3: calificación del bloque + calendario destino (v3 §D)
    };
    enterStudyRunning();
  }

  function captureLink(){ // v3 §C2–C3 (pasos 2–4) y §D1–D3
    var sg = supermetaById(state.chosenSupermetaId);
    if(!sg) return null;
    var goal = goalById(sg, state.chosenGoalId);
    var target = null;
    if(goal && state.blockKind === "evento") target = goal.eventos.filter(function(e){ return e.id === state.chosenTargetId; })[0];
    if(goal && state.blockKind === "tarea") target = goal.tareas.filter(function(t){ return t.id === state.chosenTargetId; })[0];
    return {
      supermeta: sg.name, anti: !!sg.anti,
      goal: goal ? goal.name : null,
      kind: state.blockKind,
      target: target ? target.name : null,
      targetSeconds: target && target.targetSeconds ? target.targetSeconds : null,
      // v3 §D2–D3: calendario vinculado; si no hay, la supermeta crea uno propio con su nombre y color
      calendar: sg.calendar || sg.name,
      ownCalendar: !sg.calendar,
      color: sg.calendar ? null : sg.color
    };
  }

  function enterStudyRunning(){ // T1 / T9 / T13 (retorno) / T14->T13
    state.total = config.studyMinutes * 60;
    state.remaining = state.total;
    state.ringColor = "var(--accent)";
    goto("study_running");
    startTicking(renderRing, handleStudyFinished);
  }

  function handleStudyFinished(){ // T2, auto
    session.cyclesCompleted++;
    session.cyclesSinceLunch++;
    session.effectiveStudySeconds += config.studyMinutes * 60;
    enterStudyWaiting();
  }

  function enterStudyWaiting(){ // T2 destino / T3 (ventana propia) / retorno T13
    var windowSeconds = resolveStudyResponseWindowSeconds(session.cyclesCompleted, config.studyMinutes * 60);
    state.total = windowSeconds; state.remaining = windowSeconds;
    goto("study_completed_waiting_response");
    startTicking(renderRing, handleExpire);
  }

  function ackStudyFinished(){ // T3
    var windowSeconds = resolveStudyResponseWindowSeconds(session.cyclesCompleted, config.studyMinutes * 60);
    state.total = windowSeconds; state.remaining = windowSeconds;
    goto("break_selection");
    startTicking(renderRing, handleExpire);
  }

  function chooseSuggestedBreak(){ // T4
    var granted = computeGrantedBreakSeconds(session.cyclesCompleted);
    if(granted <= 0){ skipBreak(); return; }
    enterBreakRunning(granted, session.cyclesCompleted);
  }

  function chooseCustomBreak(chosenSeconds){ // T5
    if(chosenSeconds <= 0){
      registerBreakSegment(0, session.cyclesCompleted);
      enterStudyRunning();
      return;
    }
    enterBreakRunning(chosenSeconds, session.cyclesCompleted);
  }

  function skipBreak(){ // T6
    registerBreakSegment(0, session.cyclesCompleted);
    enterStudyRunning();
  }

  function enterBreakRunning(seconds, cycleAtGrant){
    state.total = seconds; state.remaining = seconds;
    state.ringColor = "var(--break)";
    session.pendingBreak = { cycleAtGrant: cycleAtGrant };
    goto("break_running");
    startTicking(renderRing, handleBreakFinished);
  }

  function handleBreakFinished(){ // T8, auto
    var usedSeconds = state.total;
    var cycleAtGrant = session.pendingBreak.cycleAtGrant;
    var breakType = registerBreakSegment(usedSeconds, cycleAtGrant);
    var windowSeconds = resolveBreakResponseWindowSeconds(breakType, usedSeconds);
    session.lastBreakType = breakType; session.lastBreakUsedSeconds = usedSeconds;
    state.total = windowSeconds; state.remaining = windowSeconds;
    goto("break_completed_waiting_response");
    startTicking(renderRing, handleExpire);
  }

  function registerBreakSegment(usedSeconds, cycleAtGrant){
    var granted = computeGrantedBreakSeconds(cycleAtGrant);
    var breakType = resolveBreakType(usedSeconds, granted, cycleAtGrant);
    session.bankRemainingSeconds += (granted - usedSeconds);
    session.lastBreakType = breakType; session.lastBreakUsedSeconds = usedSeconds;
    return breakType;
  }

  function continueStudy(){ enterStudyRunning(); } // T9
  function endSession(){ goto("session_completed"); } // T7 / T10

  function requestLunch(){ // T11 / T12
    if(!isLunchAvailable()) return;
    var running = state.screen === "study_running" || state.screen === "break_running";
    session.stateBeforeLunch = state.screen;
    session.pausedSegment = running ? { remainingSeconds: state.remaining, totalSeconds: state.total } : null;
    session.lunchUsed = true; session.cyclesSinceLunch = 0;
    state.total = LUNCH_MINUTES * 60; state.remaining = state.total;
    state.ringColor = "var(--lunch)";
    goto("lunch_running");
    startTicking(renderRing, handleLunchFinished);
  }

  function handleLunchFinished(){ // T13
    var back = session.stateBeforeLunch;
    if(session.pausedSegment){
      state.total = session.pausedSegment.totalSeconds;
      state.remaining = session.pausedSegment.remainingSeconds;
      state.ringColor = back === "study_running" ? "var(--accent)" : "var(--break)";
      session.pausedSegment = null;
      goto(back);
      startTicking(renderRing, back === "study_running" ? handleStudyFinished : handleBreakFinished);
    } else if(back === "study_completed_waiting_response"){
      enterStudyWaiting();
    } else if(back === "break_selection"){
      ackStudyFinished();
    } else { // break_completed_waiting_response
      var windowSeconds = resolveBreakResponseWindowSeconds(session.lastBreakType, session.lastBreakUsedSeconds);
      state.total = windowSeconds; state.remaining = windowSeconds;
      goto("break_completed_waiting_response");
      startTicking(renderRing, handleExpire);
    }
  }

  function handleExpire(){ goto("session_expired"); } // T17, auto

  function startInverso(){
    state.targetSeconds = config.inversoMinutes * 60;
    state.hardCapSeconds = state.targetSeconds * 2;
    state.elapsed = 0;
    state.metaFlashed = false;
    state.ringColor = "var(--ocio)";
    goto("inverso_running");
    tickUp(renderRing, function(){ /* meta alcanzada, se refleja en el render/anillo */ }, function(){
      goto("inversoDone", { finalElapsed: state.hardCapSeconds });
    });
  }

  function finishInverso(){
    goto("inversoDone", { finalElapsed: state.elapsed });
  }

  function renderRing(){
    var circle = stage.querySelector(".ring-fill");
    var clock = stage.querySelector(".clock");
    if(state.screen === "inverso_running"){
      var pct = state.hardCapSeconds ? state.elapsed / state.hardCapSeconds : 0;
      if(circle){
        var C = 2 * Math.PI * 108;
        circle.style.strokeDashoffset = (C * (1 - pct));
        circle.style.stroke = state.metaFlashed ? "var(--warn)" : state.ringColor;
      }
      if(clock) clock.textContent = fmt(state.elapsed);
      return;
    }
    var pct2 = state.total ? state.remaining / state.total : 0;
    if(circle){
      var C2 = 2 * Math.PI * 108;
      circle.style.strokeDashoffset = (C2 * (1 - pct2));
      var near = WAITING_STATES.indexOf(state.screen) !== -1 && pct2 < .25;
      circle.style.stroke = near ? "var(--warn)" : state.ringColor;
    }
    if(clock) clock.textContent = fmt(state.remaining);
  }

  function ring(innerHtml, midMarker){
    return '<div class="ring-wrap"><svg viewBox="0 0 240 240">' +
      '<circle class="ring-track" cx="120" cy="120" r="108"></circle>' +
      (midMarker ? '<circle class="ring-mark" cx="120" cy="120" r="108" stroke-dasharray="2 '+(2*Math.PI*108-2)+'" stroke-dashoffset="'+(-2*Math.PI*108*0.5)+'"></circle>' : '') +
      '<circle class="ring-fill" cx="120" cy="120" r="108" stroke-dasharray="' + (2*Math.PI*108) + '"></circle>' +
      '</svg><div class="ring-center">' + innerHtml + '</div></div>';
  }

  function catChip(cat){
    // D6.b: si el bloque está ligado a una meta, su color y nombre mandan sobre los de categoría
    var meta = state.linkedMetaId ? metaById(state.linkedMetaId) : null;
    if(meta) return '<span class="cat-chip"><span class="swatch" style="background:'+(meta.color||cat.color)+'"></span>'+meta.name+'</span>';
    return '<span class="cat-chip"><span class="swatch" style="background:'+cat.color+'"></span>'+cat.name+'</span>';
  }

  function selectHtml(id, options, current, suffix){
    return '<select id="'+id+'">' + options.map(function(n){
      return '<option value="'+n+'" '+(n===current?"selected":"")+'>'+n+(suffix||"")+'</option>';
    }).join("") + '</select>';
  }

  function activePreset(){
    return presets.find(function(p){ return p.id === state.activePresetId; }) || null;
  }

  function timeChips(field, currentValue){
    var opts = timeOptionsFor(field);
    var html = '<div class="time-chips" data-field="'+field+'">';
    opts.forEach(function(n){
      var custom = isCustomTime(field, n);
      html += '<button type="button" class="tchip'+(custom?" custom":"")+'" data-field="'+field+'" data-val="'+n+'" aria-pressed="'+(n===currentValue)+'">'+n+
        (custom ? '<span class="tchip-x" data-field="'+field+'" data-val="'+n+'" title="Quitar">×</span>' : '') +
        '</button>';
    });
    html += '<button type="button" class="tchip add" data-open-custom="'+field+'">+ Otro</button>';
    html += '</div>';
    if(state.customTimeField === field){
      html += '<div class="custom-time-row">' +
        '<input type="number" id="customTimeInput" min="1" max="'+MAX_MINUTES[field]+'" placeholder="min" value="'+currentValue+'">' +
        '<label class="ct-check"><input type="checkbox" id="customTimeSave" checked> Guardar como preset</label>' +
        '<button type="button" class="mini-btn" id="customTimeUse">Usar</button>' +
        '</div>';
      html += '<div class="note">Máximo '+ (MAX_MINUTES[field] >= 60 ? Math.round(MAX_MINUTES[field]/60) + " horas" : MAX_MINUTES[field] + " min") +'.</div>';
    }
    return html;
  }

  function render(){
    var titles = {
      setup: "Cronómetro", study_running: "Estudiando", inverso_running: "Tiempo libre",
      study_completed_waiting_response: "¿Qué sigue?", break_selection: "Elegí tu descanso",
      break_running: "Descanso", break_completed_waiting_response: "Toca estudiar",
      lunch_running: "Almuerzo", inversoDone: "Cronómetro",
      session_completed: "Sesión terminada", session_cancelled: "Bloque cancelado", session_expired: "Tiempo vencido"
    };
    topTitle.textContent = titles[state.screen] || "Cronómetro";
    rolePill.className = "role-pill" + (state.role === "espectador" ? " spectator" : "");
    roleLabel.textContent = state.role === "espectador" ? "Espectador" : "Dominante";
    speedSelect.value = String(state.speed);
    lunchCounterEl.textContent = session ? session.cyclesSinceLunch : 0;

    var html = "";
    var mode = state.cronometroType;
    var typeOfCats = typeForMode(mode);
    var cats = categoriesOf(typeOfCats);
    var lunchBtn = '<button class="btn ghost" id="requestLunch" '+(session && isLunchAvailable() ? "" : "disabled")+'>Almuerzo · '+LUNCH_MINUTES+' min</button>';

    if(state.screen === "setup"){
      html += '<div class="type-toggle">' +
        '<button class="type-btn" data-type="normal" aria-pressed="'+(mode==="normal")+'"><strong>Normal</strong>estudio con bloques y descansos</button>' +
        '<button class="type-btn" data-type="inverso" aria-pressed="'+(mode==="inverso")+'"><strong>Inverso</strong>cronómetro libre para tu ocio</button>' +
        '</div>';

      html += '<div class="state-label">'+(mode==="normal"?"Elegí qué vas a estudiar":"Elegí cómo vas a descansar")+'</div>';

      if(mode === "normal"){
        // ---- v3.1 §H1: paso 1 no excluyente — dos toggles cuadrados ----
        html += '<div class="step-block'+(state.presetOn ? " done" : "")+'">';
        html += '<div class="step-title">Paso 1 · Formato de bloques</div>';
        html += '<div class="choices">' +
          '<button class="sq-btn" id="usePresetToggle" aria-pressed="'+(state.presetOn?"true":"false")+'" type="button"><strong>Usar preset</strong>lista de formatos guardados</button>' +
          '<button class="sq-btn" id="personalizeToggle" aria-pressed="'+(state.personalizeOn?"true":"false")+'" type="button"><strong>Personalizar</strong>definir bloques a mano</button>' +
          '</div>';
        if(state.presetOn){
          html += '<div class="choices" id="presetChoices">' + presets.map(function(p){
            return '<button class="choice preset" data-preset="'+p.id+'" aria-pressed="'+(p.id===state.activePresetId)+'">'+p.name+(state.editingPresets?'<span class="preset-x" data-del-preset="'+p.id+'" title="Borrar formato">×</span>':'')+'</button>';
          }).join("") + '</div>';
          html += '<div class="presets-tools">' +
            '<button class="mini-btn" id="newPresetBtn" type="button">Crear nuevo preset</button>' +
            '<button class="mini-btn ghost" id="editPresetsBtn" type="button">'+(state.editingPresets ? "Listo" : "Editar")+'</button>' +
            '</div>';
        }
        html += '</div>';

        // ---- v3 §C2 pasos 2–4 + §C3: supermeta → meta → tarea/evento (botones cuadrados que se desvanecen, v3.1 §H3) ----
        var sg = supermetaById(state.chosenSupermetaId);
        html += '<div class="step-block'+(sg ? " done" : "")+'">';
        html += '<div class="step-title">Paso 2 · Supermeta</div>';
        html += '<div class="choices">' + SUPERMETAS.map(function(s){
          return '<button class="choice" data-supermeta="'+s.id+'" aria-pressed="'+(s.id===state.chosenSupermetaId)+'"><span class="swatch" style="background:'+s.color+'"></span>'+s.name+(s.anti?'<small>· antimeta</small>':'')+'</button>';
        }).join("") + '</div>';
        html += '</div>';
        if(sg){
          html += '<div class="step-block'+(state.chosenGoalId ? " done" : "")+'">';
          html += '<div class="step-title">Paso 3 · Meta de «'+sg.name+'»</div>';
          html += '<div class="choices">' + sg.goals.map(function(g){
            return '<button class="choice" data-goal="'+g.id+'" aria-pressed="'+(g.id===state.chosenGoalId)+'">'+g.name+'</button>';
          }).join("") + '</div>';
          html += '</div>';
          var goal = goalById(sg, state.chosenGoalId);
          if(goal){
            html += '<div class="step-block'+(state.blockKind ? " done" : "")+'">';
            html += '<div class="step-title">Paso 4 · ¿Cómo califica este bloque?</div>';
            html += '<div class="choices">' +
              '<button class="choice" data-kind="evento" aria-pressed="'+(state.blockKind==="evento")+'">Evento</button>' +
              '<button class="choice" data-kind="tarea" aria-pressed="'+(state.blockKind==="tarea")+'">Tarea</button>' +
              '</div>';
            html += '</div>';
            if(state.blockKind === "evento"){
              html += '<div class="choices">' + goal.eventos.map(function(ev){
                return '<button class="choice" data-evento="'+ev.id+'" aria-pressed="'+(ev.id===state.chosenTargetId)+'"><span class="swatch" style="background:'+sg.color+'"></span>'+ev.name+'<small>'+ev.when+'</small></button>';
              }).join("") + '</div>';
              html += '<div class="helper">Confirma “estoy cumpliendo este evento” definido en tu meta y en tu calendario (v3 §C3).</div>';
            }
            if(state.blockKind === "tarea"){
              html += '<div class="choices">' + goal.tareas.map(function(t){
                return '<button class="choice" data-tarea="'+t.id+'" aria-pressed="'+(t.id===state.chosenTargetId)+'">'+t.name+'<small>objetivo '+fmtMin(t.targetSeconds||0)+'</small></button>';
              }).join("") + '</div>';
              html += '<div class="helper">El tiempo se registra de forma exacta a esta tarea atemporal (v3 §C3). Si superas el objetivo el bloque no se corta: queda exceso en estadísticas y el puntaje se gana al llegar al objetivo (v3 §C4).</div>';
            }
          } else if(sg.anti){
            html += '<div class="helper">La antimeta no tiene metas: el tiempo queda registrado sin puntaje (v3 §A7).</div>';
          }
        }
      } else {
        // v3.1 §K1: las categorías no existen — el inverso se registra solo en la antimeta (categoría invisible, un solo color)
        html += '<div class="choices"><button class="choice" data-supermeta="antimeta" aria-pressed="'+(state.chosenSupermetaId==="antimeta")+'"><span class="swatch" style="background:#9C4A3A"></span>Antimeta<small>categoría invisible · sin puntaje</small></button></div>';
      }

      if(mode === "normal"){
        if(state.personalizeOn){ // v3.1 §H1: panel de personalización del toggle cuadrado
          html += '<div class="settings-block" style="width:100%">';
          html += '<div class="settings-group"><div class="grow"><span class="glabel">Duración de estudio (min)</span></div>' + timeChips("study", config.studyMinutes) + '</div>';
          html += '<div class="settings-group"><div class="grow"><span class="glabel">Descanso corto (min)</span></div>' + timeChips("short", config.shortBreakMinutes) + '</div>';
          html += '<div class="settings-group"><div class="grow"><span class="glabel">Descanso largo (min)</span><span class="gcontrols">cada ' + selectHtml("cyclesBeforeLongSelect", CYCLES_BEFORE_LONG_OPTIONS, config.cyclesBeforeLongBreak, " ciclos") + '</span></div>' + timeChips("long", config.longBreakMinutes) + '</div>';
          html += '</div>';

          var ap = activePreset();
          if(state.showSaveForm){
            html += '<div class="save-row">' +
              '<input type="text" id="presetNameInput" placeholder="Nombre del formato" maxlength="24" value="'+(ap?ap.name:"")+'">' +
              '<button class="mini-btn" id="confirmSave" type="button">Guardar</button>' +
              '<button class="mini-btn ghost" id="cancelSave" type="button">Cancelar</button>' +
              '</div>';
          } else if(ap){
            html += '<div class="save-actions"><span class="editing-tag">Editando «'+ap.name+'»</span>' +
              '<button class="btn ghost" id="updatePreset" type="button">Actualizar</button>' +
              '<button class="btn ghost" id="showSaveForm" type="button">Guardar como nuevo</button></div>';
          } else {
            html += '<button class="btn ghost" id="showSaveForm" type="button">Guardar este formato</button>';
          }
        }
      } else {
        html += '<div class="settings-block">';
        html += '<div class="settings-group"><div class="grow"><span class="glabel">Duración objetivo (min)</span></div>' + timeChips("inverso", config.inversoMinutes) + '</div>';
        html += '</div>';
        html += '<div class="helper">Sigue corriendo después del objetivo, hasta el doble como tope. Podés terminar cuando quieras, sin perder nada.</div>';
      }

      html += '<div class="actions"><button class="btn primary" id="startBtn">'+(mode==="normal"?"Iniciar bloque":"Iniciar tiempo libre")+'</button></div>';
    }

    if(state.screen === "inverso_running"){
      html += '<div class="state-label">Tiempo libre</div>';
      if(state.category) html += catChip(state.category);
      html += ring('<span class="clock">'+fmt(state.elapsed)+'</span><span class="clock-sub">'+(state.metaFlashed?"¡meta cumplida! sigue corriendo":"objetivo "+config.inversoMinutes+" min")+'</span>', true);
      html += '<div class="actions"><button class="btn primary" id="finishInverso">Finalizar</button></div>';
    }

    if(state.screen === "study_running" || state.screen === "break_running" || state.screen === "lunch_running"){
      var label = state.screen === "study_running" ? "Estudiando" : state.screen === "lunch_running" ? "Almuerzo" : "Descanso";
      html += '<div class="state-label">'+label+'</div>';
      if(state.screen === "study_running" && state.category) html += catChip(state.category);
      html += ring('<span class="clock">'+fmt(state.remaining)+'</span><span class="clock-sub">'+fmtMin(state.total)+'</span>');
      html += '<div class="actions">';
      if(state.screen !== "lunch_running") html += lunchBtn;
      html += '<button class="btn danger-ghost" id="cancelBtn">Cancelar bloque</button>';
      html += '</div>';
    }

    if(state.screen === "study_completed_waiting_response"){
      html += '<div class="state-label">¡Bloque terminado!</div>';
      html += '<div class="helper stakes">Si no respondés a tiempo se pierde el tiempo de este bloque.</div>';
      html += ring('<span class="clock">'+fmt(state.remaining)+'</span><span class="clock-sub">para responder</span>');
      html += '<div class="actions"><button class="btn primary" id="ackStudy">Seguir</button>' + lunchBtn + '<button class="btn danger-ghost" id="cancelBtn">Cancelar bloque</button></div>';
    }

    if(state.screen === "break_selection"){
      var granted = computeGrantedBreakSeconds(session.cyclesCompleted);
      var available = session.bankRemainingSeconds + granted;
      html += '<div class="helper stakes">Si no respondés a tiempo se pierde el tiempo de este bloque.</div>';
      html += ring('<span class="clock">'+fmt(state.remaining)+'</span><span class="clock-sub">para elegir</span>');
      html += '<div class="helper">Banco disponible: '+fmtMin(available)+'.</div>';
      html += '<div class="actions">';
      if(granted > 0) html += '<button class="btn primary" id="pickSuggested">Tomar descanso · '+fmtMin(granted)+'</button>';
      if(state.customBreakOpen){
        html += '<div class="custom-time-row"><input type="number" id="customBreakInput" min="0" max="'+Math.floor(available/60)+'" placeholder="min" value="0"><button class="mini-btn" id="useCustomBreak" type="button">Usar</button></div>';
      } else {
        html += '<button class="btn secondary" id="openCustomBreak">Personalizado (0–'+Math.floor(available/60)+' min)</button>';
      }
      html += '<button class="btn secondary" id="skipBreakBtn">Saltar</button>';
      html += lunchBtn;
      html += '<button class="btn ghost" id="endSessionBtn">Terminar sesión</button>';
      html += '</div>';
    }

    if(state.screen === "break_completed_waiting_response"){
      html += '<div class="state-label">Toca estudiar</div>';
      html += '<div class="helper stakes">Si no respondés a tiempo se pierde el tiempo de este bloque.</div>';
      html += ring('<span class="clock">'+fmt(state.remaining)+'</span><span class="clock-sub">para responder</span>');
      html += '<div class="actions"><button class="btn primary" id="continueStudy">Empezar bloque</button>' + lunchBtn + '<button class="btn ghost" id="endSessionBtn">Terminar sesión</button></div>';
    }

    if(state.screen === "inversoDone"){
      html += '<div class="state-label">Tiempo libre registrado</div>';
      html += '<div class="helper">'+fmt(state.finalElapsed)+' de '+(state.category?state.category.name:"ocio")+'.</div>';
      html += '<div class="actions"><button class="btn primary" id="backToSetup">Volver a empezar</button></div>';
    }

    if(state.screen === "session_completed"){
      html += '<div class="state-label">Sesión terminada</div>';
      html += '<div class="helper">Tiempo efectivo de estudio: '+fmtMin(session.effectiveStudySeconds)+'.</div>';
      if(session.link) html += '<div class="helper">Cada bloque quedó registrado como cuadro en el calendario «'+session.link.calendar+'»'+(session.link.ownCalendar ? ' — creado desde la supermeta, con su color' : '')+' (v3 §D).</div>';
      html += '<div class="actions"><button class="btn primary" id="backToSetup">Volver a empezar</button></div>';
    }

    if(state.screen === "session_cancelled"){
      html += '<div class="state-label">Bloque cancelado</div>';
      html += '<div class="helper">Se descartó el bloque en curso. Tiempo efectivo conservado: '+fmtMin(session.effectiveStudySeconds)+'.</div>';
      html += '<div class="actions"><button class="btn primary" id="backToSetup">Volver a empezar</button></div>';
    }

    if(state.screen === "session_expired"){
      html += '<div class="state-label">Se pasó el tiempo</div>';
      html += '<div class="helper">No respondiste a tiempo. Tiempo efectivo conservado: '+fmtMin(session.effectiveStudySeconds)+'.</div>';
      html += '<div class="actions"><button class="btn primary" id="backToSetup">Volver a empezar</button></div>';
    }

    stage.innerHTML = html;
    renderRing();
    wire();
  }

  function applyPresetValues(p){
    state.category = CATEGORIES.find(function(c){ return c.id === p.categoryId; }) || state.category;
    config.studyMinutes = p.studyMinutes;
    config.shortBreakMinutes = p.shortBreakMinutes;
    config.longBreakMinutes = p.longBreakMinutes;
    config.cyclesBeforeLongBreak = p.cyclesBeforeLongBreak;
    state.activePresetId = p.id;
  }

  function wire(){
    var el;
    document.querySelectorAll(".type-btn").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.cronometroType = btn.dataset.type;
        var cats = categoriesOf(typeForMode(state.cronometroType));
        state.category = cats[0] || null;
        state.activePresetId = null;
        state.linkedMetaId = null;
        state.showNewCat = false;
        state.customTimeField = null;
        state.presetOn = false;        // v3.1 §H2: cambiar de pestaña dentro del cronómetro descarta el progreso
        state.personalizeOn = false;
        state.editingPresets = false;
        state.showSaveForm = false;
        state.chosenSupermetaId = null;
        state.chosenGoalId = null;
        state.blockKind = null;
        state.chosenTargetId = null;
        render();
      });
    });

    // ---- v3 §C2/§C3: handlers del flujo por pasos ----
    // ---- v3.1 §H1–H2: toggles cuadrados del paso 1 y gestión de presets ----
    if(el = document.getElementById("usePresetToggle")) el.addEventListener("click", function(){
      state.presetOn = !state.presetOn;
      if(!state.presetOn) state.showSaveForm = false; // salir del modo preset descarta el preset en creación
      render();
    });
    if(el = document.getElementById("personalizeToggle")) el.addEventListener("click", function(){
      state.personalizeOn = !state.personalizeOn;
      if(!state.personalizeOn) state.showSaveForm = false;
      render();
    });
    if(el = document.getElementById("newPresetBtn")) el.addEventListener("click", function(){
      state.personalizeOn = true; state.showSaveForm = true; // misma redirección que el panel de personalización
      render();
      var inp = document.getElementById("presetNameInput"); if(inp) inp.focus();
    });
    if(el = document.getElementById("editPresetsBtn")) el.addEventListener("click", function(){
      state.editingPresets = !state.editingPresets; render();
    });
    if(el = document.getElementById("startBtn")) el.addEventListener("click", function(){
      state.cronometroType === "inverso" ? startInverso() : startSession();
    });
    document.querySelectorAll("[data-supermeta]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.chosenSupermetaId = btn.dataset.supermeta;
        state.chosenGoalId = null; state.blockKind = null; state.chosenTargetId = null;
        render();
      });
    });
    document.querySelectorAll("[data-goal]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.chosenGoalId = btn.dataset.goal;
        state.blockKind = null; state.chosenTargetId = null;
        render();
      });
    });
    document.querySelectorAll("[data-kind]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.blockKind = btn.dataset.kind; state.chosenTargetId = null; render();
      });
    });
    document.querySelectorAll("[data-evento]").forEach(function(btn){
      btn.addEventListener("click", function(){ state.chosenTargetId = btn.dataset.evento; render(); });
    });
    document.querySelectorAll("[data-tarea]").forEach(function(btn){
      btn.addEventListener("click", function(){ state.chosenTargetId = btn.dataset.tarea; render(); });
    });

    if(el = document.getElementById("startBtn")) el.addEventListener("click", function(){
      state.cronometroType === "inverso" ? startInverso() : startSession();
    });
    if(el = document.getElementById("finishInverso")) el.addEventListener("click", finishInverso);
    if(el = document.getElementById("cancelBtn")) el.addEventListener("click", openCancelSheet);
    if(el = document.getElementById("requestLunch")) el.addEventListener("click", requestLunch);
    if(el = document.getElementById("ackStudy")) el.addEventListener("click", ackStudyFinished);
    if(el = document.getElementById("pickSuggested")) el.addEventListener("click", chooseSuggestedBreak);
    if(el = document.getElementById("skipBreakBtn")) el.addEventListener("click", skipBreak);
    if(el = document.getElementById("endSessionBtn")) el.addEventListener("click", endSession);
    if(el = document.getElementById("continueStudy")) el.addEventListener("click", continueStudy);
    if(el = document.getElementById("backToSetup")) el.addEventListener("click", function(){ session = null; goto("setup"); });

    if(el = document.getElementById("openCustomBreak")) el.addEventListener("click", function(){
      state.customBreakOpen = true; render();
      var inp = document.getElementById("customBreakInput"); if(inp) inp.focus();
    });
    if(el = document.getElementById("useCustomBreak")) el.addEventListener("click", function(){
      var inp = document.getElementById("customBreakInput");
      var mins = Math.round(Number(inp && inp.value));
      var max = Number(inp && inp.max);
      if(isNaN(mins) || mins < 0) return;
      mins = Math.min(mins, max);
      state.customBreakOpen = false;
      chooseCustomBreak(mins * 60);
    });

    if(el = document.getElementById("cyclesBeforeLongSelect")) el.addEventListener("change", function(){ config.cyclesBeforeLongBreak = Number(el.value); render(); });

    document.querySelectorAll(".tchip[data-val]").forEach(function(chip){
      chip.addEventListener("click", function(e){
        if(e.target.classList.contains("tchip-x")) return;
        config[TIME_FIELD_TO_CONFIG[chip.dataset.field]] = Number(chip.dataset.val);
        state.customTimeField = null;
        render();
      });
    });
    document.querySelectorAll(".tchip-x").forEach(function(x){
      x.addEventListener("click", function(e){
        e.stopPropagation();
        var field = x.dataset.field, val = Number(x.dataset.val);
        customTimes[field] = customTimes[field].filter(function(n){ return n !== val; });
        saveCustomTimes();
        render();
      });
    });
    document.querySelectorAll("[data-open-custom]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.customTimeField = btn.dataset.openCustom;
        render();
        var inp = document.getElementById("customTimeInput");
        if(inp){ inp.focus(); inp.select(); }
      });
    });
    if(el = document.getElementById("customTimeInput")){
      el.addEventListener("keydown", function(e){ if(e.key === "Enter"){ e.preventDefault(); applyCustomTime(); } });
    }
    if(el = document.getElementById("customTimeUse")) el.addEventListener("click", applyCustomTime);

    if(el = document.getElementById("showSaveForm")) el.addEventListener("click", function(){
      state.showSaveForm = true; render();
      var inp = document.getElementById("presetNameInput");
      if(inp) inp.focus();
    });
    if(el = document.getElementById("cancelSave")) el.addEventListener("click", function(){ state.showSaveForm = false; render(); });
    if(el = document.getElementById("confirmSave")) el.addEventListener("click", function(){ saveCurrentAsPreset(false); });
    if(el = document.getElementById("updatePreset")) el.addEventListener("click", function(){ saveCurrentAsPreset(true); });
    if(el = document.getElementById("presetNameInput")){
      el.addEventListener("keydown", function(e){
        if(e.key === "Enter"){ e.preventDefault(); saveCurrentAsPreset(false); }
      });
    }

    if(el = document.getElementById("openNewCat")) el.addEventListener("click", function(){
      state.showNewCat = true;
      state.newCatColor = lastColor || PALETTE[0];
      render();
      var inp = document.getElementById("newCatName");
      if(inp) inp.focus();
    });
    if(el = document.getElementById("cancelNewCat")) el.addEventListener("click", function(){ state.showNewCat = false; render(); });
    if(el = document.getElementById("confirmNewCat")) el.addEventListener("click", createCategory);
    if(el = document.getElementById("newCatName")){
      el.addEventListener("keydown", function(e){ if(e.key === "Enter"){ e.preventDefault(); createCategory(); } });
    }
    document.querySelectorAll("#newCatPalette button[data-color]").forEach(function(b){
      b.addEventListener("click", function(){ state.newCatColor = b.dataset.color; render(); var inp=document.getElementById("newCatName"); if(inp) inp.focus(); });
    });
    if(el = document.getElementById("newCatColorPicker")){
      el.addEventListener("change", function(){ state.newCatColor = el.value; render(); });
    }

    document.querySelectorAll("#catChoices [data-cat]").forEach(function(btn){
      btn.addEventListener("click", function(){
        state.category = CATEGORIES.find(function(c){ return c.id === btn.dataset.cat; });
        state.linkedMetaId = null; // cambiar de categoría a mano invalida cualquier meta vinculada
        render();
      });
    });
    // (v3 §C) el select de meta vinculada fue reemplazado por los pasos supermeta → meta → tarea/evento
    document.querySelectorAll("#presetChoices [data-preset]").forEach(function(btn){
      btn.addEventListener("click", function(e){
        if(e.target.classList.contains("preset-x")) return;
        var p = presets.find(function(pp){ return pp.id === btn.dataset.preset; });
        if(!p) return;
        applyPresetValues(p);
        render();
      });
    });
    document.querySelectorAll("#presetChoices .preset-x").forEach(function(x){
      x.addEventListener("click", function(e){
        e.stopPropagation();
        presets = presets.filter(function(p){ return p.id !== x.dataset.delPreset; });
        if(state.activePresetId === x.dataset.delPreset) state.activePresetId = null;
        savePresets(presets);
        render();
      });
    });
  }

  function applyCustomTime(){
    var field = state.customTimeField;
    if(!field) return;
    var inp = document.getElementById("customTimeInput");
    var checkbox = document.getElementById("customTimeSave");
    var val = Math.round(Number(inp && inp.value));
    if(!val || val < 1) return;
    val = Math.min(val, MAX_MINUTES[field]);
    config[TIME_FIELD_TO_CONFIG[field]] = val;
    if(checkbox && checkbox.checked && isCustomTime(field, val) && customTimes[field].indexOf(val) === -1){
      customTimes[field].push(val);
      saveCustomTimes();
    }
    state.customTimeField = null;
    render();
  }

  function createCategory(){
    var inp = document.getElementById("newCatName");
    var name = inp && inp.value.trim();
    if(!name) return;
    var cat = {
      id: "c" + Date.now() + Math.random().toString(36).slice(2, 6),
      name: name, color: state.newCatColor, type: typeForMode(state.cronometroType)
    };
    CATEGORIES.push(cat);
    saveCategories();
    lastColor = cat.color;
    saveLastColor(lastColor);
    state.category = cat;
    state.showNewCat = false;
    render();
  }

  function saveCurrentAsPreset(updateInPlace){
    var inp = document.getElementById("presetNameInput");
    var typedName = inp && inp.value.trim();
    var data = {
      categoryId: state.category ? state.category.id : null, // v3 §A2: en modo normal ya no hay categorías
      studyMinutes: config.studyMinutes,
      shortBreakMinutes: config.shortBreakMinutes,
      longBreakMinutes: config.longBreakMinutes,
      cyclesBeforeLongBreak: config.cyclesBeforeLongBreak
    };
    if(updateInPlace && state.activePresetId){
      var existing = activePreset();
      if(existing) Object.assign(existing, data);
    } else {
      var name = typedName || ("Formato " + (presets.length + 1));
      var preset = Object.assign({ id: "p" + Date.now() + Math.random().toString(36).slice(2, 6), name: name }, data);
      presets.push(preset);
      state.activePresetId = preset.id;
    }
    savePresets(presets);
    state.showSaveForm = false;
    render();
  }

  function openCancelSheet(){ // T14/T15/T16 — doble confirmación 15s+15s, corre en paralelo a la ventana de respuesta si la hay
    var phase = 1; // 1 = primera espera, 2 = segunda espera (tras el primer toque)
    var unlocked = false;
    var seconds = CANCEL_CONFIRM_WINDOW_SECONDS;
    var wrap = document.createElement("div");
    wrap.className = "overlay";
    wrap.innerHTML = '<div class="sheet">' +
      '<h2>¿Cancelar bloque?</h2>' +
      '<p>Se pierde el tiempo del bloque en curso. Los bloques anteriores ya completados se conservan. No se puede deshacer.</p>' +
      '<button class="btn secondary" id="keepGoing">No, seguir estudiando</button>' +
      '<button class="btn primary" style="background:var(--danger);color:var(--accent-ink)" id="confirmCancel" disabled>Esperá '+seconds+'s…</button>' +
      '</div>';
    document.body.appendChild(wrap);
    var confirmBtn = wrap.querySelector("#confirmCancel");
    var last = Date.now();
    var countdown = setInterval(function(){
      if(unlocked) return;
      var now = Date.now();
      seconds -= (now - last) / 1000 * state.speed;
      last = now;
      if(seconds <= 0){
        unlocked = true;
        confirmBtn.disabled = false;
        confirmBtn.textContent = phase === 1 ? "Sí, cancelar" : "¿Seguro? Sí, cancelar";
      } else {
        confirmBtn.textContent = "Esperá " + Math.ceil(seconds) + (phase === 2 ? "s más…" : "s…");
      }
    }, 100);
    function cleanup(){ clearInterval(countdown); wrap.remove(); activeCancelCleanup = null; }
    activeCancelCleanup = cleanup;
    wrap.querySelector("#keepGoing").addEventListener("click", cleanup);
    confirmBtn.addEventListener("click", function(){
      if(!unlocked) return;
      if(phase === 1){
        phase = 2; unlocked = false; seconds = CANCEL_CONFIRM_WINDOW_SECONDS; last = Date.now();
        confirmBtn.disabled = true;
        confirmBtn.textContent = "Esperá " + seconds + "s más…";
        return;
      }
      cleanup();
      goto("session_cancelled");
    });
  }

  function openConflictSheet(){
    var wrap = document.createElement("div");
    wrap.className = "overlay";
    wrap.innerHTML = '<div class="sheet">' +
      '<h2>Otro dispositivo quiere el control</h2>' +
      '<p>Solo un dispositivo puede iniciar o modificar el bloque a la vez. El que confirme primero queda como dominante; el otro pasa a espectador (puede seguir viendo el conteo).</p>' +
      '<button class="btn secondary" id="keepControl">Mantener el control acá</button>' +
      '<button class="btn primary" id="giveControl">Ceder el control</button>' +
      '</div>';
    document.body.appendChild(wrap);
    wrap.querySelector("#keepControl").addEventListener("click", function(){ wrap.remove(); });
    wrap.querySelector("#giveControl").addEventListener("click", function(){
      wrap.remove();
      state.role = "espectador";
      render();
    });
  }

  speedSelect.addEventListener("change", function(){ state.speed = Number(speedSelect.value); });
  document.getElementById("resetLunch").addEventListener("click", function(){ if(session) session.cyclesSinceLunch = 0; render(); });
  document.getElementById("simConflict").addEventListener("click", openConflictSheet);
  document.getElementById("skipTimer").addEventListener("click", function(){
    if(state.screen === "inverso_running"){
      state.elapsed = Math.max(state.elapsed, state.targetSeconds - 0.2);
    } else if(state.tickHandle){
      state.remaining = 0.05;
    }
  });

  render();
})();
</script>
</file>

