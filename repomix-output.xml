<file path="00-vision/visto-bueno-concepto.html">
<title>Visto Bueno</title>
<style>
  :root{
    --paper: #EFEDE5; --paper-raised: #FAF9F3; --ink: #20241E; --muted: #6E7368;
    --accent: #3A6B54; --accent-ink: #F3F7F1; --accent-soft: #DCE6DC;
    --rule: #D5D1C1; --rule-strong: #B9B4A0; --danger: #9C4A3A; --focus: #3A6B54;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper: #14170F; --paper-raised: #1B1F16; --ink: #E9E7DC; --muted: #949A88;
      --accent: #7BB596; --accent-ink: #10241A; --accent-soft: #223429;
      --rule: #2B3225; --rule-strong: #3C4433; --danger: #D08871; --focus: #7BB596;
    }
  }
  :root[data-theme="dark"]{
    --paper: #14170F; --paper-raised: #1B1F16; --ink: #E9E7DC; --muted: #949A88;
    --accent: #7BB596; --accent-ink: #10241A; --accent-soft: #223429;
    --rule: #2B3225; --rule-strong: #3C4433; --danger: #D08871; --focus: #7BB596;
  }
  *{ box-sizing: border-box; }
  body{ background: var(--paper); color: var(--ink); font-family: "Archivo", ui-sans-serif, system-ui, sans-serif; line-height: 1.55; }
  .page{ max-width: 760px; margin: 0 auto; padding: 48px 24px 100px; }

  h1{ font-family: "Fraunces", Georgia, serif; font-weight: 480; font-size: clamp(30px,5vw,42px); text-wrap: balance; margin: 0 0 8px; }
  .kicker{ font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 12px; color: var(--accent); margin-bottom: 10px; }
  .lede{ color: var(--muted); max-width: 62ch; font-size: 15.5px; margin: 0 0 40px; }

  h2{ font-family: "Fraunces", Georgia, serif; font-weight: 480; font-size: 22px; margin: 56px 0 6px; padding-bottom: 10px; border-bottom: 1px solid var(--rule); }
  h2 .n{ font-family: "IBM Plex Mono", monospace; font-size: 13px; color: var(--muted); margin-right: 10px; }
  h3{ font-family: "Archivo", sans-serif; font-weight: 600; font-size: 14.5px; margin: 22px 0 8px; }
  p{ margin: 0 0 12px; max-width: 66ch; }
  ul{ margin: 0 0 14px; padding-left: 20px; }
  li{ margin-bottom: 6px; max-width: 62ch; }
  code{ font-family: "IBM Plex Mono", monospace; font-size: .88em; background: var(--accent-soft); padding: 1px 5px; border-radius: 3px; }

  .card{
    display: flex; align-items: center; justify-content: space-between; gap: 14px;
    border: 1px solid var(--rule-strong); border-radius: 12px; padding: 16px 18px;
    background: var(--paper-raised); margin: 14px 0 20px;
  }
  .card .info strong{ font-family: "Fraunces", Georgia, serif; font-size: 16px; font-weight: 500; display: block; margin-bottom: 3px; }
  .card .info span{ font-size: 12.5px; color: var(--muted); }
  .card a{
    font-family: "IBM Plex Mono", monospace; font-size: 12px; color: var(--accent);
    border: 1px solid var(--accent); border-radius: 20px; padding: 7px 14px; text-decoration: none; white-space: nowrap;
  }
  .card a:hover{ background: var(--accent); color: var(--accent-ink); }

