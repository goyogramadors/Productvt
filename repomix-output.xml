<div class="app">
  <header class="topbar">
    <div class="crumbs" id="crumbs"></div>
    <div class="controls">
      <span class="theme-picker" id="themePicker"></span>
      <button class="mini-btn" id="skinOfViewBtn" type="button" hidden>Skin de esta galaxia</button>
      <button class="mini-btn" id="resetLayoutBtn" type="button">Restablecer orden</button>
    </div>
  </header>
  <canvas id="sky"></canvas>
  <div class="hint">Arrastrá un planeta para moverlo · tocá una supermeta para entrar en su subgalaxia · tocá una meta simple para personalizarla</div>
</div>

<div id="sheetRoot"></div>
<div class="toast" id="toast"></div>

<script>
(function(){
  var THEMES = [
    { id:"crema",   name:"Papel crema",  paper:"#EFEDE5", ink:"#20241E", accent:"#3A6B54", muted:"#6E7368", rule:"#D5D1C1" },
    { id:"pergamino", name:"Pergamino",  paper:"#E8DEC4", ink:"#3B2C1A", accent:"#8A5A2B", muted:"#8A7A5C", rule:"#CBBB90" },
    { id:"anil",    name:"Tinta añil",   paper:"#E4E6ED", ink:"#1C2340", accent:"#35468C", muted:"#6A6F87", rule:"#C7CBDA" },
    { id:"musgo",   name:"Musgo",        paper:"#E9ECE2", ink:"#212B1C", accent:"#4C7A3E", muted:"#737F68", rule:"#CBD3BE" },
    { id:"noche",   name:"Papel noche",  paper:"#171A22", ink:"#E7E5DA", accent:"#7BA6B5", muted:"#8892A0", rule:"#2B3040" }
  ];
  var SKINS = [
    { id:"liso", name:"Liso", locked:false },
    { id:"anillado", name:"Anillado", locked:false },
    { id:"rayado", name:"Rayado", locked:false },
    { id:"puntillado", name:"Puntillado", locked:true },
    { id:"cometa", name:"Cometa", locked:true }
  ];
  var METAS = {
    "calc":     { name:"Dominar Cálculo", isSuper:true },
    "calc-1":   { name:"20h de práctica", parent:"calc" },
    "calc-2":   { name:"Aprobar el parcial", parent:"calc", status:"completed" },
    "calc-3":   { name:"Resolver 50 ejercicios", parent:"calc" },
    "lectura":  { name:"Hábito de lectura", isSuper:true },
    "lectura-1":{ name:"Leer 12 libros este año", parent:"lectura" },
    "lectura-2":{ name:"30 min diarios", parent:"lectura", status:"failed" },
    "ingles":   { name:"Aprender inglés", isSuper:true },
    "ingles-1": { name:"B2 en 6 meses", parent:"ingles" },
    "ingles-2": { name:"Practicar speaking 3×/semana", parent:"ingles" },
    "meditar":  { name:"Meditar 10 min diarios" }
  };

  var STORE_KEY = "productvt-galaxia-metas-v1";
  var store = loadStore();
  function loadStore(){
    try{
      var raw = localStorage.getItem(STORE_KEY);
      return raw ? JSON.parse(raw) : { positions:{}, themeByView:{}, skinByMeta:{} };
    }catch(e){ return { positions:{}, themeByView:{}, skinByMeta:{} }; }
  }
  function persist(){ try{ localStorage.setItem(STORE_KEY, JSON.stringify(store)); }catch(e){} }

  var reducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var systemDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;

  var canvas = document.getElementById("sky");
  var ctx = canvas.getContext("2d");
  var crumbsEl = document.getElementById("crumbs");
  var themePickerEl = document.getElementById("themePicker");
  var resetBtn = document.getElementById("resetLayoutBtn");
  var skinOfViewBtn = document.getElementById("skinOfViewBtn");
  var toastEl = document.getElementById("toast");

  var viewStack = [{ id: "root", name: "Galaxia principal" }];
  var nodes = [];
  var stars = [];
  var dragging = null;
  var pointerDownPos = null;
  var moved = 0;
  var dpr = Math.max(1, window.devicePixelRatio || 1);

  function currentViewId(){ return viewStack[viewStack.length - 1].id; }

  function childrenOf(viewId){
    var ids = [];
    for(var id in METAS){
      var m = METAS[id];
      if(viewId === "root" ? !m.parent : m.parent === viewId) ids.push(id);
    }
    return ids;
  }

  function themeForView(viewId){
    var idx = store.themeByView[viewId];
    if(idx === undefined){
      idx = (viewId === "root" && systemDark) ? 4 : 0;
    }
    return THEMES[idx] || THEMES[0];
  }

  function applyTheme(theme){
    var r = document.documentElement.style;
    r.setProperty("--paper", theme.paper);
    r.setProperty("--ink", theme.ink);
    r.setProperty("--accent", theme.accent);
    r.setProperty("--muted", theme.muted);
    r.setProperty("--rule", theme.rule);
    r.setProperty("--focus", theme.accent);
  }

  function resizeCanvas(){
    var rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = rect.height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    seedStars();
  }
  window.addEventListener("resize", resizeCanvas);

  function seedStars(){
    var rect = canvas.getBoundingClientRect();
    stars = [];
    var count = Math.floor((rect.width * rect.height) / 9000);
    for(var i=0;i<count;i++){
      stars.push({
        x: Math.random() * rect.width,
        y: Math.random() * rect.height,
        r: Math.random() * 1.2 + .3,
        phase: Math.random() * Math.PI * 2
      });
    }
  }

  function defaultPosFor(index, total, rect){
    var golden = 137.5 * Math.PI / 180;
    var angle = index * golden;
    var radius = 26 * Math.sqrt(index + 1);
    var maxR = Math.min(rect.width, rect.height) * 0.38;
    radius = Math.min(radius, maxR);
    return { x: rect.width/2 + Math.cos(angle) * radius, y: rect.height/2 + Math.sin(angle) * radius };
  }

  function buildView(){
    var viewId = currentViewId();
    var rect = canvas.getBoundingClientRect();
    var ids = childrenOf(viewId);
    var overrides = store.positions[viewId] || {};
    nodes = ids.map(function(id, i){
      var meta = METAS[id];
      var def = defaultPosFor(i, ids.length, rect);
      var pos = overrides[id];
      var x = pos ? pos.x * rect.width : def.x;
      var y = pos ? pos.y * rect.height : def.y;
      var kidCount = meta.isSuper ? childrenOf(id).length : 0;
      return {
        id: id, name: meta.name, isSuper: !!meta.isSuper, kidCount: kidCount,
        x: x, y: y, vx: 0, vy: 0, homeX: x, homeY: y,
        r: meta.isSuper ? 26 : 18,
        skin: store.skinByMeta[id] || "liso",
        status: meta.status || "activa"
      };
    });
    applyTheme(themeForView(viewId));
    renderCrumbs();
    renderThemePicker();
    skinOfViewBtn.hidden = viewId === "root";
    resizeCanvas();
  }

  function renderCrumbs(){
    crumbsEl.innerHTML = "";
    viewStack.forEach(function(v, i){
      if(i > 0){
        var sep = document.createElement("span");
        sep.className = "sep"; sep.textContent = "›";
        crumbsEl.appendChild(sep);
      }
      var btn = document.createElement("button");
      btn.type = "button";
      btn.textContent = v.name;
      if(i < viewStack.length - 1){
        btn.addEventListener("click", function(){
          viewStack = viewStack.slice(0, i + 1);
          buildView();
        });
      }
      crumbsEl.appendChild(btn);
    });
  }

  function renderThemePicker(){
    var viewId = currentViewId();
    var activeIdx = store.themeByView[viewId] !== undefined ? store.themeByView[viewId] : (viewId === "root" && systemDark ? 4 : 0);
    themePickerEl.innerHTML = "";
    THEMES.forEach(function(t, i){
      var b = document.createElement("button");
      b.className = "swatch-btn" + (i === activeIdx ? " active" : "");
      b.style.background = t.paper;
      b.style.boxShadow = "inset 0 0 0 1px " + t.rule;
      b.title = t.name;
      b.type = "button";
      b.addEventListener("click", function(){
        store.themeByView[viewId] = i;
        persist();
        applyTheme(THEMES[i]);
        renderThemePicker();
        showToast("Fondo: " + t.name);
      });
      themePickerEl.appendChild(b);
    });
  }

  function showToast(msg){
    toastEl.textContent = msg;
    toastEl.classList.add("show");
    clearTimeout(showToast._t);
    showToast._t = setTimeout(function(){ toastEl.classList.remove("show"); }, 1600);
  }

  function cssVar(name){ return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }

  function drawPlanet(n){
    var ink = cssVar("--ink"), accent = cssVar("--accent"), paper = cssVar("--paper"), muted = cssVar("--muted"), rule = cssVar("--rule");

    if(n.status === "completed"){
      var glow = ctx.createRadialGradient(n.x, n.y, n.r*0.6, n.x, n.y, n.r*2.4);
      glow.addColorStop(0, accent + "55");
      glow.addColorStop(1, accent + "00");
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r*2.4, 0, Math.PI*2);
      ctx.fillStyle = glow;
      ctx.fill();
    }

    if(n.isSuper){
      ctx.beginPath();
      ctx.ellipse(n.x, n.y, n.r + 14, n.r + 7, Math.PI/6, 0, Math.PI*2);
      ctx.strokeStyle = rule;
      ctx.lineWidth = 1;
      ctx.setLineDash([2,3]);
      ctx.stroke();
      ctx.setLineDash([]);
    }

    var grad = ctx.createRadialGradient(n.x - n.r*0.35, n.y - n.r*0.35, n.r*0.1, n.x, n.y, n.r);
    grad.addColorStop(0, paper);
    grad.addColorStop(1, accent);
    ctx.beginPath();
    ctx.arc(n.x, n.y, n.r, 0, Math.PI*2);
    ctx.fillStyle = grad;
    ctx.fill();
    ctx.lineWidth = 1.2;
    ctx.strokeStyle = ink;
    ctx.globalAlpha = .55;
    ctx.stroke();
    ctx.globalAlpha = 1;

    ctx.save();
    ctx.beginPath();
    ctx.arc(n.x, n.y, n.r, 0, Math.PI*2);
    ctx.clip();
    if(n.skin === "rayado"){
      ctx.strokeStyle = ink; ctx.globalAlpha = .3; ctx.lineWidth = 2;
      for(var yy = n.y - n.r; yy <= n.y + n.r; yy += 5){
        ctx.beginPath(); ctx.moveTo(n.x - n.r, yy); ctx.lineTo(n.x + n.r, yy); ctx.stroke();
      }
      ctx.globalAlpha = 1;
    } else if(n.skin === "puntillado"){
      ctx.fillStyle = ink; ctx.globalAlpha = .4;
      for(var i=0;i<26;i++){
        var a = Math.random()*Math.PI*2, rr = Math.random()*n.r;
        ctx.beginPath(); ctx.arc(n.x + Math.cos(a)*rr, n.y + Math.sin(a)*rr, .8, 0, Math.PI*2); ctx.fill();
      }
      ctx.globalAlpha = 1;
    } else if(n.skin === "cometa"){
      ctx.strokeStyle = ink; ctx.globalAlpha = .25; ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(n.x - n.r*1.8, n.y + n.r*0.9); ctx.lineTo(n.x - n.r*0.4, n.y + n.r*0.1); ctx.stroke();
      ctx.globalAlpha = 1;
    }
    ctx.restore();

    if(n.status === "failed"){
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r, 0, Math.PI*2);
      ctx.fillStyle = paper;
      ctx.globalAlpha = .55;
      ctx.fill();
      ctx.globalAlpha = 1;
    }

    if(n.status === "completed" || n.status === "failed"){
      var bx = n.x - n.r*0.72, by = n.y - n.r*0.72;
      ctx.beginPath();
      ctx.arc(bx, by, 8, 0, Math.PI*2);
      ctx.fillStyle = n.status === "completed" ? accent : muted;
      ctx.fill();
      ctx.strokeStyle = ink; ctx.lineWidth = 1; ctx.stroke();
      ctx.strokeStyle = paper; ctx.lineWidth = 1.4; ctx.lineCap = "round";
      ctx.beginPath();
      if(n.status === "completed"){
        ctx.moveTo(bx-3, by); ctx.lineTo(bx-1, by+2.5); ctx.lineTo(bx+3.5, by-3);
      } else {
        ctx.moveTo(bx-2.5, by-2.5); ctx.lineTo(bx+2.5, by+2.5);
        ctx.moveTo(bx+2.5, by-2.5); ctx.lineTo(bx-2.5, by+2.5);
      }
      ctx.stroke();
    }

    if(n.isSuper){
      ctx.beginPath();
      ctx.arc(n.x + n.r*0.72, n.y - n.r*0.72, 8, 0, Math.PI*2);
      ctx.fillStyle = paper;
      ctx.fill();
      ctx.strokeStyle = ink; ctx.lineWidth = 1; ctx.stroke();
      ctx.fillStyle = ink;
      ctx.font = "500 9px 'IBM Plex Mono', monospace";
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText(String(n.kidCount), n.x + n.r*0.72, n.y - n.r*0.72 + .5);
    }

    ctx.fillStyle = ink;
    ctx.font = "italic 400 13px 'Fraunces', Georgia, serif";
    ctx.textAlign = "center"; ctx.textBaseline = "top";
    ctx.fillText(n.name, n.x, n.y + n.r + 8, 150);
  }

  function frame(t){
    var rect = canvas.getBoundingClientRect();
    var ink = cssVar("--ink"), muted = cssVar("--muted");

    ctx.clearRect(0,0,rect.width, rect.height);

    stars.forEach(function(s){
      var tw = reducedMotion ? .5 : (Math.sin(t/900 + s.phase) * .35 + .55);
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI*2);
      ctx.fillStyle = muted;
      ctx.globalAlpha = tw * .5;
      ctx.fill();
    });
    ctx.globalAlpha = 1;

    ctx.beginPath();
    ctx.arc(rect.width/2, rect.height/2, Math.min(rect.width,rect.height)*0.42, 0, Math.PI*2);
    ctx.strokeStyle = cssVar("--rule");
    ctx.globalAlpha = .5;
    ctx.stroke();
    ctx.globalAlpha = 1;

    for(var i=0;i<nodes.length;i++){
      for(var j=i+1;j<nodes.length;j++){
        var a = nodes[i], b = nodes[j];
        var dx = b.x - a.x, dy = b.y - a.y;
        var dist = Math.max(Math.hypot(dx,dy), 1);
        var minDist = a.r + b.r + 46;
        if(dist < minDist){
          var force = (minDist - dist) / minDist * 0.6;
          var fx = dx/dist * force, fy = dy/dist * force;
          if(a !== dragging){ a.vx -= fx; a.vy -= fy; }
          if(b !== dragging){ b.vx += fx; b.vy += fy; }
        }
      }
    }
    nodes.forEach(function(n){
      if(n === dragging) return;
      n.vx += (n.homeX - n.x) * 0.02;
      n.vy += (n.homeY - n.y) * 0.02;
      n.vx *= 0.85; n.vy *= 0.85;
      n.x += n.vx; n.y += n.vy;
    });

    nodes.forEach(drawPlanet);
    requestAnimationFrame(frame);
  }

  function toCanvasPoint(clientX, clientY){
    var rect = canvas.getBoundingClientRect();
    return { x: clientX - rect.left, y: clientY - rect.top };
  }

  function nodeAt(pt){
    for(var i=nodes.length-1;i>=0;i--){
      var n = nodes[i];
      if(Math.hypot(pt.x-n.x, pt.y-n.y) <= n.r + 4) return n;
    }
    return null;
  }

  canvas.addEventListener("pointerdown", function(e){
    var pt = toCanvasPoint(e.clientX, e.clientY);
    var n = nodeAt(pt);
    if(!n) return;
    dragging = n;
    pointerDownPos = pt;
    moved = 0;
    canvas.classList.add("dragging");
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener("pointermove", function(e){
    if(!dragging) return;
    var pt = toCanvasPoint(e.clientX, e.clientY);
    moved += Math.hypot(pt.x - dragging.x, pt.y - dragging.y);
    dragging.x = pt.x; dragging.y = pt.y;
    dragging.vx = 0; dragging.vy = 0;
  });
  canvas.addEventListener("pointerup", function(e){
    if(!dragging) return;
    canvas.classList.remove("dragging");
    var n = dragging;
    var rect = canvas.getBoundingClientRect();
    if(moved < 6){
      onTapNode(n);
    } else {
      n.homeX = n.x; n.homeY = n.y;
      var viewId = currentViewId();
      store.positions[viewId] = store.positions[viewId] || {};
      store.positions[viewId][n.id] = { x: n.x / rect.width, y: n.y / rect.height };
      persist();
    }
    dragging = null;
  });

  function onTapNode(n){
    if(n.isSuper){
      viewStack.push({ id: n.id, name: n.name });
      buildView();
    } else {
      openSkinSheet(n.id, n.name, false);
    }
  }

  function openSkinSheet(metaId, title, isViewSkin){
    var wrap = document.createElement("div");
    wrap.className = "overlay";
    var current = store.skinByMeta[metaId] || "liso";
    wrap.innerHTML = '<div class="sheet">' +
      '<button class="close" id="closeSheet" type="button">cerrar</button>' +
      '<h2>' + title + '</h2>' +
      '<p>Elegí cómo se ve ' + (isViewSkin ? "esta supermeta" : "este planeta") + '.</p>' +
      '<div class="skin-grid" id="skinGrid"></div>' +
      '</div>';
    document.getElementById("sheetRoot").appendChild(wrap);
    var grid = wrap.querySelector("#skinGrid");
    SKINS.forEach(function(s){
      var b = document.createElement("button");
      b.className = "skin-opt" + (s.id === current ? " active" : "") + (s.locked ? " locked" : "");
      b.type = "button";
      b.innerHTML = '<span class="preview" style="' + skinPreviewCss(s.id) + '"></span><span class="name">' + s.name + '</span>' + (s.locked ? '<span class="lock">Tienda</span>' : '');
      b.addEventListener("click", function(){
        if(s.locked){ showToast("Disponible en la Tienda (V1.1)"); return; }
        store.skinByMeta[metaId] = s.id;
        persist();
        buildView();
        wrap.remove();
      });
      grid.appendChild(b);
    });
    wrap.querySelector("#closeSheet").addEventListener("click", function(){ wrap.remove(); });
  }

  function skinPreviewCss(id){
    var accent = cssVar("--accent"), paper = cssVar("--paper"), ink = cssVar("--ink");
    if(id === "rayado") return "background:repeating-linear-gradient(" + accent + "," + accent + " 3px," + paper + " 3px," + paper + " 6px)";
    if(id === "anillado") return "background:radial-gradient(circle at 35% 35%," + paper + "," + accent + "); box-shadow: 0 0 0 2px " + ink + "22, inset 0 0 0 8px transparent;";
    if(id === "puntillado") return "background-image: radial-gradient(" + ink + "55 1px, transparent 1.5px); background-size: 5px 5px; background-color:" + accent;
    if(id === "cometa") return "background:linear-gradient(135deg," + paper + "," + accent + ")";
    return "background:radial-gradient(circle at 35% 35%," + paper + "," + accent + ")";
  }

  resetBtn.addEventListener("click", function(){
    var viewId = currentViewId();
    delete store.positions[viewId];
    persist();
    buildView();
    showToast("Orden restablecido");
  });
  skinOfViewBtn.addEventListener("click", function(){
    var viewId = currentViewId();
    openSkinSheet(viewId, viewStack[viewStack.length-1].name, true);
  });

  buildView();
  requestAnimationFrame(frame);
})();
</script>
</file>

<file path="01-mockups/mobile/estadisticas.html">
<title>Cuaderno de Progreso</title>
<style>
  :root{
    --paper: #EFEDE5; --paper-raised: #FAF9F3; --ink: #20241E; --muted: #6E7368;
    --accent: #3A6B54; --accent-ink: #F3F7F1; --accent-soft: #DCE6DC;
    --rule: #D5D1C1; --rule-strong: #B9B4A0;
    --gold: #B9812E; --danger: #9C4A3A; --focus: #3A6B54;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper: #14170F; --paper-raised: #1B1F16; --ink: #E9E7DC; --muted: #949A88;
      --accent: #7BB596; --accent-ink: #10241A; --accent-soft: #223429;
      --rule: #2B3225; --rule-strong: #3C4433;
      --gold: #D9A85C; --danger: #D08871; --focus: #7BB596;
    }
  }
  :root[data-theme="dark"]{
    --paper: #14170F; --paper-raised: #1B1F16; --ink: #E9E7DC; --muted: #949A88;
    --accent: #7BB596; --accent-ink: #10241A; --accent-soft: #223429;
    --rule: #2B3225; --rule-strong: #3C4433;
    --gold: #D9A85C; --danger: #D08871; --focus: #7BB596;
  }
  *{ box-sizing: border-box; }
  body{ background: var(--paper); color: var(--ink); font-family: "Archivo", ui-sans-serif, system-ui, sans-serif; line-height: 1.45; }

  .shell{ max-width: 460px; margin: 0 auto; padding: 20px 18px 48px; }

  h1{ font-family: "Fraunces", Georgia, serif; font-size: 22px; font-weight: 500; margin: 0 0 4px; }
  .sub{ font-size: 12.5px; color: var(--muted); margin: 0 0 18px; }

  .tabs{ display: flex; gap: 8px; margin-bottom: 18px; }
  .tab{
    flex: 1; border: 1px solid var(--rule-strong); background: var(--paper-raised); color: var(--muted);
    border-radius: 10px; padding: 9px; cursor: pointer; font-size: 13.5px; font-weight: 500;
  }
  .tab[aria-pressed="true"]{ border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }

  .tiles{ display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; margin-bottom: 22px; }
  .tile{ border: 1px solid var(--rule); border-radius: 10px; padding: 12px 10px; text-align: center; }
  .tile .val{ font-family: "IBM Plex Mono", monospace; font-size: 19px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .tile .lbl{ font-size: 10.5px; color: var(--muted); margin-top: 2px; }

  h2{ font-family: "Fraunces", Georgia, serif; font-size: 16px; font-weight: 500; margin: 28px 0 10px; }

  .sparkline{ display: flex; align-items: flex-end; gap: 4px; height: 64px; margin-bottom: 6px; }
  .spark-bar{ flex: 1; background: var(--accent-soft); border-radius: 3px 3px 0 0; position: relative; min-height: 3px; }
  .spark-bar.today{ background: var(--accent); }
  .spark-labels{ display: flex; gap: 4px; font-family: "IBM Plex Mono", monospace; font-size: 9px; color: var(--muted); }
  .spark-labels span{ flex: 1; text-align: center; }

  .bar-row{ display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .bar-row .swatch{ width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .bar-row .label{ width: 92px; font-size: 12.5px; flex: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bar-track{ flex: 1; height: 8px; background: var(--rule); border-radius: 4px; overflow: hidden; }
  .bar-fill{ height: 100%; border-radius: 4px; }
  .bar-row .amount{ width: 52px; text-align: right; font-family: "IBM Plex Mono", monospace; font-size: 11.5px; color: var(--muted); flex: none; }

  .goal-card{ border: 1px solid var(--rule); border-radius: 10px; padding: 12px 14px; margin-bottom: 10px; }
  .goal-top{ display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 13px; }
  .goal-top .name{ display: flex; align-items: center; gap: 7px; }
  .goal-top .swatch{ width: 8px; height: 8px; border-radius: 50%; }
  .goal-top .amount{ font-family: "IBM Plex Mono", monospace; font-size: 11.5px; color: var(--muted); }
  .goal-track{ height: 6px; background: var(--rule); border-radius: 3px; overflow: hidden; }
  .goal-fill{ height: 100%; border-radius: 3px; }
  .goal-fill.met{ background: var(--accent); }
  .goal-fill.partial{ background: var(--gold); }

  .star-card{
    display: flex; align-items: center; gap: 14px; border: 1px solid var(--rule); border-radius: 12px;
    padding: 16px; margin-bottom: 8px;
  }
  .star-badge{ font-size: 30px; line-height: 1; opacity: .3; }
  .star-badge.earned{ opacity: 1; }
  .star-card .text strong{ display: block; font-family: "Fraunces", Georgia, serif; font-size: 15px; font-weight: 500; }
  .star-card .text span{ font-size: 12px; color: var(--muted); }

  .empty{ font-size: 13px; color: var(--muted); text-align: center; padding: 14px 0; }
  .note{ font-size: 11px; color: var(--muted); line-height: 1.5; margin-top: 24px; border-top: 1px dashed var(--rule-strong); padding-top: 12px; }
</style>

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,380..520;1,9..144,380..520&family=Archivo:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap">

<div class="shell">
  <h1>Cuaderno de progreso</h1>
  <p class="sub" id="rangeLabel"></p>

  <div class="tabs">
    <button class="tab" data-tab="estudio" aria-pressed="true">Estudio</button>
    <button class="tab" data-tab="ocio" aria-pressed="false">Ocio</button>
  </div>

  <div id="content"></div>

  <p class="note">Datos de ejemplo generados sobre el mes actual, misma fuente que el Almanaque. Racha = días consecutivos con al menos una sesión completada. Estrella mensual: todas las semanas cerradas con al menos una meta configurada, cumplidas — un mes sin metas nunca la obtiene.</p>
</div>

<script>
(function(){
  var CATS_KEY = "productvt-categorias-v1";
  var DEFAULT_CATEGORIES = [
    { id: "mate", name: "Matemáticas", color: "#B06A3A", type: "productiva" },
    { id: "lectura", name: "Lectura", color: "#4E6E8E", type: "productiva" },
    { id: "codigo", name: "Código", color: "#7A6A9E", type: "productiva" },
    { id: "idiomas", name: "Idiomas", color: "#A85C6B", type: "productiva" },
    { id: "pantalla", name: "Pausa de pantalla", color: "#6B8F71", type: "ocio" },
    { id: "ejercicio", name: "Ejercicio", color: "#C97A2B", type: "ocio" },
    { id: "social", name: "Social", color: "#8A6FA3", type: "ocio" }
  ];
  function loadCategories(){
    try{ var raw = localStorage.getItem(CATS_KEY); return raw ? JSON.parse(raw) : DEFAULT_CATEGORIES.slice(); }
    catch(e){ return DEFAULT_CATEGORIES.slice(); }
  }
  var CATEGORIES = loadCategories();
  function catsOf(type){ return CATEGORIES.filter(function(c){ return c.type === type; }); }
  function catById(id){ return CATEGORIES.find(function(c){ return c.id === id; }); }

  var GOALS_KEY = "productvt-metas-semanales-v1";
  function loadGoals(){
    try{
      var raw = localStorage.getItem(GOALS_KEY);
      if(raw) return JSON.parse(raw);
    }catch(e){}
    var prod = catsOf("productiva");
    var seed = {};
    if(prod[0]) seed[prod[0].id] = 300;
    if(prod[2]) seed[prod[2].id] = 200;
    try{ localStorage.setItem(GOALS_KEY, JSON.stringify(seed)); }catch(e){}
    return seed;
  }
  var WEEKLY_GOALS = loadGoals(); // { categoryId: targetMinutes }

  function pad(n){ return String(n).padStart(2,"0"); }
  function iso(d){ return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate()); }
  function addDays(d, n){ var r = new Date(d); r.setDate(r.getDate()+n); return r; }
  function startOfWeek(d){ var day=(d.getDay()+6)%7; return addDays(d,-day); } // lunes

  var today = new Date();

  // ---- Sesiones de ejemplo, mismo generador determinístico que calendario.html ----
  var STATUSES = ["completed","completed","completed","cancelled","expired"];
  var demoSessions = [];
  (function seedDemo(){
    for(var d = 1; d <= today.getDate(); d++){
      var date = new Date(today.getFullYear(), today.getMonth(), d);
      var seed = (d * 7 + today.getMonth()) % 10;
      if(seed < 6){
        var cat = CATEGORIES[(d + seed) % CATEGORIES.length];
        var status = STATUSES[(d + seed) % STATUSES.length];
        var minutes = status === "completed" ? [25,50,75,100][d % 4] : [10,15,20][d % 3];
        demoSessions.push({ date: iso(date), categoryId: cat.id, status: status, minutes: minutes });
      }
      if(seed === 7){
        var cat2 = CATEGORIES[(d+2) % CATEGORIES.length];
        demoSessions.push({ date: iso(date), categoryId: cat2.id, status: "completed", minutes: 25 });
      }
    }
  })();

  function sessionsOfType(type){
    var ids = catsOf(type).map(function(c){ return c.id; });
    return demoSessions.filter(function(s){ return ids.indexOf(s.categoryId) !== -1 && s.status === "completed"; });
  }
  function minutesInRange(list, fromIso, toIso){
    return list.filter(function(s){ return s.date >= fromIso && s.date <= toIso; })
      .reduce(function(sum,s){ return sum + s.minutes; }, 0);
  }
  function computeStreak(list){
    var days = {};
    list.forEach(function(s){ days[s.date] = true; });
    var streak = 0, cursor = new Date(today);
    if(!days[iso(cursor)]) cursor = addDays(cursor, -1); // permite que hoy aún no tenga sesión
    while(days[iso(cursor)]){ streak++; cursor = addDays(cursor, -1); }
    return streak;
  }

  var content = document.getElementById("content");
  var rangeLabel = document.getElementById("rangeLabel");
  var currentTab = "estudio";

  function render(){
    var type = currentTab === "estudio" ? "productiva" : "ocio";
    var list = sessionsOfType(type);
    var weekStart = startOfWeek(today), weekEnd = addDays(weekStart, 6);
    var monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
    var weekMinutes = minutesInRange(list, iso(weekStart), iso(weekEnd));
    var monthMinutes = minutesInRange(list, iso(monthStart), iso(today));
    var sessionCount = list.filter(function(s){ return s.date >= iso(monthStart); }).length;
    var streak = computeStreak(list);

    rangeLabel.textContent = "Semana del " + weekStart.getDate() + " al " + weekEnd.getDate() + " de " +
      today.toLocaleDateString("es", { month: "long" });

    var html = "";

    html += '<div class="tiles">' +
      '<div class="tile"><div class="val">'+weekMinutes+'</div><div class="lbl">min esta semana</div></div>' +
      '<div class="tile"><div class="val">'+streak+'</div><div class="lbl">racha (días)</div></div>' +
      '<div class="tile"><div class="val">'+sessionCount+'</div><div class="lbl">sesiones este mes</div></div>' +
      '</div>';

    // sparkline 14 días
    html += '<h2>Últimos 14 días</h2>';
    var days14 = [];
    for(var i = 13; i >= 0; i--) days14.push(addDays(today, -i));
    var perDay = days14.map(function(d){ return minutesInRange(list, iso(d), iso(d)); });
    var max = Math.max.apply(null, perDay.concat([1]));
    html += '<div class="sparkline">' + perDay.map(function(m,i){
      var h = Math.max(3, Math.round((m/max)*64));
      var isToday = i === perDay.length-1;
      return '<div class="spark-bar'+(isToday?" today":"")+'" style="height:'+h+'px" title="'+m+' min"></div>';
    }).join("") + '</div>';
    html += '<div class="spark-labels">' + days14.map(function(d){ return '<span>'+d.getDate()+'</span>'; }).join("") + '</div>';

    // desglose por categoría (mes)
    html += '<h2>Por categoría (este mes)</h2>';
    var cats = catsOf(type);
    var totals = cats.map(function(c){
      return { cat: c, minutes: minutesInRange(list.filter(function(s){ return s.categoryId===c.id; }), iso(monthStart), iso(today)) };
    }).filter(function(t){ return t.minutes > 0; }).sort(function(a,b){ return b.minutes-a.minutes; });
    if(totals.length){
      var maxCat = totals[0].minutes;
      html += totals.map(function(t){
        return '<div class="bar-row"><span class="swatch" style="background:'+t.cat.color+'"></span>' +
          '<span class="label">'+t.cat.name+'</span>' +
          '<span class="bar-track"><span class="bar-fill" style="width:'+Math.round(t.minutes/maxCat*100)+'%;background:'+t.cat.color+'"></span></span>' +
          '<span class="amount">'+t.minutes+' min</span></div>';
      }).join("");
    } else {
      html += '<p class="empty">Todavía no hay sesiones completadas este mes.</p>';
    }

    if(currentTab === "estudio"){
      // metas semanales
      html += '<h2>Metas semanales</h2>';
      var prodCats = catsOf("productiva").filter(function(c){ return WEEKLY_GOALS[c.id]; });
      if(prodCats.length){
        html += prodCats.map(function(c){
          var target = WEEKLY_GOALS[c.id];
          var got = minutesInRange(list.filter(function(s){ return s.categoryId===c.id; }), iso(weekStart), iso(weekEnd));
          var pct = Math.min(100, Math.round(got/target*100));
          var met = got >= target;
          return '<div class="goal-card"><div class="goal-top"><span class="name"><span class="swatch" style="background:'+c.color+'"></span>'+c.name+'</span>' +
            '<span class="amount">'+got+' / '+target+' min</span></div>' +
            '<div class="goal-track"><span class="goal-fill '+(met?"met":"partial")+'" style="width:'+pct+'%"></span></div></div>';
        }).join("");
      } else {
        html += '<p class="empty">No hay metas configuradas todavía.</p>';
      }

      // estrella mensual
      var weeksThisMonth = [];
      var w = startOfWeek(monthStart);
      while(w <= today){
        var wEnd = addDays(w,6);
        if(wEnd < today) weeksThisMonth.push({ start: w, end: wEnd });
        w = addDays(w,7);
      }
      var hasGoals = prodCats.length > 0;
      var allMet = hasGoals && weeksThisMonth.length > 0 && weeksThisMonth.every(function(wk){
        return prodCats.every(function(c){
          var got = minutesInRange(list.filter(function(s){ return s.categoryId===c.id; }), iso(wk.start), iso(wk.end));
          return got >= WEEKLY_GOALS[c.id];
        });
      });
      var earned = hasGoals && weeksThisMonth.length > 0 && allMet;
      html += '<h2>Estrella del mes</h2>';
      html += '<div class="star-card"><span class="star-badge'+(earned?" earned":"")+'">★</span><div class="text">' +
        '<strong>'+(earned ? "¡Conseguida!" : "Todavía no")+'</strong>' +
        '<span>'+(hasGoals ? weeksThisMonth.length+" semana(s) cerrada(s) evaluada(s)" : "Configurá al menos una meta para poder ganarla")+'</span>' +
        '</div></div>';
    }

    content.innerHTML = html;
  }

  document.querySelectorAll(".tab").forEach(function(btn){
    btn.addEventListener("click", function(){
      currentTab = btn.dataset.tab;
      document.querySelectorAll(".tab").forEach(function(b){ b.setAttribute("aria-pressed", b===btn); });
      render();
    });
  });

  render();
})();
</script>
</file>

<file path="01-mockups/mobile/inicio.html">
<title>Constelación de Metas</title>
<style>
  :root{
    --paper: #EFEDE5; --paper-raised: #FAF9F3; --ink: #20241E; --muted: #6E7368;
    --accent: #3A6B54; --accent-ink: #F3F7F1; --accent-soft: #DCE6DC;
    --rule: #D5D1C1; --rule-strong: #B9B4A0; --danger: #9C4A3A; --gold: #B9812E; --focus: #3A6B54;
    /* cromo de "juego" (HUD) — deliberadamente más saturado y chunky que el resto de la app */
    --hud-bg: #16213F; --hud-bg-2: #223462; --hud-ink: #F3F1E7;
    --cr-gold: #FFB627; --cr-gold-dark: #B9740A; --cr-red: #E2543A;
    --sky-top: #3E6E8E; --sky-bottom: #17233F;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --paper: #14170F; --paper-raised: #1B1F16; --ink: #E9E7DC; --muted: #949A88;
      --accent: #7BB596; --accent-ink: #10241A; --accent-soft: #223429;
      --rule: #2B3225; --rule-strong: #3C4433; --danger: #D08871; --gold: #D9A85C; --focus: #7BB596;
    }
  }
  :root[data-theme="dark"]{
    --paper: #14170F; --paper-raised: #1B1F16; --ink: #E9E7DC; --muted: #949A88;
    --accent: #7BB596; --accent-ink: #10241A; --accent-soft: #223429;
    --rule: #2B3225; --rule-strong: #3C4433; --danger: #D08871; --gold: #D9A85C; --focus: #7BB596;
  }
  *{ box-sizing: border-box; }
  html,body{ height: 100%; }
  body{ background: var(--paper); color: var(--ink); font-family: "Archivo", ui-sans-serif, system-ui, sans-serif; overflow: hidden; }
  button{ font: inherit; }

  .app{ height: 100vh; display: flex; flex-direction: column; max-width: 460px; margin: 0 auto; }

  /* ---- barra superior: racha+moneda a la izq, amigos+config a la der (HUD oscuro tipo juego) ---- */
  .topbar{ display: flex; align-items: center; justify-content: space-between; padding: 14px 14px 8px; gap: 8px; }
  .top-cluster{ display: flex; align-items: center; gap: 8px; }
  .pill{
    display: inline-flex; align-items: center; gap: 5px; font-family: "IBM Plex Mono", monospace; font-size: 13px; font-weight: 600;
    border: 2px solid var(--hud-bg-2); background: var(--hud-bg); border-radius: 9px; padding: 6px 12px 6px 8px; color: var(--hud-ink);
    cursor: pointer; box-shadow: 0 2px 0 rgba(0,0,0,.25);
  }
  .pill.streak{ color: #FF8A5C; }
  .pill.currency{ color: var(--cr-gold); }
  .icon-btn{
    width: 34px; height: 34px; border-radius: 50%; border: 2px solid var(--hud-bg-2); background: var(--hud-bg);
    color: var(--hud-ink); cursor: pointer; font-size: 15px; display: flex; align-items: center; justify-content: center; position: relative;
    box-shadow: 0 2px 0 rgba(0,0,0,.25);
  }
  .icon-btn .badge{
    position: absolute; top: -3px; right: -3px; width: 10px; height: 10px; border-radius: 50%; background: var(--cr-gold);
    border: 1.5px solid var(--paper); display: none;
  }
  .icon-btn .badge.show{ display: block; }

  .chest-banner{
    margin: 0 14px 8px; padding: 10px 14px; border-radius: 12px; border: 2px solid var(--cr-gold-dark);
    background: linear-gradient(180deg, #3A2E10, #241a08); color: var(--cr-gold);
    display: none; align-items: center; justify-content: space-between; gap: 10px; font-size: 12.5px; cursor: pointer;
  }
  .chest-banner.show{ display: flex; }
  .chest-banner .txt strong{ display: block; font-family: "Fraunces", Georgia, serif; font-size: 14px; font-weight: 500; color: var(--hud-ink); }
  .chest-banner .go{ font-family: "IBM Plex Mono", monospace; font-size: 11px; color: var(--cr-gold); }

  /* ---- panel de la galaxia: más grande, cielo saturado, borde difuminado tipo arena de juego ---- */
  .galaxy-panel{
    margin: 0 12px; border-radius: 22px; border: 4px solid var(--hud-bg);
    background: linear-gradient(180deg, var(--sky-top), var(--sky-bottom));
    position: relative; overflow: hidden; height: 60vh; flex: none;
    box-shadow: 0 4px 16px rgba(0,0,0,.25);
  }
  canvas{ display: block; width: 100%; height: 100%; touch-action: none; cursor: grab; }
  canvas.dragging{ cursor: grabbing; }
  .vignette{
    position: absolute; inset: 0; pointer-events: none; z-index: 1;
    box-shadow: inset 0 0 60px 18px var(--sky-bottom);
  }
  .panel-topleft{ position: absolute; top: 10px; left: 12px; z-index: 2; display: flex; align-items: center; gap: 8px; }
  .panel-crumb{
    font-family: "Fraunces", Georgia, serif; font-size: 13.5px;
    color: var(--hud-ink); opacity: .85; cursor: pointer;
  }
  .edit-parent{
    font-family: "IBM Plex Mono", monospace; font-size: 10px; background: rgba(0,0,0,.3); color: var(--hud-ink);
    border: 1px solid rgba(255,255,255,.25); border-radius: 6px; padding: 3px 8px; cursor: pointer;
  }
  .theme-picker{ position: absolute; top: 10px; right: 10px; display: flex; gap: 5px; z-index: 2; }
  .swatch-btn{ width: 14px; height: 14px; border-radius: 50%; border: 2px solid transparent; cursor: pointer; padding: 0; }
  .swatch-btn.active{ border-color: var(--hud-ink); }
  .panel-bottom-row{ position: absolute; bottom: 8px; left: 10px; right: 10px; z-index: 2; display: flex; justify-content: space-between; gap: 8px; }
  .reset-corner, .standard-corner{
    font-family: "IBM Plex Mono", monospace; font-size: 10px; background: rgba(0,0,0,.3); color: var(--hud-ink);
    border: 1px solid rgba(255,255,255,.25); border-radius: 6px; padding: 4px 9px; cursor: pointer;
  }

  .spacer{ flex: 1; min-height: 6px; }

  /* ---- botón grande de acción (estilo "Batalla"), superpuesto al borde del panel ---- */
  .action-zone{ padding: 0 22px; margin-top: -22px; position: relative; z-index: 3; }
  .big-action{
    width: 100%; border: none; border-radius: 12px; padding: 15px; background: linear-gradient(180deg, #FFCF5C, var(--cr-gold));
    color: #4A2E00; font-family: "Fraunces", Georgia, serif; font-size: 19px; font-weight: 600; cursor: pointer;
    box-shadow: 0 4px 0 var(--cr-gold-dark), 0 8px 16px rgba(0,0,0,.3);
    text-shadow: 0 1px 0 rgba(255,255,255,.4);
  }
  .big-action:active{ box-shadow: 0 2px 0 var(--cr-gold-dark), 0 4px 8px rgba(0,0,0,.3); transform: translateY(2px); }
  .navbar{
    display: grid; grid-template-columns: repeat(5,1fr); border-top: 1px solid var(--rule);
    background: var(--paper); padding: 10px 2px calc(6px + env(safe-area-inset-bottom));
  }
  .navitem{
    display: flex; flex-direction: column; align-items: center; gap: 3px; background: none; border: none;
    color: var(--muted); font-size: 9px; font-family: "IBM Plex Mono", monospace; padding: 6px 1px; cursor: pointer; border-radius: 8px;
  }
  .navitem .ic{ font-size: 16px; line-height: 1; }
  .navitem:hover{ color: var(--accent); }
  .navitem.active{ color: var(--accent); }

  /* ---- overlays / sheets ---- */
  .overlay{ position: fixed; inset: 0; background: rgba(0,0,0,.35); display: flex; align-items: flex-end; justify-content: center; z-index: 30; }
  .sheet{
    background: var(--paper); border-top: 1px solid var(--rule); width: 100%; max-width: 460px;
    border-radius: 18px 18px 0 0; padding: 22px 20px 26px; display: flex; flex-direction: column; gap: 14px;
    max-height: 86vh; overflow-y: auto;
  }
  .sheet h2{ font-family: "Fraunces", Georgia, serif; font-size: 19px; font-weight: 500; margin: 0; }
  .sheet p{ font-size: 13.5px; color: var(--muted); margin: 0; line-height: 1.5; }
  .sheet .close{ align-self: flex-end; background: none; border: none; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; font-size: 13px; }

  .choice-cards{ display: flex; flex-direction: column; gap: 10px; }
  .choice-card{
    display: flex; align-items: center; gap: 14px; text-align: left; border: 1px solid var(--rule-strong);
    background: var(--paper-raised); border-radius: 8px; padding: 16px; cursor: pointer; color: var(--ink);
  }
  .choice-card:hover{ border-color: var(--accent); }
  .choice-card .ic{ font-size: 26px; }
  .choice-card strong{ display: block; font-family: "Fraunces", Georgia, serif; font-size: 16px; font-weight: 500; }
  .choice-card span{ font-size: 12px; color: var(--muted); }

  .segmented{ display: flex; gap: 6px; }
  .segmented button{
    flex: 1; border: 1px solid var(--rule-strong); background: var(--paper-raised); color: var(--muted);
    border-radius: 10px; padding: 9px 6px; cursor: pointer; font-size: 12.5px;
  }
  .segmented button[aria-pressed="true"]{ border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }

  .field{ display: flex; flex-direction: column; gap: 6px; }
  .field label{ font-size: 11.5px; color: var(--muted); font-family: "IBM Plex Mono", monospace; }
  .field input[type="text"], .field input[type="date"], .field select{
    font-family: "Archivo", sans-serif; font-size: 14px; background: var(--paper-raised); color: var(--ink);
    border: 1px solid var(--rule-strong); border-radius: 8px; padding: 10px 12px;
  }
  .chip-row{ display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .chip{
    font-family: "IBM Plex Mono", monospace; font-size: 12px; border: 1px solid var(--rule-strong);
    background: var(--paper-raised); color: var(--ink); border-radius: 7px; padding: 6px 11px; cursor: pointer;
  }
  .chip[aria-pressed="true"]{ border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }

  .palette{ display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .palette button{ width: 22px; height: 22px; border-radius: 50%; border: 2px solid transparent; cursor: pointer; padding: 0; }
  .palette button[aria-pressed="true"]{ border-color: var(--ink); }
  .palette-more{
    width: 22px; height: 22px; border-radius: 50%; position: relative; overflow: hidden; cursor: pointer;
    background: conic-gradient(red, yellow, lime, cyan, blue, magenta, red); border: 2px solid transparent; flex: none;
  }
  .palette-more input[type="color"]{ position: absolute; inset: -6px; opacity: 0; cursor: pointer; border: none; padding: 0; }

  .btn{ border: none; border-radius: 10px; padding: 13px 16px; font-size: 14.5px; font-weight: 500; cursor: pointer; width: 100%; }
  .btn.primary{ background: var(--accent); color: var(--accent-ink); }
  .btn.ghost{ background: none; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
  .btn.danger-ghost{ background: none; color: var(--danger); text-decoration: underline; text-underline-offset: 3px; }

  .skin-grid{ display: grid; grid-template-columns: repeat(auto-fill, minmax(78px,1fr)); gap: 10px; }
  .skin-opt{
    display: flex; flex-direction: column; align-items: center; gap: 6px; background: none;
    border: 1px solid var(--rule-strong); border-radius: 10px; padding: 10px 6px; cursor: pointer; color: var(--ink); position: relative;
  }
  .skin-opt.active{ border-color: var(--accent); }
  .skin-opt.locked{ opacity: .55; cursor: not-allowed; }
  .skin-opt .preview{ width: 36px; height: 36px; border-radius: 50%; }
  .skin-opt .name{ font-size: 10.5px; }
  .skin-opt .lock{ position: absolute; top: 4px; right: 6px; font-family: "IBM Plex Mono", monospace; font-size: 8.5px; color: var(--danger); }

  .chest-open{ text-align: center; padding: 20px 0; }
  .chest-open .icon{ font-size: 64px; display: block; margin-bottom: 10px; }
  .chest-open .icon.pop{ animation: pop .5s ease; }
  @keyframes pop{ 0%{ transform: scale(.6); } 60%{ transform: scale(1.15); } 100%{ transform: scale(1); } }
  @media (prefers-reduced-motion: reduce){ .chest-open .icon.pop{ animation: none; } }
  .chest-open .amount{ font-family: "IBM Plex Mono", monospace; font-size: 22px; color: var(--gold); }

  .demo{ border-top: 1px dashed var(--rule-strong); padding-top: 10px; margin-top: 4px; font-family: "IBM Plex Mono", monospace; font-size: 11px; color: var(--muted); }
  .demo summary{ cursor: pointer; }
  .demo-row{ display: flex; align-items: center; justify-content: space-between; padding: 6px 0; }
  .demo button.mini{ font-family: inherit; font-size: 11px; background: var(--paper-raised); color: var(--ink); border: 1px solid var(--rule-strong); border-radius: 6px; padding: 4px 8px; cursor: pointer; }

  .toast{
    position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%); background: var(--ink); color: var(--paper);
    padding: 9px 16px; border-radius: 20px; font-size: 12.5px; z-index: 40; opacity: 0; transition: opacity .25s ease; pointer-events: none;
  }
  .toast.show{ opacity: 1; }
</style>

