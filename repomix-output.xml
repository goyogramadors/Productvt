    --paper-raised: #FAF9F3;
    --ink: #20241E;
    --muted: #6E7368;
    --accent: #3A6B54;
    --accent-ink: #F3F7F1;
    --accent-soft: #DCE6DC;
    --rule: #D5D1C1;
    --rule-strong: #B9B4A0;
    --hud-bg: #16213F; --hud-bg-2: #223462; --hud-ink: #F3F1E7;
